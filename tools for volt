def wall_surface_for_ball(loc, max_gap=650.0, team=None):
    """
    Return (axis, side, gap) for a ball close to a vertical arena wall.
    The ceiling and the goal interiors are deliberately not wall surfaces.
    """
    radius = 92.75
    # Side walls and the opponent's back wall are driveable. Our own
    # back wall is deliberately excluded so defensive positioning never
    # turns into a wall-drive attack.
    candidates = [
        ("x", 1 if loc.x >= 0 else -1, 4096.0 - abs(loc.x) - radius),
        ("y", 1 if loc.y >= 0 else -1, 5120.0 - abs(loc.y) - radius),
    ]
    candidates.sort(key=lambda item: item[2])

    for axis, wall_side, gap in candidates:
        if gap < -5 or gap > max_gap:
            continue
        if axis == "y":
            # The goal mouth is not a driveable wall surface.
            if abs(loc.x) < 900 and loc.z < 700:
                continue
            if team is not None and wall_side == side(team):
                continue
        return axis, wall_side, max(0.0, gap)
    return None


def car_wall_surface(car, team=None):
    """Return the vertical wall the car is attached to, or None."""
    if (
        abs(car.location.x) > 3720
        and abs(car.up.x) > 0.34
        and car.up.x * car.location.x < 0
    ):
        return "x", (1 if car.location.x >= 0 else -1)
    if (
        abs(car.location.y) > 4740
        and abs(car.up.y) > 0.34
        and car.up.y * car.location.y < 0
        and (team is None or (1 if car.location.y >= 0 else -1) != side(team))
    ):
        return "y", (1 if car.location.y >= 0 else -1)
    return None


def _wall_drive_eta(
    distance, car, direction, on_wall=False,
    initial_speed=None, facing_override=None, boost_fraction=1.0
):
    """
    Conservative travel-time estimate for one continuous surface segment.

    Ground motion is projected onto the floor; wall motion is projected onto
    the wall tangent. Turning consumes time and reduces usable entry speed.
    Boost is modelled as acceleration, not as a fixed speed bonus.
    """
    if distance <= 1:
        return 0.0

    travel_direction = (
        direction.normalize()
        if on_wall else direction.flatten().normalize()
    )
    forward = car.forward if on_wall else car.forward.flatten()
    velocity = car.velocity if on_wall else car.velocity.flatten()

    if facing_override is None:
        facing = (
            cap(forward.normalize().dot(travel_direction), -1, 1)
            if forward.magnitude() > 1 and travel_direction.magnitude() > 1
            else 0.0
        )
    else:
        facing = cap(facing_override, -1, 1)

    heading_error = math.acos(cap(facing, -1, 1))
    speed = velocity.magnitude()
    turn_rate = 2.0 if speed > 1400 else 3.0
    turn_time = heading_error / turn_rate

    if initial_speed is None:
        forward_speed = max(0.0, velocity.dot(travel_direction))
    else:
        forward_speed = max(0.0, initial_speed)

    # A tight/high-speed turn costs some of the speed already built.
    turn_speed_factor = max(0.45, math.cos(min(math.pi, heading_error) * 0.5))
    forward_speed = min(2300.0, forward_speed + speed * 0.15)
    forward_speed *= turn_speed_factor

    max_speed = 2300.0
    boost_acceleration = 991.0
    base_acceleration = 900.0
    boost_time = max(0.0, float(car.boost) * cap(boost_fraction, 0.0, 1.0)) / 33.3333333333
    boost_time = min(
        boost_time,
        max(0.0, (max_speed - forward_speed) / boost_acceleration)
    )

    boosted_distance = (
        forward_speed * boost_time
        + 0.5 * boost_acceleration * boost_time * boost_time
    )
    if boosted_distance >= distance and boost_time > 0:
        discriminant = max(
            0.0,
            forward_speed * forward_speed
            + 2.0 * boost_acceleration * distance
        )
        actual_boost_time = (
            math.sqrt(discriminant) - forward_speed
        ) / boost_acceleration
        return turn_time + max(0.0, actual_boost_time) + 0.12

    remaining = max(0.0, distance - boosted_distance)
    speed_after_boost = min(
        max_speed, forward_speed + boost_acceleration * boost_time
    )
    time_to_cap = max(
        0.0, (max_speed - speed_after_boost) / base_acceleration
    )
    distance_to_cap = (
        speed_after_boost * time_to_cap
        + 0.5 * base_acceleration * time_to_cap * time_to_cap
    )
    if remaining <= distance_to_cap:
        discriminant = max(
            0.0,
            speed_after_boost * speed_after_boost
            + 2.0 * base_acceleration * remaining
        )
        drive_time = (
            math.sqrt(discriminant) - speed_after_boost
        ) / base_acceleration
    else:
        drive_time = (
            time_to_cap
            + (remaining - distance_to_cap) / max_speed
        )

    return turn_time + boost_time + drive_time + 0.12


def _noob_wall_jump_time(height, double_jump=0):
    """Noob Black's wall-specific jump-time model."""
    height = max(0.0, float(height))
    single_time = (height + 7.0) / 538.9887109375
    if single_time >= 24 / 120:
        if single_time >= 25 / 120 and double_jump:
            if double_jump == 1:
                return (height + 407.0 / 6.0) / 830.9887109375, 3
            return (height + 667.0 / 6.0) / 1038.9887109375, 2
        return single_time, 1

    # This is Noob Black's low-height branch, including the short
    # initial-jump impulse rather than extrapolating the linear branch.
    a, b, c = 717.3359375, 272.7626953125, 17.671875
    root = (height - c) / a + b * b / (4 * a * a)
    if root < 0:
        return 0.0, 1
    return -b / (2 * a) + math.sqrt(root), 1


def _noob_wall_travel_profile(car):
    """120 Hz ground travel profile from Noob Black's get_acceleration()."""
    speed = car.velocity.flatten().magnitude()
    boost = max(0.0, float(car.boost))
    distances = [0.0]
    velocities = [speed]
    for tick in range(600):
        velocity = velocities[-1]
        boost_used = tick / 3.6 < boost
        boost_accel = 2975.0 / 3.0 if boost_used else 0.0
        if velocity <= 1400:
            next_velocity = velocity + (
                1600.0 - 1440.0 / 1400.0 * velocity + boost_accel
            ) / 120.0
        elif velocity < 1410:
            next_velocity = velocity + (
                22560.0 - 16.0 * velocity + boost_accel
            ) / 120.0
        else:
            next_velocity = min(
                velocity + 2975.0 / 360.0 * bool(boost_used), 2300.0
            )
        velocities.append(min(2300.0, next_velocity))
        distances.append(distances[-1] + velocities[-1] / 120.0)
    return distances, velocities


def _noob_wall_get_dist(pos):
    return min(4096.0 - abs(pos.x), 5120.0 - abs(pos.y))


def _noob_wall_ball_from_ground(origin, pos):
    dx = 4096.0 - abs(pos.x)
    dy = 5120.0 - abs(pos.y)
    if dx < dy:
        return Vector((1 if pos.x >= 0 else -1) * (4096.0 + pos.z), pos.y, 0)
    return Vector(pos.x, (1 if pos.y >= 0 else -1) * (5120.0 + pos.z), 0)


def _noob_wall_ball_x_to_y(origin, pos):
    dx = 4096.0 - abs(pos.x)
    dy = 5120.0 - abs(pos.y)
    if dx < dy:
        return Vector((1 if pos.x >= 0 else -1) * 4096.0, pos.y, pos.z)
    origin_x = 1 if origin.x >= 0 else -1
    return Vector(
        origin_x * 4096.0,
        (1 if pos.y >= 0 else -1) * (
            5120.0 + abs(pos.x - origin_x * 4096.0)
        ),
        pos.z
    )


def _noob_wall_ball_y_to_x(origin, pos):
    dx = 4096.0 - abs(pos.x)
    dy = 5120.0 - abs(pos.y)
    if dx < dy:
        origin_y = 1 if origin.y >= 0 else -1
        return Vector(
            (1 if pos.x >= 0 else -1) * (
                4096.0 + abs(pos.y - origin_y * 5120.0)
            ),
            origin_y * 5120.0,
            pos.z
        )
    return Vector(pos.x, (1 if pos.y >= 0 else -1) * 5120.0, pos.z)


def _noob_wall_car_xwall(pos):
    return Vector((1 if pos.x >= 0 else -1) * 4096.0, pos.y, pos.z)


def _noob_wall_car_ywall(pos):
    return Vector(pos.x, (1 if pos.y >= 0 else -1) * 5120.0, pos.z)


def find_wall_drive(agent, cap_=5.0):
    """
    Noob Black wall-shot reachability port.

    It tests the predicted 60 Hz ball slices against Noob's wall-specific
    floor/wall coordinate transforms and 120 Hz acceleration profile. The
    existing Volt wall_approach routine remains the controller/stack adapter.
    """
    car = agent.me
    prediction = getattr(agent, "ball_prediction_struct", None)
    slices = getattr(prediction, "slices", None) if prediction is not None else None
    debug_due = (
        agent.time - getattr(agent, "_last_noob_wall_debug", -999.0) >= 0.5
    )
    if debug_due:
        agent._last_noob_wall_debug = agent.time
        attached = car_wall_surface(car, agent.team)
        print(
            f"[NOOB WALL SCAN] airborne={car.airborne} wall={attached} "
            f"car=({car.location.x:.0f},{car.location.y:.0f},"
            f"{car.location.z:.0f}) speed={car.velocity.magnitude():.0f} "
            f"boost={car.boost:.0f}",
            flush=True
        )

    if car.airborne and car_wall_surface(car, agent.team) is None:
        return None
    if not slices:
        if debug_due:
            print("[NOOB WALL FIND] no prediction", flush=True)
        return None

    max_t = min(5.0, max(0.5, float(cap_)))
    max_index = min(300, int(max_t * 60))
    if len(slices) < 2:
        return None

    travel_d, travel_v = _noob_wall_travel_profile(car)
    car_location = car.location
    car_velocity = car.velocity
    if car.location.z <= 50:
        used_ball_transform = _noob_wall_ball_from_ground
        used_car_transform = lambda pos: pos.flatten()
        transform_name = "ground"
    elif 4096.0 - abs(car.location.x) < 5120.0 - abs(car.location.y):
        used_ball_transform = _noob_wall_ball_x_to_y
        used_car_transform = _noob_wall_car_xwall
        transform_name = "x-wall"
    else:
        used_ball_transform = _noob_wall_ball_y_to_x
        used_car_transform = _noob_wall_car_ywall
        transform_name = "y-wall"

    car_surface = used_car_transform(car_location)
    goal = agent.foe_goal.location
    goal_y = goal.y
    target_t = [max_t, max_t, max_t, max_t]
    target_f = [None, None, None, None]
    wait_for_fall = [-1.0, -1.0, -1.0, 0.0]
    air_t = 0.0
    up_direction = car.up
    jumped = bool(getattr(car, "jumped", False))
    double_jumped = bool(getattr(car, "doublejumped", False))
    jump_vec = (
        292.0 * (not double_jumped)
        + 146.0 * (not jumped)
    )

    def target_point(ball_pos):
        deviation = abs(ball_pos.y - goal_y)
        height = deviation * math.tan(
            min(deviation / 5120.0, 1.0) * math.pi / 4.0
        )
        return Vector(goal.x, goal_y, height)

    def reachable_ground(ball_pos, time_value, contact_offset, double):
        shot_target = target_point(ball_pos)
        offset = (shot_target - ball_pos).normalize()
        if offset.magnitude() < 0.001:
            return False, 0.0
        approach = ball_pos - offset * contact_offset
        jump_time, _ = _noob_wall_jump_time(
            _noob_wall_get_dist(approach), double
        )
        approach.z += 325.0 * jump_time * jump_time
        transformed_target = used_ball_transform(car_location, approach)
        required_distance = transformed_target.dist(car_surface)
        ticks_charging = max(0, min(600, round(time_value * 120)))
        ticks_driving = max(
            0, min(600, round(min(max(time_value - jump_time, 0.0), 5.0) * 120))
        )
        available_distance = (
            travel_d[ticks_driving]
            + travel_v[ticks_driving]
            * (ticks_charging - ticks_driving) / 120.0
        )
        return available_distance >= required_distance, jump_time

    def reachable_aerial(ball_pos, time_value, elapsed_air):
        shot_target = target_point(ball_pos)
        offset = (shot_target - ball_pos).normalize()
        if offset.magnitude() < 0.001:
            return False
        contact = ball_pos - offset * 92.75
        predicted_car = (
            car_location
            + car_velocity * time_value
            + Vector(z=-325.0) * elapsed_air
            + up_direction * jump_vec
        )
        required_distance = contact.dist(predicted_car)
        return required_distance <= (2975.0 / 6.0) * elapsed_air

    for i in range(max_index + 1):
        time_value = i / 60.0
        slice_index = min(i * 2, len(slices) - 1)
        ball_slice = slices[slice_index]
        if abs(ball_slice.physics.location.y) > 5250:
            break
        raw = ball_slice.physics.location
        ball_pos = Vector(raw.x, raw.y, raw.z)

        # Only wall families accepted by Volt's existing policy: side walls
        # and the opponent back wall, never the own back wall or goal mouth.
        surface = wall_surface_for_ball(raw, 1800.0, agent.team)
        if surface is None or not 0.0 <= ball_pos.z <= 2200.0:
            if target_t[0] == max_t or target_t[1] == max_t:
                air_t += (2 * i + 1) / 3600.0
            continue

        axis, wall_side, gap = surface
        wall_velocity = (
            ball_slice.physics.velocity.x
            if axis == "x" else ball_slice.physics.velocity.y
        ) * wall_side
        wall_jump_time, _ = _noob_wall_jump_time(
            min(4096.0 - abs(ball_pos.x), 5120.0 - abs(ball_pos.y)), 0
        )
        stable_wall_ball = (
            wall_jump_time <= 1.45
            and abs(wall_velocity) < 150.0
            and 400.0 <= ball_pos.z <= 1900.0
        )
        rolling_up_wall_ball = (
            ball_pos.z + ball_slice.physics.velocity.z ** 2 / 1300.0
            <= 129.0
            and wall_velocity >= 720.0
        )
        if not (stable_wall_ball or rolling_up_wall_ball):
            air_t += (2 * i + 1) / 3600.0
            continue

        if target_t[0] == max_t:
            can_hit, jump_time = reachable_ground(
                ball_pos, time_value, 134.85, 0
            )
            if can_hit:
                if jump_time > 1.45:
                    if wait_for_fall[0] < 0:
                        wait_for_fall[0] = time_value
                else:
                    target_t[0] = time_value
                    target_f[0] = ball_slice

        if target_t[1] == max_t:
            can_hit, jump_time = reachable_ground(
                ball_pos, time_value, 92.75, 1
            )
            if can_hit:
                if jump_time > 1.45:
                    if wait_for_fall[1] < 0:
                        wait_for_fall[1] = time_value
                else:
                    target_t[1] = time_value
                    target_f[1] = ball_slice

        if target_t[3] == max_t:
            if reachable_aerial(ball_pos, time_value, air_t):
                target_t[3] = time_value
                target_f[3] = ball_slice
            else:
                air_t += (2 * i + 1) / 3600.0

    # Match Noob Black's wall_shot convention: a valid single-jump wall
    # route sets this flag so its aerial option can be budgeted as well.
    wait_for_fall[0] = 1.0
    jump_index = 0 if target_t[0] < max_t else 1
    if target_t[jump_index] >= max_t or target_f[jump_index] is None:
        if debug_due:
            print(
                f"[NOOB WALL FIND] no reachable wall contact "
                f"mode={transform_name} single={target_t[0]:.2f} "
                f"double={target_t[1]:.2f} aerial={target_t[3]:.2f}",
                flush=True
            )
        return None

    aerial_available = (
        target_f[3] is not None
        and target_t[3] < max_t
        and wait_for_fall[jump_index] >= 0
        and car.boost / 100.0 * 3.0 >= (
            target_t[3] + 0.1 * (not car.airborne)
        )
    )
    if aerial_available:
        selected_index = 3
        selected_time = target_t[3]
        selected_ball = target_f[3]
        selected_mode = "aerial"
    else:
        selected_index = jump_index
        selected_time = target_t[selected_index]
        selected_ball = target_f[selected_index]
        selected_mode = "double" if selected_index == 1 else "single"

    raw = selected_ball.physics.location
    selected_pos = Vector(raw.x, raw.y, raw.z)
    print(
        f"[NOOB WALL FIND] reachable mode={selected_mode} "
        f"surface={transform_name} T={selected_time:.2f} "
        f"ball=({selected_pos.x:.0f},{selected_pos.y:.0f},"
        f"{selected_pos.z:.0f}) boost={car.boost:.0f}",
        flush=True
    )
    return wall_approach(
        agent.time + selected_time,
        agent.foe_goal_shot,
        selected_mode=selected_mode,
        ball_location=selected_pos
    )

