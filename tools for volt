def find_wall_drive(agent, cap_=4.0):
    """Find a reachable side-wall touch without treating wall driving as aerial."""
    car = agent.me
    debug_now = agent.time
    debug_due = (
        debug_now - getattr(agent, "_last_wall_drive_scan_debug", -999.0)
        >= 0.5
    )
    if debug_due:
        agent._last_wall_drive_scan_debug = debug_now
    on_side_wall = (
        abs(car.location.x) > 3500
        and abs(car.up.x) > 0.65
        and car.up.x * car.location.x < 0
    )
    car_wall_side = (1 if car.location.x >= 0 else -1) if on_side_wall else 0

    # airborne is also true for a car attached to a vertical wall.
    # Reject free-flight cars. A car attached to the opposite side wall
    # cannot transfer across the arena in this wall-touch routine.
    if debug_due:
        print(
            f"[WALL DRIVE SCAN] airborne={car.airborne} wall={on_side_wall} "
            f"car_side={car_wall_side} car=({car.location.x:.0f},"
            f"{car.location.y:.0f},{car.location.z:.0f})",
            flush=True
        )

    if car.airborne and not on_side_wall:
        if debug_due:
            print("[WALL DRIVE FIND] rejected: airborne away from side wall", flush=True)
        return None

    prediction = getattr(agent, "ball_prediction_struct", None)
    slices = getattr(prediction, "slices", None) if prediction is not None else None
    if not slices:
        if debug_due:
            print("[WALL DRIVE FIND] rejected: no ball prediction slices", flush=True)
        return None

    reject_wall_window = 0
    reject_height = 0
    reject_opposite_wall = 0
    reject_unreachable = 0

    # Use the prediction rather than the current ball position: the ball
    # may still be on the floor while its predicted path is already climbing
    # one of the two long side walls.
    speed = math.hypot(car.velocity.x, car.velocity.y)
    effective_speed = max(1200.0, min(2200.0, speed + 800.0))
    best = None
    max_index = min(len(slices), int(cap_ * 120))

    for index in range(12, max_index):
        ball_slice = slices[index]
        physics = ball_slice.physics
        loc = physics.location
        vel = physics.velocity

        # A wall drive is a way to reach and clear a ball off the side wall.
        # The ball does NOT have to be rising: it may be rolling upward,
        # slowing, or already falling down the wall. The car may start on
        # the ground and drive up to it.
        if abs(loc.x) < 3250 or not 180 <= loc.z <= 2200:
            reject_wall_window += 1
            continue
        if loc.z < car.location.z + 60:
            reject_height += 1
            continue

        intercept_in = ball_slice.game_seconds - agent.time
        if intercept_in <= 0:
            continue

        wall_side = 1 if loc.x >= 0 else -1

        # Never mistake attachment to the opposite side wall for a valid
        # launch point. The previous distance estimate could accept this
        # because it used a generous speed cap and did not model wall transfer.
        if on_side_wall and car_wall_side != wall_side:
            reject_opposite_wall += 1
            continue

        target = Vector(wall_side * 3850, loc.y, max(100.0, loc.z))
        delta = target - car.location
        if on_side_wall:
            distance = delta.magnitude()
        else:
            # A ground car must first reach the wall, then travel along it
            # and climb. Euclidean distance underestimates that route.
            distance = (
                abs(target.x - car.location.x)
                + abs(target.y - car.location.y)
                + max(0.0, target.z - car.location.z)
            )

        facing = 0.0
        flat_delta = delta.flatten()
        flat_forward = car.forward.flatten()
        if flat_delta.magnitude() > 1 and flat_forward.magnitude() > 1:
            facing = max(
                -1.0,
                min(1.0, flat_forward.normalize().dot(flat_delta.normalize()))
            )

        eta = (
            distance / effective_speed
            + max(0.0, 1.0 - facing) * 0.30
            + 0.12
        )
        if eta > intercept_in - 0.08:
            reject_unreachable += 1
            continue

        # Prefer the earliest reachable wall contact; use ETA only as a small tie-breaker.
        score = intercept_in + eta * 0.04
        if best is None or score < best[0]:
            best = (score, intercept_in, loc.x, loc.y, loc.z, vel.z)

    if best is None:
        if debug_due:
            print(
                f"[WALL DRIVE FIND] no candidate | "
                f"wall_window={reject_wall_window} "
                f"not_above={reject_height} "
                f"opposite_wall={reject_opposite_wall} "
                f"unreachable={reject_unreachable} "
                f"slices={len(slices)}",
                flush=True
            )
        return None

    _, intercept_in, x, y, z, vz = best
    ball_wall_side = 1 if x >= 0 else -1
    print(
        f"[WALL DRIVE FIND] airborne={car.airborne} wall={on_side_wall} "
        f"car_wall_side={car_wall_side} ball_wall_side={ball_wall_side} "
        f"car=({car.location.x:.0f},{car.location.y:.0f},{car.location.z:.0f}) "
        f"intercept={intercept_in:.2f}s ball=({x:.0f},{y:.0f},{z:.0f}) vz={vz:.0f} car_z={car.location.z:.0f}",
        flush=True
    )
    return wall_approach(agent.time + intercept_in, agent.foe_goal_shot)


