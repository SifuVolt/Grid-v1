def find_air_dribble_setup(agent):
    """Own setup eligibility and preserve an active setup's control priority."""
    if any(
        isinstance(routine, air_dribble_setup)
        for routine in getattr(agent, "stack", [])
    ):
        return True

    stack = getattr(agent, "stack", [])
    active_name = (
        stack[0].__class__.__name__
        if stack
        else None
    )

    # Grid's passive defensive positioning must not suppress a valid,
    # specialised wall setup. The new routine is pushed above grid_defense
    # and takes control; unrelated active routines remain protected.
    can_override_defense = (
        active_name is not None
        and active_name.lower() in {"grid_defense", "defense", "defence"}
        and all(
            routine.__class__.__name__.lower()
            in {"grid_defense", "defense", "defence"}
            for routine in stack
        )
    )

    if not agent.is_clear() and not can_override_defense:
        last = getattr(agent, "_air_dribble_stack_debug", -999)
        if agent.time - last >= 1.0:
            agent._air_dribble_stack_debug = agent.time
            active = active_name or "unknown"
            print(
                f"[AIR DRIBBLE CHECK] blocked by active routine: {active}",
                flush=True
            )
        return None

    if can_override_defense:
        print(
            "[AIR DRIBBLE TOOL] evaluating setup; may override grid_defense",
            flush=True
        )

    car = agent.me
    ball = agent.ball.location

    def reject(reason):
        last = getattr(agent, "_air_dribble_check_debug", -999)
        if agent.time - last >= 0.75:
            agent._air_dribble_check_debug = agent.time
            print(
                f"[AIR DRIBBLE CHECK] rejected: {reason} | "
                f"car=({car.location.x:.0f},{car.location.y:.0f},{car.location.z:.0f}) "
                f"ball=({ball.x:.0f},{ball.y:.0f},{ball.z:.0f})",
                flush=True
            )
        return None

    if car.airborne:
        return reject("car airborne")
    if ball.z > 125:
        return reject(f"ball too high z={ball.z:.0f}")
    if abs(agent.ball.velocity.z) > 220:
        return reject(f"ball vertical speed={agent.ball.velocity.z:.0f}")
    if agent.time < getattr(agent, "air_dribble_cooldown_until", -999):
        return reject("cooldown")

    # The car wrapper's forward vector can be zero in some packets.
    # local_location uses the car transform and is the reliable geometry test.
    wall_delta_x = ball.x - car.location.x
    if abs(wall_delta_x) < 180:
        return reject("ball is not meaningfully toward either side wall")
    wall_side = 1 if wall_delta_x > 0 else -1

    local_ball = car.local_location(ball)
    if local_ball is None:
        return reject("local ball transform unavailable")
    if not 250 < local_ball.x < 1650:
        return reject(f"ball not in forward range local_x={local_ball.x:.0f}")
    if abs(local_ball.y) > 900:
        return reject(f"ball too far laterally local_y={local_ball.y:.0f}")
    if abs(ball.x) > 3500 or abs(car.location.x) > 3300:
        return reject("too close to side wall already")

    # Opponents only need to be far away; their position behind/ahead of
    # Volt is deliberately irrelevant.
    if agent.foes:
        nearest_opponent_distance = min(
            min(
                foe.location.flat_dist(car.location),
                foe.location.flat_dist(ball)
            )
            for foe in agent.foes
        )
        if nearest_opponent_distance <= 1800:
            return reject(
                f"opponent too close distance={nearest_opponent_distance:.0f}"
            )

    last = getattr(agent, "_air_dribble_check_debug", -999)
    if agent.time - last >= 0.75:
        agent._air_dribble_check_debug = agent.time
        print("[AIR DRIBBLE CHECK] all geometry conditions passed", flush=True)

    print(
        "[AIR DRIBBLE TOOL] setup accepted; prioritising wall setup",
        flush=True
    )
    return air_dribble_setup(wall_side=wall_side)


