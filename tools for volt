def useful_non_aerial_shot(agent, ball_location, ball_velocity, shot, intercept_time):
    # Aerials are handled separately.
    if shot['shot_type'] == 3:
        return True

    ball_pos = Vector(*ball_location)
    ball_vel = Vector(
        ball_velocity.x,
        ball_velocity.y,
        ball_velocity.z
    )

    time_remaining = intercept_time - agent.time

    if time_remaining <= 0:
        return False

    # How far is the ball expected to travel before contact?
    ball_travel = ball_vel.flatten().magnitude() * time_remaining

    # Find the closest opponent.
    if len(agent.foes) == 0:
        return True

    # For ten seconds after kickoff, take the contest rather than rejecting
    # a reachable touch because an opponent appears to have an ETA advantage.
    if agent.in_post_kickoff_contest_window():
        return True

    # The elected attacker owns the first challenge in team games. Do not
    # discard their reachable shot because an opponent is closer; 1v1 keeps
    # the opponent ETA filter since there is no team role to assign.
    if (
        agent.friends
        and getattr(agent, "get_grid_active_challenger", lambda: None)()
        == agent.me.index
    ):
        return True

    closest_foe = min(
        agent.foes,
        key=lambda foe: foe.location.flat_dist(ball_pos)
    )

    enemy_distance = closest_foe.location.flat_dist(ball_pos)

    # Approximate opponent reachability with heading correction, ground
    # acceleration, boost reserve, and a speed cap. This remains a filter,
    # not a full opponent physics simulation.
    foe_velocity = closest_foe.velocity.flatten()
    foe_speed = foe_velocity.magnitude()
    foe_to_ball = (ball_pos - closest_foe.location).flatten()
    approach_direction = foe_to_ball.normalize()

    if approach_direction.magnitude() < 0.001:
        enemy_time = 0.0
    else:
        forward = closest_foe.forward.flatten()
        if forward.magnitude() < 0.001:
            heading_error = math.pi
        else:
            heading_error = math.acos(cap(
                forward.normalize().dot(approach_direction), -1, 1
            ))

        # Turns are slower at high speed; this deliberately errs slightly
        # on the side of giving the opponent a realistic chance.
        turn_rate = 2.0 if foe_speed > 1400 else 3.5
        turn_time = heading_error / turn_rate

        forward_speed = max(0.0, foe_velocity.dot(approach_direction))
        boost = max(0.0, float(getattr(closest_foe, "boost", 0)))
        max_speed = 2300.0
        remaining_distance = max(0.0, enemy_distance - forward_speed * turn_time)

        # Spend boost only for the time its reserve can actually sustain.
        boost_acceleration = 1600.0
        base_acceleration = 900.0
        boost_time = boost / 33.3333333333
        time_to_cap_boost = max(0.0, (max_speed - forward_speed) / boost_acceleration)
        boosted_time = min(boost_time, time_to_cap_boost)
        boosted_distance = (
            forward_speed * boosted_time
            + 0.5 * boost_acceleration * boosted_time ** 2
        )
        speed_after_boost = min(
            max_speed,
            forward_speed + boost_acceleration * boosted_time
        )
        remaining_distance = max(0.0, remaining_distance - boosted_distance)

        time_to_cap_base = max(
            0.0,
            (max_speed - speed_after_boost) / base_acceleration
        )
        base_accel_distance = (
            speed_after_boost * time_to_cap_base
            + 0.5 * base_acceleration * time_to_cap_base ** 2
        )
        if remaining_distance <= base_accel_distance:
            discriminant = max(
                0.0,
                speed_after_boost ** 2
                + 2 * base_acceleration * remaining_distance
            )
            base_drive_time = (
                math.sqrt(discriminant) - speed_after_boost
            ) / base_acceleration
        else:
            base_drive_time = (
                time_to_cap_base
                + (remaining_distance - base_accel_distance) / max_speed
            )
        drive_time = boosted_time + base_drive_time

        # A grounded opponent can use a jump for a modestly elevated touch.
        # It helps reach height, but the jump startup prevents a free bonus.
        jump_adjustment = -0.08 if (
            not getattr(closest_foe, "airborne", False)
            and 180 < ball_pos.z < 650
        ) else 0.0
        enemy_time = max(0.0, turn_time + drive_time + jump_adjustment)

    # Jump shots need a larger safety margin because they commit Volt
    # to the jump-and-dodge sequence. Keep the existing margin for every
    # other non-aerial shot type.
    enemy_safety_margin = 0.5 if shot.get('shot_type') == 1 else 0.35
    if enemy_time + enemy_safety_margin < time_remaining:
        agent._opponent_rejected_shot = True
        return False

    return True


def select_ball_contact(agent, ball_location, targets):
    """
    Select which side of the ball Volt should approach.

    Returns the surface contact point, car approach target,
    selected normal, and a readable label.
    """

    if targets is not None:
        target_left = Vector(*targets[0])
        target_right = Vector(*targets[1])

        target_center = (target_left + target_right) * 0.5
    else:
        target_center = agent.foe_goal.location

    shot_dir = (target_center - ball_location).flatten().normalize()
    if shot_dir.magnitude() < 0.001:
        shot_dir = Vector(0, side(agent.team), 0)

    lateral = Vector(-shot_dir.y, shot_dir.x, 0).normalize()
    car_from_ball = (agent.me.location - ball_location).normalize()

    candidates = [
        ("centre", -shot_dir),
        ("left", (-shot_dir + lateral * 0.55).normalize()),
        ("right", (-shot_dir - lateral * 0.55).normalize()),
        ("high", (-shot_dir + Vector(0, 0, 0.30)).normalize()),
        ("low", (-shot_dir - Vector(0, 0, 0.30)).normalize()),
    ]

    best = None
    best_score = -999

    for label, normal in candidates:
        approach_alignment = car_from_ball.dot(normal)

        # How much this contact direction deviates from the
        # direction needed to send the ball toward the target.
        shot_alignment = (-normal).dot(shot_dir)

        # Strongly favour contacts Volt can actually approach.
        score = (
            approach_alignment * 0.75
            + shot_alignment * 0.25
        )

        if score > best_score:
            best_score = score
            best = (label, normal)

    label, normal = best

    ball_radius = 92.75
    approach_distance = max(120, agent.best_shot_value)

    return {
        "label": label,
        "normal": normal,
        "contact_point": ball_location + normal * ball_radius,
        "approach_target": ball_location + normal * approach_distance,
        "score": best_score,
    }
def target_aim_point(ball_location, ball_velocity, target, gravity=-650):
    """
    Aim toward the centre of the target pair.
    The pair defines a horizontal target window, NOT goal corners.
    """

    left, right = target

    if not isinstance(left, Vector):
        left = Vector(*left)

    if not isinstance(right, Vector):
        right = Vector(*right)

    center = (left + right) * 0.5

    # Target width is defined by the two supplied points.
    half_width = (right - left).flatten().magnitude() * 0.5

    # Keep the ball inside the target window.
    margin = 100.0
    usable_width = max(0.0, half_width - margin)

    # Predict where the ball will reach the target's Y plane.
    dy = center.y - ball_location.y

    if abs(ball_velocity.y) > 100:
        t = dy / ball_velocity.y
    else:
        t = -1

    if 0.05 < t < 3.0:
        predicted_x = ball_location.x + ball_velocity.x * t
        predicted_z = (
            ball_location.z
            + ball_velocity.z * t
            + 0.5 * gravity * t * t
        )

        # Clamp X to the actual target window.
        aim_x = cap(
            predicted_x,
            center.x - usable_width,
            center.x + usable_width
        )

        # Don't aim below the floor or above the crossbar.
        aim_z = cap(predicted_z, 120, 550)
    else:
        aim_x = center.x
        aim_z = 300

    return Vector(aim_x, center.y, aim_z)

def unrealistic_goal_shot(agent, ball_location, target):
    """
    Reject shots where the ball is already too deep behind
    the opponent's goal plane to make a realistic scoring attempt.
    """

    left, right = target

    if not isinstance(left, Vector):
        left = Vector(*left)

    if not isinstance(right, Vector):
        right = Vector(*right)

    center = (left + right) * 0.5
    toward_opponent = -side(agent.team)

    past_goal_line = (
        ball_location.y - center.y
    ) * toward_opponent

    half_width = (
        (right - left).flatten().magnitude() * 0.5
    )

    # The ball is beyond the target plane.
    if past_goal_line > 250:
        return True

    # Reject a ball well outside the target window near the plane.
    if past_goal_line > -300:
        if abs(ball_location.x - center.x) > half_width + 450:
            return True

    return False
def _in_own_net(agent):
    """True only when the car is inside the own goal opening, behind the goal line."""
    car_location = agent.me.location
    own_depth = car_location.y * side(agent.team)
    return own_depth >= 5120 and abs(car_location.x) <= 900


def _enemy_backwall_rebound(agent, ball_location, ball_velocity):
    """
    True when a predicted airborne ball is rebounding into the field from
    the opponent's back wall. Only applies while Volt's car is grounded.
    """
    if agent.me.airborne:
        return False

    team_side = 1 if agent.team == 0 else -1
    enemy_goal_y = -5120 * team_side

    return (
        140 < ball_location[2] < 1200
        and abs(ball_location[1] - enemy_goal_y) <= 1400
        and ball_velocity.y * team_side > 150
    )


def shot_candidate_score(agent, ball_slice, shot, time_remaining, target=None):
    """Lower is better: favour useful shots and stronger likely contacts."""
    ball = ball_slice.physics.location
    car = agent.me.location

    car_velocity = agent.me.velocity.flatten()
    ball_velocity = Vector(
        ball_slice.physics.velocity.x,
        ball_slice.physics.velocity.y,
        ball_slice.physics.velocity.z
    )

    # Time still matters, but it must not drown out a clearly better angle/contact.
    # Full-horizon search below lets a clean setup 1-3 seconds out beat a poor touch now.
    score = time_remaining * 0.22
    shot_type = shot["shot_type"]

    # Prefer simpler shots when their likely outcome is comparable.
    if shot_type == 0:       # Ground shot
        score += 0.00
    elif shot_type == 1:     # Jump shot
        score += 0.12
    elif shot_type == 2:     # Double jump
        score += 0.25
    elif shot_type == 3:     # Aerial
        score += 0.35

    # Grid's double-jump candidate is evaluated separately from the C parser.
    # Give it the same preference during an opponent-back-wall rebound.
    if (
        shot_type == 2
        and _enemy_backwall_rebound(
            agent,
            (ball.x, ball.y, ball.z),
            ball_slice.physics.velocity
        )
    ):
        score -= 0.15
        if agent.time - getattr(
            agent, "_last_backwall_double_jump_debug", -999.0
        ) >= 0.75:
            agent._last_backwall_double_jump_debug = agent.time
            print(
                f"[BACKWALL DOUBLE JUMP PREFERENCE] "
                f"ball=({ball.x:.0f},{ball.y:.0f},{ball.z:.0f})",
                flush=True
            )

    # During the ten-second post-kickoff contest window, reduce the usual
    # complexity penalty for aerials so a reachable aerial can beat a
    # similarly good ground/jump option. Outside this window normal scoring
    # is unchanged.
    if (
        shot_type == 3
        and agent.time < getattr(agent, "kickoff_contest_until", -999.0)
    ):
        score -= 0.40

    team_side = 1 if agent.team == 0 else -1

    if target is not None:
        if unrealistic_goal_shot(agent, ball, target):
            return float("inf")

        aim_point = target_aim_point(
            ball,
            ball_velocity,
            target
        )

        goal_direction = Vector(
            aim_point.x - ball.x,
            aim_point.y - ball.y,
            0
        ).normalize()

        goal = (
            target[0] + target[1]
        ) * 0.5

        # Penalise deep-half shots only when targeting the opponent's side.
        ball_depth = ball.y * team_side
        target_is_opponent_side = (
            (goal.y - ball.y) * team_side < 0
        )

        if ball_depth > 1500 and target_is_opponent_side:
            score += min((ball_depth - 1500) / 2500, 1.0) * 0.20

        # A goal target should not reward a contact that is already behind the
        # opponent goal line: those often become shots into the back wall.
        # Keep this as a penalty (not a hard rejection) so rebounds remain possible.
    else:
        # Untargeted shots should generally clear the ball upfield.
        goal_direction = Vector(0, -team_side, 0)

    # Direction from the car to the predicted ball position.
    approach = Vector(
        ball.x - car.x,
        ball.y - car.y,
        0
    )

    if approach.magnitude() > 1 and goal_direction.magnitude() > 1:
        approach = approach.normalize()
        goal_direction = goal_direction.normalize()

        alignment = cap(approach.dot(goal_direction), -1, 1)

        # Prefer approaching from behind the ball, in the desired direction.
        angle_penalty = (1 - alignment) * 0.45
        time_factor = cap(
            1.5 / max(time_remaining, 0.1),
            0.7,
            1.8
        )
        score += angle_penalty * time_factor

        # Estimate how quickly the car is closing on the ball.
        # A small closing speed often means the car will push the ball
        # instead of hitting it with much pace.
        closing_speed = (
            car_velocity.dot(approach)
            - ball_velocity.dot(approach)
        )

        weak_contact_penalty = (
            cap((850 - closing_speed) / 850, 0, 1) * 0.55
        )

        # Current speed matters less when there is more time to accelerate.
        power_time_factor = cap(
            1.2 / max(time_remaining, 0.1),
            0.4,
            1.0
        )

        score += weak_contact_penalty * power_time_factor

        # Teammate-aware shot choice: don't automatically concede to the
        # closest car. Penalise our candidate only when a teammate appears to
        # have both a comparable arrival and a clearly better attack angle.
        # Keep urgent own-goal saves exempt from this soft competition check.
        own_goal = agent.friend_goal.location
        ball_to_own_goal = Vector(
            own_goal.x - ball.x, own_goal.y - ball.y, 0
        )
        ball_heading_to_own_goal = (
            ball_velocity.dot(ball_to_own_goal.normalize())
            if ball_to_own_goal.magnitude() > 1 else 0
        )
        urgent_save = (
            ball_to_own_goal.magnitude() < 3000
            and ball_heading_to_own_goal > 250
        )

        if agent.friends and not urgent_save:
            our_arrival = time_remaining
            our_alignment = alignment
            best_friend_edge = 0.0
            for friend in agent.friends:
                friend_to_ball = Vector(
                    ball.x - friend.location.x,
                    ball.y - friend.location.y,
                    0
                )
                friend_distance = friend_to_ball.magnitude()
                friend_speed = friend.velocity.flatten().magnitude()
                friend_arrival = friend_distance / max(1200, friend_speed + 350)
                if friend_to_ball.magnitude() <= 1:
                    continue
                friend_approach = friend_to_ball.normalize()
                friend_alignment = cap(
                    friend_approach.dot(goal_direction), -1, 1
                )
                arrival_edge = our_arrival - friend_arrival
                angle_edge = friend_alignment - our_alignment
                if arrival_edge >= -0.15 and angle_edge > 0.18:
                    edge = min(0.65, max(0.0, arrival_edge + 0.2) * 0.35
                               + angle_edge * 0.75)
                    best_friend_edge = max(best_friend_edge, edge)
            score += best_friend_edge

    # Low boost reduces the appeal of boost-dependent aerials. With no
    # boost at all, strongly prefer a double-jump touch over a single jump:
    # the double jump supplies a second vertical impulse without boost.
    if agent.me.boost < 12:
        if shot_type == 1:
            score += 0.18
        elif shot_type == 2:
            score += 0.08
        elif shot_type == 3:
            score += 0.10

    if agent.me.boost <= 0:
        if shot_type == 1:
            score += 0.22
        elif shot_type == 2:
            score -= 0.12

    return score


def within_elevated_dodge_angle(agent, time_to_intercept, max_angle=75):
    prediction = agent.ball_prediction_struct

    if prediction is None or not prediction.slices:
        return False

    slice_n = max(
        0,
        min(
            len(prediction.slices) - 1,
            math.ceil(time_to_intercept * 120) - 1
        )
    )

    physics = prediction.slices[slice_n].physics
    ball_location = Vector(
        physics.location.x,
        physics.location.y,
        physics.location.z
    )

    # Compare horizontal directions only.
    to_ball = (ball_location - agent.me.location).flatten()
    forward = agent.me.forward.flatten()

    if to_ball.magnitude() < 1 or forward.magnitude() < 1:
        return False

    dot = cap(
        forward.normalize().dot(to_ball.normalize()),
        -1,
        1
    )

    angle = math.degrees(math.acos(dot))
    return angle <= max_angle
def elevated_dodge_reachable(agent, ball_location, time_to_intercept):
    if not isinstance(ball_location, Vector):
        ball_location = Vector(*ball_location)

    car_location = agent.me.location
    distance = (ball_location - car_location).magnitude()

    speed = agent.me.velocity.magnitude()
    boost = agent.me.boost

    time = max(0.0, time_to_intercept)

    acceleration = 900 + min(boost, 50) * 8

    reachable_distance = (
        speed * time
        + 0.5 * acceleration * time * time
        + 250
    )

    return distance <= reachable_distance

def _shot_post_launch_boost_reserve(agent, ball_location, time_remaining, shot_type):
    """
    Boost which must remain available after the C reachability simulation.

    The C finder already budgets boost for its drive-to-approach phase.
    Jump routines can then spend more boost after takeoff, so reserve a
    distance/height-dependent part of that launch window before asking C
    whether the approach is reachable.
    """
    if agent.boost_amount == "unlimited" or shot_type == 0:
        return 0.0

    available = max(0.0, float(agent.me.boost))
    ball = Vector(*ball_location)
    flat_distance = agent.me.location.flat_dist(ball)
    height = max(0.0, ball.z - 92.75 - agent.me.location.z)

    if shot_type in (1, 2):
        # The jump routine starts its launch close to contact. Estimate the
        # powered portion of that short flight window, not the whole search
        # horizon. Nearby/low contacts naturally need little or no reserve.
        try:
            jump_time = virxrlcu.get_jump_time(
                height,
                agent.me.velocity.z,
                agent.gravity.z
            )
        except (TypeError, ValueError, OverflowError):
            jump_time = 0.0

        if jump_time is None or jump_time < 0:
            if shot_type == 2:
                # A double jump can reach heights for which the single-jump
                # time solver has no solution. Use a bounded launch-window
                # estimate rather than silently assuming zero boost demand.
                jump_time = cap(height / 1000.0, 0.10, 0.65)
            else:
                jump_time = 0.0

        jump_time = cap(float(jump_time), 0.0, 0.65)

        # Estimate how much of the car-to-intercept distance can be closed
        # before the jump begins. This avoids charging a long-horizon shot
        # for distance the car has plenty of time to drive forward.
        prelaunch_time = max(0.0, time_remaining - jump_time)
        to_ball = (ball - agent.me.location).flatten()
        approach_direction = to_ball.normalize()
        forward_speed = max(
            0.0,
            agent.me.velocity.flatten().dot(approach_direction)
        )
        base_acceleration = 900.0
        time_to_cap = max(
            0.0,
            (2300.0 - forward_speed) / base_acceleration
        )
        accelerating_time = min(prelaunch_time, time_to_cap)
        drive_distance = (
            forward_speed * accelerating_time
            + 0.5 * base_acceleration * accelerating_time ** 2
            + 2300.0 * max(0.0, prelaunch_time - accelerating_time)
        )
        launch_clearance = max(180.0, float(agent.best_shot_value))
        remaining_gap = max(
            0.0,
            flat_distance - drive_distance - launch_clearance
        )
        distance_factor = cap(
            (remaining_gap - 150.0) / 700.0,
            0.0,
            1.0
        )
        height_factor = cap(height / 350.0, 0.0, 1.0)

        if shot_type == 2:
            jump_time *= 0.75

        # Single-jump shots tend to need more post-launch correction.
        # Double jumps contribute another vertical impulse, reducing that
        # expected boost demand.
        launch_usage = 0.60 if shot_type == 1 else 0.42
        return (
            33.3333333333
            * jump_time
            * launch_usage
            * distance_factor
            * height_factor
        )

    if shot_type == 3:
        # The C aerial test already estimates flight boost and keeps its own
        # safety margin. Add a second, dynamic margin for the difference
        # between its simplified target and Volt's nose-to-contact target.
        distance_3d = agent.me.location.dist(ball)
        distance_factor = cap((distance_3d - 250.0) / 1000.0, 0.0, 1.0)
        height_factor = cap(height / 700.0, 0.0, 1.0)
        return min(
            15.0,
            max(2.0, available * 0.18)
            * distance_factor
            * height_factor
        )

    return 0.0


def _parse_shot_with_boost_budget(
    agent, parser, shot_flags, time_remaining, game_info,
    gravity, ball_info, me, targets=None
):
    """
    Run the normal C finder, then rerun it with post-launch boost reserved.

    Raw VirxERLU car data is a tuple; boost is element 9. Reducing that value
    makes the C drive/aerial reachability test use only the boost actually
    available for the approach phase.
    """
    def run_parser(car_data):
        args = (
            *shot_flags,
            time_remaining,
            *game_info,
            gravity,
            ball_info,
            car_data
        )
        if targets is not None:
            return parser(*args, targets)
        return parser(*args)

    shot = run_parser(me)
    if shot.get("found") != 1 or agent.boost_amount == "unlimited":
        return shot

    original_boost = max(0.0, float(agent.me.boost))
    seen_types = set()

    # A reduced budget can cause the parser to choose a different jump type.
    # Recalculate the reserve for that type, always from the original boost.
    for _ in range(3):
        shot_type = int(shot.get("shot_type", 0))
        if shot_type in seen_types:
            return {"found": 0}
        seen_types.add(shot_type)

        reserve = _shot_post_launch_boost_reserve(
            agent,
            ball_info[0],
            time_remaining,
            shot_type
        )
        if reserve <= 0.25:
            return shot

        approach_budget = original_boost - reserve
        if approach_budget < -0.01:
            if agent.time - getattr(
                agent, "_last_boost_budget_debug", -999.0
            ) >= 0.5:
                agent._last_boost_budget_debug = agent.time
                print(
                    f"[BOOST REACHABILITY REJECT] type={shot_type} "
                    f"boost={original_boost:.1f} reserve={reserve:.1f} "
                    f"reason=post_launch_reserve",
                    flush=True
                )
            return {"found": 0}

        budgeted_me = list(me)
        budgeted_me[9] = int(approach_budget)
        next_shot = run_parser(tuple(budgeted_me))

        if next_shot.get("found") != 1:
            if agent.time - getattr(
                agent, "_last_boost_budget_debug", -999.0
            ) >= 0.5:
                agent._last_boost_budget_debug = agent.time
                print(
                    f"[BOOST REACHABILITY REJECT] type={shot_type} "
                    f"boost={original_boost:.1f} reserve={reserve:.1f} "
                    f"approach_budget={approach_budget:.1f}",
                    flush=True
                )
            return next_shot

        if int(next_shot.get("shot_type", 0)) == shot_type:
            if agent.time - getattr(
                agent, "_last_boost_budget_debug", -999.0
            ) >= 0.5:
                agent._last_boost_budget_debug = agent.time
                print(
                    f"[BOOST REACHABILITY] type={shot_type} "
                    f"boost={original_boost:.1f} "
                    f"post_launch_reserve={reserve:.1f} "
                    f"approach_budget={approach_budget:.1f} "
                    f"T={time_remaining:.2f}",
                    flush=True
                )
            return next_shot

        shot = next_shot

    return {"found": 0}


def find_shot(agent, target, cap_=6, can_aerial=True, can_double_jump=True, can_jump=True, can_ground=True):
    if not can_aerial and not can_double_jump and not can_jump and not can_ground:
        agent.print("WARNING: All shots were disabled when find_shot was ran")
        return

    # Takes a tuple of (left,right) target pairs and finds routines that could hit the ball between those target pairs
    # Only meant for routines that require a defined intercept time/place in the future

    # Assemble data in a form that can be passed to C
    targets = (
        tuple(target[0]),
        tuple(target[1])
    )
    print(
        f"[TARGET DEBUG] left={target[0]} right={target[1]}",
        flush=True
    )

    me = agent.me.get_raw(agent)

    game_info = (
        agent.boost_accel,
        agent.best_shot_value
    )

    gravity = tuple(agent.gravity)

    max_aerial_height = 1200 if len(agent.friends) == 0 and len(agent.foes) == 1 else math.inf
    # Let the Aerial routine apply Party Cannon's exact 300-unit
    # predicted contact-target gate instead of pre-filtering grounded balls
    # with the older, stricter 450-unit ball-centre threshold.
    min_aerial_height = 551 if max_aerial_height > 1200 and agent.me.location.z >= 2044 - agent.me.hitbox.height * 1.1 else (150 if agent.boost_amount == 'unlimited' or agent.me.airborne else 300)

    is_on_ground = not agent.me.airborne
    can_ground = is_on_ground and can_ground
    can_jump = is_on_ground and can_jump
    can_double_jump = is_on_ground and can_double_jump

    # Only disable single-jump shots when the car is actually inside our net.
    # Being near a post or elsewhere in the goal area is not enough.
    if can_jump and _in_own_net(agent):
        can_jump = False

    if not can_ground and not can_jump and not can_double_jump and not can_aerial:
        return

    # Here we get the slices that need to be searched - by defining a cap, we can reduce the number of slices and improve search times
    slices = get_slices(agent, cap_)

    if slices is None:
        return
    best_ball_z = None
    best_shot = None
    best_intercept_time = None
    best_score = float("inf")
    best_ball_location = None
    save_mode = _urgent_save_state(agent)
    if save_mode:
        print(
            f"[SAVE INTERCEPT] earliest-contact mode | "
            f"ball=({agent.ball.location.x:.0f},{agent.ball.location.y:.0f},"
            f"{agent.ball.location.z:.0f})",
            flush=True
        )

    # Calculate Grid's double-jump candidate ONCE per search.
    grid_candidate = None

    if can_double_jump and not agent.me.airborne:
        grid_candidate = grid_find_double_jump(
            agent,
            targets=(Vector(*targets[0]), Vector(*targets[1])),
            horizon=cap_
        )

    # Compare the whole available prediction horizon. The score still values
    # urgency, but it can now select a substantially cleaner later intercept.
    for ball_slice in slices:
        intercept_time = ball_slice.game_seconds
        time_remaining = intercept_time - agent.time - (1 / 120)

        if time_remaining <= 0:
            return

        ball_location = (ball_slice.physics.location.x, ball_slice.physics.location.y, ball_slice.physics.location.z)

        if abs(ball_location[1]) > 5212.75:
            break  # abandon search if ball is scored at/after this point

        ball_info = (ball_location, (ball_slice.physics.velocity.x, ball_slice.physics.velocity.y, ball_slice.physics.velocity.z))

        # Check if we can make a shot at this slice

        # This operation is very expensive, so we use C to improve run time
        # At zero boost, select the jump type from the predicted ball height:
        # airborne ball -> double jump; grounded ball -> regular jump shot.
        slice_can_ground = can_ground
        slice_can_jump = can_jump
        slice_can_double_jump = can_double_jump
        slice_can_aerial = can_aerial and (
            min_aerial_height < ball_location[2] < max_aerial_height
        )

        # When the ball is rebounding from the opponent's back wall,
        # prefer a double-jump option over a single-jump option.
        backwall_rebound = _enemy_backwall_rebound(
            agent, ball_location, ball_slice.physics.velocity
        )
        if backwall_rebound:
            slice_can_jump = False

        if agent.boost_amount != "unlimited" and agent.me.boost <= 0:
            if ball_location[2] > 105.0:
                slice_can_ground = False
                slice_can_jump = False
                slice_can_aerial = False
            else:
                slice_can_double_jump = False

        shot = _parse_shot_with_boost_budget(
            agent,
            virxrlcu.parse_slice_for_shot_with_target,
            (
                slice_can_ground,
                slice_can_jump,
                slice_can_double_jump,
                slice_can_aerial
            ),
            time_remaining,
            game_info,
            gravity,
            ball_info,
            me,
            targets
        )

        # The threshold applies to the live ball and predicted contact. A
        # later high prediction must not make a grounded ball a fast aerial.
        if (
            shot.get("found") == 1
            and int(shot.get("shot_type", -1)) == 3
            and bool(shot.get("fast", False))
            and (
                ball_location[2] <= 350
                or agent.ball.location.z <= 350
            )
        ):
            shot = {**shot, "found": 0}

        # Use an untargeted fast aerial only for a high ball, and only when
        # this slice did not already produce a reachable normal aerial.
        normal_aerial_available = (
            shot.get("found") == 1
            and int(shot.get("shot_type", -1)) == 3
            and not bool(shot.get("fast", False))
        )
        if (
            not normal_aerial_available
            and slice_can_aerial
            and (
                agent.boost_amount == "unlimited"
                or agent.me.boost > 0
            )
        ):
            fast_aerial = _parse_shot_with_boost_budget(
                agent,
                virxrlcu.parse_slice_for_shot,
                (False, False, False, True),
                time_remaining,
                game_info,
                gravity,
                ball_info,
                me
            )
            if (
                fast_aerial.get("found") == 1
                and int(fast_aerial.get("shot_type", -1)) == 3
                and (
                    not bool(fast_aerial.get("fast", False))
                    or (
                        ball_location[2] > 350
                        and agent.ball.location.z > 350
                    )
                )
            ):
                is_fast_aerial = bool(fast_aerial.get("fast", False))
                fast_aerial["targets"] = None
                if save_mode:
                    fast_aerial_score = time_remaining + (
                        0.005 if is_fast_aerial else 0.0
                    )
                else:
                    fast_aerial_score = shot_candidate_score(
                        agent,
                        ball_slice,
                        fast_aerial,
                        time_remaining,
                        target=None
                    )
                    if is_fast_aerial:
                        fast_aerial_score -= 0.45

                if fast_aerial_score < best_score:
                    best_score = fast_aerial_score
                    best_shot = fast_aerial
                    best_intercept_time = intercept_time
                    best_ball_z = ball_location[2]
                    best_ball_location = Vector(*ball_location)
                    if agent.time - getattr(
                        agent, "_last_fast_aerial_touch_debug", -999.0
                    ) >= 0.5:
                        agent._last_fast_aerial_touch_debug = agent.time
                        print(
                            f"[{'FAST' if is_fast_aerial else 'NORMAL'} AERIAL TOUCH CANDIDATE] "
                            f"untargeted T={time_remaining:.2f} "
                            f"score={fast_aerial_score:.3f}",
                            flush=True
                        )


        if shot['found'] == 1:
            # At very low boost, a single-jump shot must leave enough time
            # for the jump and the follow-up dodge impulse. Reject slices
            # whose timing only works if the car reaches the ball without
            # actually executing that dodge.
            if (
                int(shot.get("shot_type", 0)) == 1
                and agent.boost_amount != "unlimited"
                and agent.me.boost < 8
            ):
                required_jump_time = max(
                    0.0,
                    virxrlcu.get_jump_time(
                        ball_location[2] - agent.me.location.z,
                        agent.me.velocity.z,
                        agent.gravity.z
                    )
                )
                required_sequence_time = (
                    required_jump_time * 1.08 + 0.23
                )
                if time_remaining < required_sequence_time:
                    continue

            if not useful_non_aerial_shot(
                agent,
                ball_location,
                ball_slice.physics.velocity,
                shot,
                intercept_time
            ):
                continue

            if save_mode:
                # In a fast own-half threat, choose the first reachable
                # contact. Keep only a tiny preference for simpler touches;
                # do not trade an earlier save for a prettier attacking shot.
                shot_type = shot.get("shot_type", 0)
                save_type_penalty = {
                    0: 0.000,
                    1: 0.005,
                    2: 0.015,
                    3: 0.025
                }.get(shot_type, 0.02)
                score = time_remaining + save_type_penalty
            else:
                score = shot_candidate_score(
                    agent,
                    ball_slice,
                    shot,
                    time_remaining,
                    target
                )

                # With boost available, prefer the simpler single-jump
                # routine over a double jump when their shot qualities are
                # reasonably close. Keep the double jump available as the
                # fallback when it offers a meaningfully better contact.
                if (
                    int(shot.get("shot_type", 0)) == 2
                    and agent.me.boost > 0
                ):
                    score += 0.25

            if score < best_score:
                best_score = score
                best_shot = shot
                best_intercept_time = intercept_time
                best_ball_z = ball_location[2]
                best_ball_location = Vector(*ball_location)
    # Compare Grid's candidate against Volt's best C-parser candidate.
    if grid_candidate is not None:
        grid_time = grid_candidate["time"]
        grid_time_remaining = grid_time - agent.time - (1 / 120)

        if grid_time_remaining > 0:
            grid_slice = min(
                slices,
                key=lambda s: abs(s.game_seconds - grid_time)
            )

            grid_ball_location = Vector(
                *grid_candidate["ball_location"]
            )

            grid_ball_tuple = (
                grid_ball_location.x,
                grid_ball_location.y,
                grid_ball_location.z
            )

            grid_shot = {
                "found": 1,
                "shot_type": 2,
                "fast": False,
                "targets": grid_candidate["targets"]
            }

            grid_boost_reserve = _shot_post_launch_boost_reserve(
                agent,
                grid_ball_tuple,
                grid_time_remaining,
                2
            )
            grid_approach_budget_ok = (
                agent.boost_amount == "unlimited"
                or agent.me.boost - grid_boost_reserve >= 0.0
            )

            if grid_approach_budget_ok and not (
                agent.boost_amount != "unlimited"
                and agent.me.boost <= 0
                and grid_ball_location.z <= 105.0
            ) and useful_non_aerial_shot(
                agent,
                grid_ball_tuple,
                grid_slice.physics.velocity,
                grid_shot,
                grid_time
            ):
                if save_mode:
                    grid_score = grid_time_remaining + 0.015
                else:
                    grid_score = shot_candidate_score(
                        agent,
                        grid_slice,
                        grid_shot,
                        grid_time_remaining,
                        target
                    )
                    if agent.me.boost > 0:
                        grid_score += 0.25

                if grid_score < best_score:
                    best_score = grid_score
                    best_shot = grid_shot
                    best_intercept_time = grid_time
                    best_ball_z = grid_ball_location.z
                    best_ball_location = grid_ball_location

                    print(
                        f"[GRID DOUBLE JUMP] Selected | "
                        f"time={grid_time_remaining:.2f} "
                        f"score={grid_score:.3f} "
                        f"height={grid_ball_location.z:.0f}",
                        flush=True
                    )
    # The loop has ended; construct the best nearby feasible shot.
    if best_shot is None:
        return None
    time_to_intercept = best_intercept_time - agent.time
    best_targets = (
        (
            tuple(best_shot["targets"][0]),
            tuple(best_shot["targets"][1])
        )
        if best_shot.get("targets") is not None
        else None
    )

    contact = select_ball_contact(
        agent,
        best_ball_location,
        best_targets
    )

    if best_shot["shot_type"] == 3:
        routine = Aerial(
            best_intercept_time,
            best_targets,
            best_shot["fast"],
        )
    elif best_shot["shot_type"] in (0, 1) and can_jump:
        # A side shot is a goal-line correction, not a half-field choice.
        # Project the rolling ball to the opponent goal line and only use
        # the side dodge when its path would pass outside a post.
        intercept_slice = min(
            slices,
            key=lambda s: abs(s.game_seconds - best_intercept_time)
        )
        ball_velocity = Vector(
            intercept_slice.physics.velocity.x,
            intercept_slice.physics.velocity.y,
            intercept_slice.physics.velocity.z
        )
        goal_y = (best_targets[0][1] + best_targets[1][1]) * 0.5
        goal_center = Vector(
            (best_targets[0][0] + best_targets[1][0]) * 0.5,
            goal_y,
            (best_targets[0][2] + best_targets[1][2]) * 0.5
        )
        shot_direction = (
            goal_center - best_ball_location
        ).flatten().normalize()
        left_of_goal = Vector(
            -shot_direction.y, shot_direction.x, 0
        ).normalize()
        half_goal_width = abs(best_targets[0][0] - best_targets[1][0]) * 0.5
        time_to_goal_line = (
            (goal_y - best_ball_location.y) / ball_velocity.y
            if abs(ball_velocity.y) > 150 else -1
        )
        projected_goal_x = (
            best_ball_location.x + ball_velocity.x * time_to_goal_line
            if 0 < time_to_goal_line <= 2.5 else None
        )
        rolling_toward_goal = (
            best_ball_location.z <= 420
            and ball_velocity.flatten().magnitude() >= 300
            and 0 < time_to_goal_line <= 2.5
        )
        approach_side = None
        if rolling_toward_goal and projected_goal_x is not None:
            projected_lateral = (
                Vector(projected_goal_x, goal_y, 0) - goal_center
            ).dot(left_of_goal)
            if projected_lateral > half_goal_width - 92.75:
                approach_side = "left"
            elif projected_lateral < -half_goal_width + 92.75:
                approach_side = "right"

        side_shot_selected = False
        if approach_side is not None:
            goal_center = Vector(
                (best_targets[0][0] + best_targets[1][0]) * 0.5,
                goal_y,
                (best_targets[0][2] + best_targets[1][2]) * 0.5
            )
            shot_direction = (goal_center - best_ball_location).flatten().normalize()
            left_of_shot = Vector(
                -shot_direction.y, shot_direction.x, 0
            ).normalize()
            lateral_distance = cap(agent.me.location.flat_dist(best_ball_location) * 0.22, 350, 650)
            side_sign = 1 if approach_side == "right" else -1
            side_setup = (
                best_ball_location
                - left_of_shot * lateral_distance * side_sign
            )
            side_setup_distance = agent.me.location.flat_dist(side_setup)
            side_setup_speed = max(
                1000,
                min(1700, agent.me.velocity.flatten().magnitude() + 500)
            )
            side_setup_local = agent.me.local_location(side_setup)
            side_turn_angle = abs(Vector(x=1).angle2D(side_setup_local))
            side_setup_time = (
                side_setup_distance / side_setup_speed
                + side_turn_angle * 0.30
            )
            if (
                time_to_intercept > side_setup_time + 0.35
                and abs(side_setup.x) < 3900
                and abs(side_setup.y) < 4900
            ):
                routine = side_shot(
                    best_intercept_time, best_targets, approach_side
                )
                side_shot_selected = True
                print(
                    f"[SHOT PLANNER] selected {approach_side} side_shot "
                    f"projected_x={projected_goal_x:.0f} "
                    f"T={time_to_intercept:.2f} "
                    f"setup_distance={side_setup_distance:.0f} "
                    f"travel_estimate={side_setup_time:.2f}",
                    flush=True
                )

        if not side_shot_selected:
            routine = jump_shot(best_intercept_time, best_targets)
    else:
        shot_routines = [ground_shot, jump_shot, double_jump]
        routine = shot_routines[best_shot["shot_type"]](
            best_intercept_time,
            best_targets
        )

    routine.contact_label = contact["label"]
    routine.contact_point = contact["contact_point"]
    routine.contact_normal = contact["normal"]
    routine.contact_approach_target = contact["approach_target"]

    print(
        f"[BALL CONTACT] {contact['label']} "
        f"point={contact['contact_point']} "
        f"approach={contact['approach_target']} "
        f"score={contact['score']:.2f}",
        flush=True
    )

    return routine




def find_any_shot(agent, cap_=6, can_aerial=True, can_double_jump=True,
                  can_jump=True, can_ground=True):
    if not can_aerial and not can_double_jump and not can_jump and not can_ground:
        agent.print("WARNING: All shots were disabled when find_any_shot was ran")
        return

    me = agent.me.get_raw(agent)

    game_info = (
        agent.boost_accel,
        agent.best_shot_value
    )

    gravity = tuple(agent.gravity)

    max_aerial_height = (
        1200
        if len(agent.friends) == 0 and len(agent.foes) == 1
        else math.inf
    )

    min_aerial_height = (
        551
        if max_aerial_height > 1200
        and agent.me.location.z >= 2044 - agent.me.hitbox.height * 1.1
        else (
            150
            if agent.boost_amount == 'unlimited' or agent.me.airborne
            else 350
        )
    )

    is_on_ground = not agent.me.airborne
    can_ground = is_on_ground and can_ground
    can_jump = is_on_ground and can_jump
    can_double_jump = is_on_ground and can_double_jump

    # Only disable single-jump shots when the car is actually inside our net.
    if can_jump and _in_own_net(agent):
        can_jump = False

    if not can_ground and not can_jump and not can_double_jump and not can_aerial:
        return

    slices = get_slices(agent, cap_)
    if slices is None:
        return None
    best_ball_z = None
    best_shot = None
    best_intercept_time = None
    best_score = float("inf")
    best_ball_location = None
    grid_candidate = None

    if can_double_jump and not agent.me.airborne:
        grid_candidate = grid_find_double_jump(
            agent,
            targets=None,
            horizon=cap_
        )
    # Search all sampled slices rather than locking onto the first valid touch.
    for ball_slice in slices:
        intercept_time = ball_slice.game_seconds

        time_remaining = intercept_time - agent.time - (1 / 120)

        if time_remaining <= 0:
            return None

        ball_location = (
            ball_slice.physics.location.x,
            ball_slice.physics.location.y,
            ball_slice.physics.location.z
        )

        if abs(ball_location[1]) > 5212.75:
            break

        ball_info = (
            ball_location,
            (
                ball_slice.physics.velocity.x,
                ball_slice.physics.velocity.y,
                ball_slice.physics.velocity.z
            )
        )

        # At zero boost, airborne contacts must use a double jump;
        # grounded contacts may use a regular jump shot instead.
        slice_can_ground = can_ground
        slice_can_jump = can_jump
        slice_can_double_jump = can_double_jump
        slice_can_aerial = can_aerial and (
            min_aerial_height
            < ball_location[2]
            < max_aerial_height
        )

        # Match find_shot: favour a double jump for an airborne back-wall
        # rebound, but leave ground contacts available.
        backwall_rebound = _enemy_backwall_rebound(
            agent, ball_location, ball_slice.physics.velocity
        )
        if backwall_rebound:
            slice_can_jump = False

        if agent.boost_amount != "unlimited" and agent.me.boost <= 0:
            if ball_location[2] > 105.0:
                slice_can_ground = False
                slice_can_jump = False
                slice_can_aerial = False
            else:
                slice_can_double_jump = False

        shot = _parse_shot_with_boost_budget(
            agent,
            virxrlcu.parse_slice_for_shot,
            (
                slice_can_ground,
                slice_can_jump,
                slice_can_double_jump,
                slice_can_aerial
            ),
            time_remaining,
            game_info,
            gravity,
            ball_info,
            me
        )

        if (
            shot.get("found") == 1
            and int(shot.get("shot_type", -1)) == 3
            and bool(shot.get("fast", False))
            and (
                ball_location[2] <= 350
                or agent.ball.location.z <= 350
            )
        ):
            shot = {**shot, "found": 0}

        # Retain a reachable aerial-only touch when it is useful. Prefer
        # the normal aerial; fast aerials are only eligible above 350 units.
        normal_aerial_available = (
            shot.get("found") == 1
            and int(shot.get("shot_type", -1)) == 3
            and not bool(shot.get("fast", False))
        )
        if (
            not normal_aerial_available
            and slice_can_aerial
            and (
                agent.boost_amount == "unlimited"
                or agent.me.boost > 0
            )
        ):
            fast_aerial = _parse_shot_with_boost_budget(
                agent,
                virxrlcu.parse_slice_for_shot,
                (False, False, False, True),
                time_remaining,
                game_info,
                gravity,
                ball_info,
                me
            )
            if (
                fast_aerial.get("found") == 1
                and int(fast_aerial.get("shot_type", -1)) == 3
                and (
                    not bool(fast_aerial.get("fast", False))
                    or (
                        ball_location[2] > 350
                        and agent.ball.location.z > 350
                    )
                )
            ):
                is_fast_aerial = bool(fast_aerial.get("fast", False))
                fast_aerial_score = shot_candidate_score(
                    agent,
                    ball_slice,
                    fast_aerial,
                    time_remaining,
                    target=None
                )
                if is_fast_aerial:
                    fast_aerial_score -= 0.45
                if fast_aerial_score < best_score:
                    best_score = fast_aerial_score
                    best_shot = {
                        **fast_aerial,
                        "targets": None
                    }
                    best_intercept_time = intercept_time
                    best_ball_z = ball_location[2]
                    best_ball_location = Vector(*ball_location)
                    if agent.time - getattr(
                        agent, "_last_fast_aerial_touch_debug", -999.0
                    ) >= 0.5:
                        agent._last_fast_aerial_touch_debug = agent.time
                        print(
                            f"[{'FAST' if is_fast_aerial else 'NORMAL'} AERIAL TOUCH CANDIDATE] "
                            f"untargeted T={time_remaining:.2f} "
                            f"score={fast_aerial_score:.3f}",
                            flush=True
                        )

        if shot['found'] != 1:
            continue

        if not useful_non_aerial_shot(
            agent,
            ball_location,
            ball_slice.physics.velocity,
            shot,
            intercept_time
        ):
            continue

        # No fixed goal target is supplied for find_any_shot.
        # Score its approach direction and likely contact quality instead.
        score = shot_candidate_score(
            agent,
            ball_slice,
            shot,
            time_remaining,
            target=None
        )
        if (
            int(shot.get("shot_type", 0)) == 2
            and agent.me.boost > 0
        ):
            score += 0.25

        if score < best_score:
            best_score = score
            best_shot = shot
            best_intercept_time = intercept_time
            best_ball_z = ball_location[2]
            best_ball_location = Vector(*ball_location)
    if grid_candidate is not None:
        grid_time = grid_candidate["time"]
        grid_time_remaining = grid_time - agent.time - (1 / 120)

        if grid_time_remaining > 0:
            grid_slice = min(
                slices,
                key=lambda s: abs(
                    s.game_seconds - grid_time
                )
            )

            grid_ball_location = Vector(
                *grid_candidate["ball_location"]
            )

            grid_ball_tuple = (
                grid_ball_location.x,
                grid_ball_location.y,
                grid_ball_location.z
            )

            grid_shot = {
                "found": 1,
                "shot_type": 2,
                "fast": False,
                "targets": grid_candidate["targets"]
            }

            grid_boost_reserve = _shot_post_launch_boost_reserve(
                agent,
                grid_ball_tuple,
                grid_time_remaining,
                2
            )
            grid_approach_budget_ok = (
                agent.boost_amount == "unlimited"
                or agent.me.boost - grid_boost_reserve >= 0.0
            )

            if grid_approach_budget_ok and not (
                agent.boost_amount != "unlimited"
                and agent.me.boost <= 0
                and grid_ball_location.z <= 105.0
            ) and useful_non_aerial_shot(
                agent,
                grid_ball_tuple,
                grid_slice.physics.velocity,
                grid_shot,
                grid_time
            ):
                grid_score = shot_candidate_score(
                    agent,
                    grid_slice,
                    grid_shot,
                    grid_time_remaining,
                    target=None
                )
                if agent.me.boost > 0:
                    grid_score += 0.25

                if grid_score < best_score:
                    best_score = grid_score
                    best_shot = grid_shot
                    best_intercept_time = grid_time
                    best_ball_z = grid_ball_location.z
                    best_ball_location = grid_ball_location

                    print(
                        f"[GRID DOUBLE JUMP] Selected untargeted | "
                        f"time={grid_time_remaining:.2f} "
                        f"score={grid_score:.3f} "
                        f"height={grid_ball_location.z:.0f}",
                        flush=True
                    )
    if best_shot is None:
        return None
    time_to_intercept = best_intercept_time - agent.time
    if best_shot['shot_type'] == 3:
        routine = Aerial(
            best_intercept_time,
            fast_aerial=best_shot['fast'],
        )
        contact = select_ball_contact(
            agent,
            best_ball_location,
            None
        )
        routine.contact_label = contact["label"]
        routine.contact_point = contact["contact_point"]
        routine.contact_normal = contact["normal"]
        routine.contact_approach_target = contact["approach_target"]
        return routine

    if best_shot['shot_type'] in (0, 1) and can_jump:
        # Even without a supplied target, use the real opponent goal posts.
        intercept_slice = min(
            slices,
            key=lambda s: abs(s.game_seconds - best_intercept_time)
        )
        ball_velocity = Vector(
            intercept_slice.physics.velocity.x,
            intercept_slice.physics.velocity.y,
            intercept_slice.physics.velocity.z
        )
        goal_posts = agent.foe_goal_shot
        post_a = (
            goal_posts[0] if isinstance(goal_posts[0], Vector)
            else Vector(*goal_posts[0])
        )
        post_b = (
            goal_posts[1] if isinstance(goal_posts[1], Vector)
            else Vector(*goal_posts[1])
        )
        goal_y = (post_a.y + post_b.y) * 0.5
        goal_center = Vector(
            (post_a.x + post_b.x) * 0.5,
            goal_y,
            (post_a.z + post_b.z) * 0.5
        )
        shot_direction = (
            goal_center - best_ball_location
        ).flatten().normalize()
        left_of_goal = Vector(
            -shot_direction.y, shot_direction.x, 0
        ).normalize()
        half_goal_width = abs(post_a.x - post_b.x) * 0.5
        time_to_goal_line = (
            (goal_y - best_ball_location.y) / ball_velocity.y
            if abs(ball_velocity.y) > 150 else -1
        )
        projected_goal_x = (
            best_ball_location.x + ball_velocity.x * time_to_goal_line
            if 0 < time_to_goal_line <= 2.5 else None
        )
        rolling_toward_goal = (
            best_ball_location.z <= 420
            and ball_velocity.flatten().magnitude() >= 300
            and 0 < time_to_goal_line <= 2.5
        )
        approach_side = None
        if rolling_toward_goal and projected_goal_x is not None:
            projected_lateral = (
                Vector(projected_goal_x, goal_y, 0) - goal_center
            ).dot(left_of_goal)
            if projected_lateral > half_goal_width - 92.75:
                approach_side = "left"
            elif projected_lateral < -half_goal_width + 92.75:
                approach_side = "right"

        if approach_side is not None:
            shot_direction = (
                goal_center - best_ball_location
            ).flatten().normalize()
            left_of_shot = Vector(
                -shot_direction.y, shot_direction.x, 0
            ).normalize()
            lateral_distance = cap(agent.me.location.flat_dist(best_ball_location) * 0.22, 350, 650)
            side_sign = 1 if approach_side == "right" else -1
            side_setup = (
                best_ball_location
                - left_of_shot * lateral_distance * side_sign
            )
            side_setup_distance = agent.me.location.flat_dist(side_setup)
            side_setup_speed = max(
                1000,
                min(1700, agent.me.velocity.flatten().magnitude() + 500)
            )
            side_setup_local = agent.me.local_location(side_setup)
            side_turn_angle = abs(Vector(x=1).angle2D(side_setup_local))
            side_setup_time = (
                side_setup_distance / side_setup_speed
                + side_turn_angle * 0.30
            )
            if (
                time_to_intercept > side_setup_time + 0.35
                and abs(side_setup.x) < 3900
                and abs(side_setup.y) < 4900
            ):
                routine = side_shot(
                    best_intercept_time, approach_side=approach_side
                )
                print(
                    f"[SHOT PLANNER] selected untargeted {approach_side} "
                    f"side_shot projected_x={projected_goal_x:.0f} "
                    f"T={time_to_intercept:.2f} "
                    f"setup_distance={side_setup_distance:.0f} "
                    f"travel_estimate={side_setup_time:.2f}",
                    flush=True
                )
                return routine

    shot_switch = [
        ground_shot,
        jump_shot,
        double_jump
    ]

    return shot_switch[best_shot['shot_type']](
        best_intercept_time
    )


def find_pass_shot(agent, cap_=4):
    """Try a simple ground/jump pass toward a point ahead of a teammate.

    This is deliberately a last-resort target: main.py should call it only
    after both the goal shot and untargeted shot finders return None.
    """
    if not agent.friends:
        return None

    me = agent.me.location
    team_side = side(agent.team)

    # Prefer a teammate who is upfield and reasonably available, not simply
    # the nearest teammate. Score by forward position plus separation from us.
    def teammate_value(friend):
        forward = -friend.location.y * team_side
        separation = friend.location.flat_dist(me)
        return forward + min(separation, 1800) * 0.25

    friend = max(agent.friends, key=teammate_value)
    friend_pos = friend.location
    friend_vel = friend.velocity.flatten()

    # Aim a short distance ahead of the teammate. If they're moving, lead them
    # modestly; otherwise make a safe forward pass toward the opponent half.
    lead_x = friend_pos.x
    if friend_vel.magnitude() > 250:
        lead_x += friend_vel.x / friend_vel.magnitude() * 350
    lead_y = friend_pos.y - team_side * 650
    if friend_vel.magnitude() > 250:
        lead_y += friend_vel.y / friend_vel.magnitude() * 250

    lead_x = cap(lead_x, -3500, 3500)
    lead_y = cap(lead_y, -4600, 4600)
    target = (
        Vector(lead_x - 350, lead_y, 120),
        Vector(lead_x + 350, lead_y, 120)
    )

    # Allow a fast aerial when it can reach the teammate's lead point; its
    # aerial controller keeps the same contact geometry and carries the pass.
    return find_shot(
        agent, target, cap_=cap_, can_aerial=True,
        can_double_jump=False, can_jump=True, can_ground=True
    )


def _urgent_save_state(agent):
    """Detect a fast ball travelling deep into our own half toward our goal."""
    ball = agent.ball.location
    velocity = agent.ball.velocity
    team_side = side(agent.team)
    own_goal = agent.friend_goal.location
    to_goal = Vector(
        own_goal.x - ball.x,
        own_goal.y - ball.y,
        own_goal.z - ball.z
    ).flatten()
    if to_goal.magnitude() < 1:
        return False
    toward_goal_speed = Vector(
        velocity.x, velocity.y, velocity.z
    ).flatten().dot(to_goal.normalize())
    own_half_depth = ball.y * team_side
    goal_distance = to_goal.magnitude()
    return (
        toward_goal_speed >= 400
        and (own_half_depth >= 1500 or goal_distance <= 3200)
    )


def get_slices(agent, cap_):
    struct = agent.ball_prediction_struct

    if struct is None or not struct.slices:
        return None

    max_time = cap_

    # Respect an existing shot's useful window.
    if agent.shooting and agent.stack:
        current = agent.stack[0]

        if current.__class__.__name__ != "short_shot":
            intercept_time = getattr(
                current, "intercept_time", None
            )

            if intercept_time is not None:
                remaining = intercept_time - agent.time

                if 0 <= remaining < 0.5:
                    return None

                if remaining > 0:
                    max_time = min(
                        max_time,
                        remaining - 0.05
                    )

    if max_time <= 0.10:
        return None

    selected = []
    last_sample = -999.0
    urgent_save = _urgent_save_state(agent)

    for ball_slice in struct.slices:
        relative_time = ball_slice.game_seconds - agent.time

        if relative_time < 0.10:
            continue

        if relative_time > max_time:
            break

        # Defensive saves need the earliest reachable contact, not a
        # cleaner later shot. Sample their prediction much more densely so
        # the first viable slice is not skipped by the normal 10 Hz horizon.
        if urgent_save:
            sample_interval = 1 / 40
        else:
            sample_interval = (
                0.05 if relative_time < 1.5 else 0.10
            )

        if relative_time - last_sample < sample_interval:
            continue

        if abs(ball_slice.physics.location.y) > 5250:
            break

        selected.append(ball_slice)
        last_sample = relative_time

    return selected if selected else None


def find_wall_shot_candidate(agent, target, cap_=4):
    """
    Find an aerial intercept that could justify approaching from a
    straight section of the side wall.

    Returns the existing Aerial shot if the predicted contact is a
    plausible wall-shot candidate; otherwise returns None.
    This function does not start movement or alter the routine stack.
    """
    if agent.me.airborne:
        return None

    aerial = find_aerial(agent, target, cap_)

    if aerial is None:
        return None

    time_remaining = aerial.intercept_time - agent.time

    # Don't select an intercept that is too close or too far away.
    if not 0.65 <= time_remaining <= cap_:
        return None

    prediction = agent.ball_prediction_struct

    if prediction is None or not prediction.slices:
        return None

    # Find the prediction slice nearest the aerial's intercept time.
    intercept_slice = min(
        prediction.slices,
        key=lambda s: abs(s.game_seconds - aerial.intercept_time)
    )

    ball = intercept_slice.physics.location

    # Require an elevated ball near a straight side wall, not the
    # corners, where a wall approach needs different geometry.
    if ball.z < 300:
        return None

    if abs(ball.x) < 3400:
        return None

    if abs(ball.y) > 4200:
        return None

    # Avoid attempting a wall route if the car is very far from the
    # ball and has little time to reach the wall.
    car_to_ball = agent.me.location.flat_dist(
        Vector(ball.x, ball.y, ball.z)
    )

    if car_to_ball > 3000 and time_remaining < 1.45:
        return None

    return aerial


def find_wall_shot(agent, target, cap_=6):
    print(
        f"[WALL SHOT] Finder | "
        f"ball=({agent.ball.location.x:.0f}, "
        f"{agent.ball.location.y:.0f}, "
        f"{agent.ball.location.z:.0f})",
        flush=True
    )

    prediction = agent.ball_prediction_struct

    if prediction is None or not prediction.slices:
        return None

    if agent.me.airborne:
        return None

    aerial = find_aerial(agent, target, cap_)

    if aerial is None:
        return None

    time_remaining = aerial.intercept_time - agent.time

    # A wall redirect needs time to build speed, but should not
    # select an intercept so distant that the approach becomes weak.
    if not 0.65 <= time_remaining <= cap_:
        print(
            f"[WALL SHOT] Reject: bad timing | T={time_remaining:.2f}",
            flush=True
        )
        return None

    # Require the fast-aerial variant.
    if not getattr(aerial, "fast_aerial", False):
        print("[WALL SHOT] Reject: aerial is not fast", flush=True)
        return None

    intercept_slice = min(
        prediction.slices,
        key=lambda s: abs(s.game_seconds - aerial.intercept_time)
    )
    ball_velocity = Vector(
        intercept_slice.physics.velocity.x,
        intercept_slice.physics.velocity.y,
        intercept_slice.physics.velocity.z
    )

    ball = intercept_slice.physics.location
    ball_pos = Vector(ball.x, ball.y, ball.z)

    # Keep this to elevated balls near a straight side wall.
    if ball.z < 300 or abs(ball.x) < 3000 or abs(ball.y) > 4200:
        return None

    car = agent.me
    distance = car.location.dist(ball_pos)
    flat_distance = car.location.flat_dist(ball_pos)
    car_speed = car.velocity.magnitude()
    wall_side = 1 if ball.x >= 0 else -1
    moving_toward_side_wall = ball_velocity.x * wall_side > 100

    # Reject intercepts that require unrealistic average travel speed.
    required_speed = distance / max(time_remaining, 0.01)
    if abs(ball.x) < 3700 and not moving_toward_side_wall:
        print(
            "[WALL SHOT] Reject: ball is not approaching side wall",
            flush=True
        )
        return None

    if required_speed > 1900:
        print(
            f"[WALL SHOT] Reject: too far for time | "
            f"distance={distance:.0f} T={time_remaining:.2f} "
            f"required_avg={required_speed:.0f}",
            flush=True
        )
        return None

    # Don't select a distant, slow approach with too little time
    # to accelerate before aerial contact.
    if car_speed < 700 and flat_distance > 1800 and time_remaining < 1.5:
        print(
            f"[WALL SHOT] Reject: low approach speed | "
            f"speed={car_speed:.0f} distance={flat_distance:.0f}",
            flush=True
        )
        return None

    print(
        f"[WALL SHOT] Candidate accepted | "
        f"distance={distance:.0f} speed={car_speed:.0f} "
        f"T={time_remaining:.2f}",
        flush=True
    )

    return aerial
