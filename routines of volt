class defense:
    """
    Goal-line defence.

    Predicts where the ball will cross our goal line and moves
    laterally to cover that point instead of chasing the ball.
    """

    def __init__(self):
        self.goto = goto(Vector(), brake=True)

    def get_target(self, agent):
        side_value = side(agent.team)
        goal = agent.friend_goal
        goal_depth = goal.location.y * side_value

        ball = agent.ball.location
        ball_depth = ball.y * side_value

        # Default to covering the current ball's horizontal position.
        target_x = ball.x

        # Find the predicted ball crossing of our goal line.
        slices = agent.ball_prediction_struct.slices
        start = max(0, agent.future_ball_location_slice - 1)
        previous = None

        for i in range(start, len(slices)):
            physics = slices[i].physics
            current = Vector(
                physics.location.x,
                physics.location.y,
                physics.location.z
            )
            current_depth = current.y * side_value

            if previous is not None:
                previous_depth = previous.y * side_value

                # Ball crosses the goal line while moving toward our goal.
                if (
                    previous_depth < goal_depth
                    and current_depth >= goal_depth
                ):
                    denominator = current_depth - previous_depth

                    if denominator > 0:
                        fraction = (
                            (goal_depth - previous_depth) / denominator
                        )
                        target_x = previous.x + (
                            current.x - previous.x
                        ) * fraction
                    else:
                        target_x = current.x

                    break

            previous = current

        # Stay inside the posts, leaving room for the car's hitbox.
        left_x = min(
            goal.left_post.x,
            goal.right_post.x
        ) + 100
        right_x = max(
            goal.left_post.x,
            goal.right_post.x
        ) - 100

        target_x = max(left_x, min(right_x, target_x))

        # Position just in front of the goal line, not inside the net.
        target_y = goal.location.y - 130 * side_value

        return Vector(target_x, target_y, 0)

    def run(self, agent: VirxERLU):
        side_value = side(agent.team)
        ball_depth = agent.ball.location.y * side_value

        # Leave goal-line mode once play has moved well away from our half.
        if ball_depth < -500:
            agent.pop()
            return

        target = self.get_target(agent)

        self.goto.target = target

        # Face the ball while moving sideways to cover the predicted shot.
        self.goto.vector = agent.ball.location
        self.goto.brake = True
        self.goto.run(agent)

    def is_viable(self, agent):
        # Remain active while the ball is on our side.
        return agent.ball.location.y * side(agent.team) >= -500

class team_anchor:
    """Last-man positioning on the central threat lane, away from the posts.

    The anchor tracks the likely ball path between midfield and the goal mouth.
    It deliberately holds space in front of goal so it can move into a save,
    rather than parking on the goal line or mirroring a teammate at a post.
    """

    def __init__(self):
        self.goto = goto(Vector(), vector=None, brake=False)
        self.goto.allow_wall_dash = False
        self.last_target = None

    def get_target(self, agent):
        side_value = side(agent.team)
        ball = agent.ball.location
        ball_depth = ball.y * side_value

        # Stay goal-side of the ball, but leave enough room to move forward.
        # When the ball is in our half, hold a deeper safety lane; in midfield
        # or attack, step up so the team does not collapse into its own box.
        if ball_depth > 0:
            target_depth = max(2500, min(4400, ball_depth + 1750))
        else:
            target_depth = max(-700, min(2700, ball_depth + 1750))

        # Predict the ball's x coordinate where it reaches the anchor lane.
        target_x = ball.x * 0.42
        prediction = getattr(agent, "ball_prediction_struct", None)
        slices = getattr(prediction, "slices", None) if prediction is not None else None
        if slices:
            start = max(0, min(getattr(agent, "future_ball_location_slice", 0), len(slices) - 1))
            previous = None
            for i in range(start, len(slices)):
                physics = slices[i].physics
                current = Vector(
                    physics.location.x,
                    physics.location.y,
                    physics.location.z
                )
                current_depth = current.y * side_value
                if previous is not None:
                    previous_depth = previous.y * side_value
                    if (
                        min(previous_depth, current_depth) <= target_depth
                        <= max(previous_depth, current_depth)
                        and abs(current_depth - previous_depth) > 1
                    ):
                        fraction = (target_depth - previous_depth) / (current_depth - previous_depth)
                        target_x = previous.x + (current.x - previous.x) * fraction
                        break
                previous = current

        # Avoid sitting directly behind a teammate. A small deterministic
        # lateral offset creates a second save angle without abandoning centre.
        for friend in getattr(agent, "friends", []):
            if friend.location.flat_dist(Vector(target_x, target_depth * side_value)) < 650:
                direction = 1 if (agent.me.index % 2 == 0) else -1
                target_x += direction * 650
                break

        target_x = max(-1850, min(1850, target_x))
        target_depth = max(-800, min(4300, target_depth))
        target = Vector(target_x, target_depth * side_value, 0)

        if self.last_target is not None:
            shift = target - self.last_target
            if shift.magnitude() < 700:
                target = self.last_target + shift * 0.30
        self.last_target = target
        return target

    def run(self, agent: VirxERLU):
        target = self.get_target(agent)
        self.goto.target = target
        self.goto.vector = agent.ball.location
        if agent.me.location.flat_dist(target) < 260:
            brake.run(agent, manual=True)
        else:
            self.goto.run(agent, manual=True)

    def is_viable(self, agent):
        return True


class sideline_cover:
    """A deliberate wide outlet for the non-challenging defender."""
    def __init__(self):
        self.goto = goto(Vector(), brake=False)
        self.goto.allow_wall_dash = False
        self.last_target = None

    def get_target(self, agent):
        side_value = side(agent.team)
        ball = agent.ball.location
        depth = ball.y * side_value
        lane = 1 if agent.me.index % 2 == 0 else -1
        x = lane * (2350 if depth > 1800 else 2050)
        # Stay a little toward midfield from the ball, creating an outlet
        # and preventing three cars from retreating to the same goal area.
        y_depth = max(-700, min(3650, depth - (950 if depth > 1800 else 650)))
        target = Vector(x, y_depth * side_value, 0)
        if self.last_target is not None:
            shift = target - self.last_target
            if shift.magnitude() < 650:
                target = self.last_target + shift * 0.35
        self.last_target = target
        return target

    def run(self, agent: VirxERLU):
        target = self.get_target(agent)
        self.goto.target = target
        self.goto.vector = agent.ball.location
        self.goto.brake = False
        self.goto.run(agent, manual=True)

    def is_viable(self, agent):
        return True


class retreat:
    def __init__(self):
        self.goto = goto(Vector(), brake=True)

    def run(self, agent: VirxERLU):
        ball = self.get_ball_loc(agent, render=True)
        target = self.get_target(agent, ball=ball)

        self_to_target = agent.me.location.flat_dist(target)

        if self_to_target < 250:
            agent.pop()

            if agent.me.local_velocity().x > throttle_accel:
                agent.push(brake())
            return

        self.goto.target = target
        self.goto.run(agent)

    def is_viable(self, agent):
        return agent.me.location.flat_dist(self.get_target(agent)) > 320

    def get_ball_loc(self, agent: VirxERLU, render=False):
        ball_slice = agent.ball_prediction_struct.slices[agent.future_ball_location_slice].physics.location
        ball = Vector(ball_slice.x, cap(ball_slice.y, -5120, 5120))
        if render: agent.sphere(ball + Vector(z=93), 92.75, color=agent.renderer.black)
        ball.y *= side(agent.team)

        if ball.y < agent.ball.location.y * side(agent.team):
            ball = Vector(agent.ball.location.x, agent.ball.location.y * side(agent.team) + 640)

        return ball

    def get_target(self, agent: VirxERLU, ball=None):
        target = None
        if ball is None:
            ball = self.get_ball_loc(agent)

        team_to_ball = [car.location.flat_dist(ball) for car in agent.friends if car.location.y * side(agent.team) >= ball.y - 50 and abs(car.location.x) < abs(ball.x)]
        self_to_ball = agent.me.location.flat_dist(ball)
        team_to_ball.append(self_to_ball)
        team_to_ball.sort()

        if agent.me.location.y * side(agent.team) >= ball.y - 50 and abs(agent.me.location.x) < abs(ball.x):
            if len(agent.friends) == 0 or abs(ball.x) < 900 or team_to_ball[-1] is self_to_ball:
                target = agent.friend_goal.location
            elif team_to_ball[0] is self_to_ball:
                target = agent.friend_goal.right_post if ball.x * side(agent.team) > 0 else agent.friend_goal.left_post

        if target is None:
            if len(agent.friends) <= 1:
                target = agent.friend_goal.location
            else:
                target = agent.friend_goal.left_post if ball.x * side(agent.team) > 0 else agent.friend_goal.right_post

        
        target = target.copy()

        target.y += (
            250 * side(agent.team)
            if (
                len(agent.friends) == 0
                or abs(ball.x) < 900
                or team_to_ball[-1] is self_to_ball
            )
            else -245 * side(agent.team)
        )

        # Retreat must cover the goal from the field side,
        # not drive into the back wall of our own goal.
        side_value = side(agent.team)
        target_depth = target.y * side_value
        target_depth = max(-4800, min(4700, target_depth))
        target.y = target_depth * side_value

        return target.flatten()



class face_target:
    def __init__(self, target=None, ball=False):
        self.target = target
        self.ball = ball
        self.start_loc = None
        self.counter = 0

    @staticmethod
    def get_ball_target(agent):
        ball = agent.ball_prediction_struct.slices[agent.min_intercept_slice].physics.location
        return Vector(ball.x, cap(ball.y, -5120, 5120))

    def run(self, agent: VirxERLU):
        if self.ball:
            target = self.get_ball_target(agent) - agent.me.location.flatten()
        else:
            target = agent.me.velocity.flatten() if self.target is None else (self.target - agent.me.location).flatten()

        if agent.gravity.z < -550 and agent.gravity.z > -750:
            if self.counter == 0 and abs(Vector(x=1).angle(target)) <= 0.05:
                agent.pop()
                return

            if self.counter == 0 and agent.me.airborne:
                self.counter = 3

            if self.counter < 3:
                self.counter += 1

            target = agent.me.local(target)
            if self.counter < 3:
                agent.controller.jump = True
            elif agent.me.airborne and abs(Vector(x=1).angle(target)) > 0.05:
                defaultPD(agent, target)
            else:
                agent.pop()
        else:
            target = agent.me.local(target)
            angle_to_target = abs(Vector(x=1).angle2D(target))
            if angle_to_target > 0.1:
                if self.start_loc is None:
                    self.start_loc = agent.me.location

                direction = 1

                agent.controller.steer = cap(target.y / 100, -1, 1) * direction
                agent.controller.throttle = direction
                agent.controller.handbrake = True
            else:
                agent.pop()
                if self.start_loc is not None:
                    agent.push(goto(self.start_loc, target, True))


class goto_boost:
