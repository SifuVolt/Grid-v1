def _safe_prediction_slice(agent, time_remaining, round_up=False):
    """Return a bounded prediction slice, or None when prediction is absent."""
    prediction = getattr(agent, "ball_prediction_struct", None)
    slices = getattr(prediction, "slices", None) if prediction is not None else None
    if not slices:
        return None

    time_remaining = max(0.0, float(time_remaining))
    if round_up:
        index = math.ceil(time_remaining * 120) - 1
    else:
        index = round(time_remaining * 120) - 1

    index = max(0, min(index, len(slices) - 1))
    return slices[index]


def _relative_goal_aim_point(agent, targets=None):
    """
    Aim near the goal centre, with small offsets based on Volt's position.

    Ground shots target slightly above centre; aerial shots target slightly
    below centre. Volt aims slightly away from its own side of the goal.
    When the ball is still in our half, keep the target at top-centre.
    """
    if targets is not None and len(targets) >= 2:
        post_a = targets[0] if isinstance(targets[0], Vector) else Vector(*targets[0])
        post_b = targets[1] if isinstance(targets[1], Vector) else Vector(*targets[1])
    else:
        post_a, post_b = agent.foe_goal_shot
        post_a = post_a if isinstance(post_a, Vector) else Vector(*post_a)
        post_b = post_b if isinstance(post_b, Vector) else Vector(*post_b)

    goal_center = (post_a + post_b) * 0.5
    goal_center.z = 300

    # While the ball is in our half, favour a higher central target.
    if agent.ball.location.y * side(agent.team) <= 0:
        goal_center.z = 470
        return goal_center

    car_location = agent.me.location

    if not agent.me.airborne:
        goal_center.z += 10
    else:
        goal_center.z -= 90

    return goal_center

def _contact_approach_from_label(ball_location, shot_vector, label, distance):
    """Rebuild a selected contact approach around the latest ball prediction."""
    shot_direction = shot_vector.copy().flatten().normalize()
    if shot_direction.magnitude() < 0.001:
        return None

    lateral = Vector(-shot_direction.y, shot_direction.x, 0).normalize()
    normals = {
        "centre": -shot_direction,
        "left": (-shot_direction + lateral * 0.55).normalize(),
        "right": (-shot_direction - lateral * 0.55).normalize(),
        "high": (-shot_direction + Vector(0, 0, 0.30)).normalize(),
        "low": (-shot_direction - Vector(0, 0, 0.30)).normalize(),
    }
    normal = normals.get(label)
    if normal is None:
        return None

    return ball_location + normal * max(120, distance)

def _shot_approach_target(agent, ball_location, offset_target, shot_vector, time_left):
    """
    Smoothly choose a direct or flank approach to the planned contact point.

    The final contact point remains offset_target. When the car is poorly
    aligned with the intended shot direction and there is time to reposition,
    steer toward a temporary point to one side of the contact point. The
    lateral offset shrinks to zero as the intercept approaches.
    """
    final_target = offset_target.copy().flatten()

    if time_left <= 0.25:
        return final_target

    shot_direction = shot_vector.copy().flatten()
    if shot_direction.magnitude() < 1:
        return final_target
    shot_direction = shot_direction.normalize()

    car_to_ball = (ball_location - agent.me.location).flatten()
    if car_to_ball.magnitude() < 1:
        return final_target
    car_to_ball = car_to_ball.normalize()

    # A high alignment means we're already coming from behind the ball.
    alignment = cap(car_to_ball.dot(shot_direction), -1, 1)
    if alignment >= 0.88:
        return final_target

    lateral = shot_direction.cross(Vector(z=1)).flatten()
    if lateral.magnitude() < 1:
        return final_target
    lateral = lateral.normalize()

    # Stay on the side the car is already on, rather than crossing through
    # the ball or abruptly switching sides while the shot is active.
    car_side = sign((agent.me.location - ball_location).dot(lateral))
    if car_side == 0:
        car_side = 1

    time_blend = cap((time_left - 0.25) / 0.9, 0, 1)
    alignment_blend = cap((0.88 - alignment) / 1.35, 0, 1)
    radius = 700 * time_blend * alignment_blend

    if radius < 80:
        return final_target

    return final_target + lateral * (car_side * radius)


class wave_dash:
    def __init__(self, target=None):
        self.step = -1
        # 0 = forward, 1 = right, 2 = backwards, 3 = left
        self.direction = 0
        self.start_time = -1
        self.target = target

    def run(self, agent: VirxERLU):
        if self.start_time == -1:
            self.start_time = agent.time
        T = agent.time - self.start_time

        self.step += 1

        if self.target is not None:
            self.direction = 0 if abs(self.target.x) > abs(self.target.y) else 1

            if (self.direction == 0 and self.target.x < 0) or (self.direction == 1 and self.target.y < 0):
                self.direction += 2

        forward_target = agent.me.velocity.flatten().normalize() * 100

        target_switch = {
            0: forward_target + Vector(z=50),
            1: forward_target,
            2: forward_target - Vector(z=50),
            3: forward_target
        }

        target_up = {
            0: Vector(z=1),
            1: Vector(y=-50, z=1),
            2: Vector(z=1),
            3: Vector(y=50, z=1)
        }

        defaultPD(agent, agent.me.local(target_switch[self.direction]), up=agent.me.local(target_up[self.direction]))
        if self.direction == 0:
            agent.controller.throttle = 1
        elif self.direction == 2:
            agent.controller.throttle = -1
        else:
            agent.controller.handbrake = True

        if self.step < 1:
            agent.controller.jump = True
        elif self.step < 4:
            pass
        elif not agent.me.airborne:
            agent.pop()
        elif T > 2:
            agent.pop()
            agent.push(recovery(self.target))
        elif agent.me.location.z + (agent.me.velocity.z * 0.2) < 5:
            agent.controller.jump = True
            agent.controller.yaw = 0
            if self.direction in {0, 2}:
                agent.controller.roll = 0
                agent.controller.pitch = -1 if self.direction == 0 else 1
            else:
                agent.controller.roll = -1 if self.direction == 1 else 1
                agent.controller.pitch = 0

class wall_approach:
    WALL_X = 3850
    MIN_BALL_HEIGHT = 250
    WALL_BALL_X = 2850

    def __init__(self, intercept_time, targets=None):
        self.intercept_time = intercept_time
        self.targets = targets
        self.ball_location = None
        self.ready_for_aerial = False
        self.start_time = -1
        self.last_debug_time = -1

    def update(self, shot):
        self.intercept_time = shot.intercept_time
        self.targets = shot.targets

    def on_side_wall(self, agent):
        car = agent.me

        return (
            abs(car.location.x) > 3500
            and abs(car.up.x) > 0.65
            and car.up.x * car.location.x < 0
        )

    def run(self, agent: VirxERLU, manual=False):
        if self.start_time < 0:
            self.start_time = agent.time
            print("[WALL APPROACH] START", flush=True)

        if not agent.shooting:
            agent.shooting = True

        T = self.intercept_time - agent.time

        prediction = agent.ball_prediction_struct
        if prediction is None or not prediction.slices:
            print("[WALL APPROACH] No ball prediction", flush=True)
            agent.pop()
            agent.shooting = False
            return

        # Clamp the index to the available prediction slices.
        # Keep the project's existing 120 Hz indexing convention for now.
        slice_n = max(
            0,
            min(
                len(prediction.slices) - 1,
                round(max(0, T) * 120)
            )
        )

        ball_slice = prediction.slices[slice_n]
        physics = ball_slice.physics

        self.ball_location = Vector(
            physics.location.x,
            physics.location.y,
            physics.location.z
        )

        ball = self.ball_location
        car = agent.me

        distance = car.location.dist(ball)
        on_wall = self.on_side_wall(agent)

        agent.sphere(ball, 92.75)

        # Don't waste time climbing if the ball is no longer a
        # useful wall target.
        if T <= 0.12:
            print(
                f"[WALL APPROACH] Intercept expired T={T:.2f}",
                flush=True
            )
            agent.pop()
            agent.shooting = False
            return

        # Project the target onto the side-wall plane. The ball's
        # predicted Y/Z coordinates guide movement along the wall.
        wall_side = 1 if ball.x >= 0 else -1

        wall_target = Vector(
            wall_side * self.WALL_X,
            ball.y,
            max(100, ball.z)
        )

        if not on_wall:
            # First drive toward the side wall, aiming toward the
            # ball's predicted Y position rather than its current spot.
            approach_target = Vector(
                wall_side * self.WALL_X,
                ball.y,
                car.location.z
            )
        else:
            # Once on the wall, steer toward the predicted contact.
            approach_target = wall_target

        local_target = car.local_location(approach_target)

        # Estimate a reasonable approach speed.
        time_left = max(0.15, min(T, 4.0))
        speed_required = min(2200, distance / time_left)

        defaultDrive(agent, speed_required, local_target)

        agent.controller.boost = (
            car.boost > 0
            and speed_required > 1300
            and distance > 1000
        )

        # The main.py logic will use this signal to try an aerial.
        # Don't jump blindly: first reach the wall and get close enough
        # that an aerial intercept might be possible.
        self.ready_for_aerial = (
            on_wall
            and ball.z > self.MIN_BALL_HEIGHT
            and abs(ball.x) > self.WALL_BALL_X
            and distance < 1500
            and 0.15 < T < 1.5
        )

        if agent.time - self.last_debug_time > 0.25:
            print(
                f"[WALL APPROACH] "
                f"wall={on_wall} "
                f"ball=({ball.x:.0f},{ball.y:.0f},{ball.z:.0f}) "
                f"distance={distance:.0f} "
                f"T={T:.2f} "
                f"aerial_ready={self.ready_for_aerial}",
                flush=True
            )
            self.last_debug_time = agent.time
    
class wall_dash:
    JUMP_TIME = 0.07
    RELEASE_TIME = 0.05
    DODGE_TIME = 0.08

    # Maximum time allowed to regain wall contact after a dash.
    LAND_TIMEOUT = 0.40

    # Prevent repeated jumps immediately after landing.
    LAND_SETTLE_TIME = 0.05

    MAX_TIME = 2.5

    def __init__(self, target):
        self.target = target.copy()
        self.start_time = -1
        self.phase_start = -1

        # 0 = jump, 1 = release, 2 = dodge, 3 = wait for landing
        self.phase = 0

        self.last_wall_contact = -1
        self.dash_count = 0
        self.lost_wall_time = -1

    def on_side_wall(self, agent):
        car = agent.me

        return (
            not car.airborne
            and abs(car.location.x) > 3500
            and abs(car.up.z) < 0.45
        )

    def stop(self, agent, reason, manual=False):
        print(
            f"[WALL DASH] STOP reason={reason} "
            f"dashes={self.dash_count}",
            flush=True
        )

        if not manual:
            agent.pop()

    def run(self, agent: VirxERLU, manual=False):
        if self.start_time < 0:
            self.start_time = agent.time
            self.phase_start = agent.time

            print(
                f"[WALL DASH] START "
                f"target={self.target} "
                f"speed={agent.me.velocity.magnitude():.0f}",
                flush=True
            )

        elapsed = agent.time - self.start_time
        phase_time = agent.time - self.phase_start

        if elapsed > self.MAX_TIME:
            self.stop(agent, "time limit", manual)
            return

        distance = agent.me.location.flat_dist(self.target)

        if distance < 1200:
            self.stop(agent, "target reached", manual)
            return

        # Keep steering toward the destination while dashing.
        local_target = agent.me.local_location(self.target)
        defaultPD(agent, local_target)

        agent.controller.throttle = 1

        # Boost only when there is enough distance to benefit.
        agent.controller.boost = (
            agent.me.boost > 0
            and distance > 1800
        )

        wall_contact = self.on_side_wall(agent)

        if wall_contact:
            self.last_wall_contact = agent.time

        # Phase 0: initiate a short jump, but only while
        # physically in contact with the side wall.
        if self.phase == 0:
            if not wall_contact:
                if (
                    self.last_wall_contact < 0
                    or agent.time - self.last_wall_contact > 0.15
                ):
                    self.stop(agent, "no wall contact before jump", manual)
                return

            agent.controller.jump = True

            if phase_time >= self.JUMP_TIME:
                self.phase = 1
                self.phase_start = agent.time

                print(
                    f"[WALL DASH] JUMP #{self.dash_count + 1}",
                    flush=True
                )

            return

        # Phase 1: release jump. This is essential before
        # pressing jump again for the dodge.
        if self.phase == 1:
            agent.controller.jump = False

            if phase_time >= self.RELEASE_TIME:
                self.phase = 2
                self.phase_start = agent.time

            return

        # Phase 2: dodge forward, with a small directional
        # adjustment toward the target.
        if self.phase == 2:
            agent.controller.jump = True
            agent.controller.pitch = -1

            if abs(local_target.y) > 100:
                agent.controller.yaw = (
                    0.6 if local_target.y > 0 else -0.6
                )
            else:
                agent.controller.yaw = 0

            if phase_time >= self.DODGE_TIME:
                self.phase = 3
                self.phase_start = agent.time
                self.lost_wall_time = agent.time
                self.dash_count += 1

                print(
                    f"[WALL DASH] DODGE COMPLETE "
                    f"#{self.dash_count}",
                    flush=True
                )

            return

        # Phase 3: do NOT jump again until wall contact returns.
        agent.controller.jump = False
        agent.controller.pitch = 0
        agent.controller.yaw = 0

        if wall_contact:
            if phase_time >= self.LAND_SETTLE_TIME:
                self.phase = 0
                self.phase_start = agent.time

                print(
                    f"[WALL DASH] RECONTACT "
                    f"#{self.dash_count} "
                    f"speed={agent.me.velocity.magnitude():.0f}",
                    flush=True
                )

            return

        # If the car fails to return to the wall, abort instead
        # of repeatedly jumping while airborne.
        if (
            self.lost_wall_time >= 0
            and agent.time - self.lost_wall_time > self.LAND_TIMEOUT
        ):
            self.stop(agent, "failed to regain wall contact", manual)
            return


class double_jump:
    # Grid-style double jump execution, adapted to Volt's routine interface.

    def __init__(self, intercept_time, targets=None):
        self.ball_location = None
        self.ball_velocity = None
        self.shot_vector = None
        self.offset_target = None
        self.intercept_time = intercept_time
        self.base_intercept_time = intercept_time
        self.targets = targets
        self.goal_aim_point = None

        self.jumping = False
        self.jump_time = -1
        self.jump_frames = 0
        self.second_jump_sent = False
        self.prev_jump = False
        self.counter = 0
        self.should_chip = False

    def update(self, shot):
        self.base_intercept_time = shot.intercept_time
        self.intercept_time = shot.intercept_time
        self.targets = shot.targets

    def _select_patient_intercept(self, agent):
        """
        Apply Grid's double-jump wait-for-fall and back-wall alignment delay.

        This only changes the intercept used by the double_jump routine;
        Volt's ground, jump-shot, and aerial selection remain untouched.
        """
        prediction = getattr(agent, "ball_prediction_struct", None)
        slices = getattr(prediction, "slices", None) if prediction is not None else None
        if not slices or self.targets is None:
            return

        start_time = max(
            self.base_intercept_time,
            agent.time + 1 / 120
        )
        end_time = min(agent.time + 5.0, slices[-1].game_seconds)

        def shot_direction(ball_location):
            direction = (ball_location - agent.me.location).normalize()
            left = (self.targets[0] - ball_location).normalize()
            right = (self.targets[1] - ball_location).normalize()
            if direction.magnitude() < 1:
                return left
            return direction.clamp2D(left, right)

        def double_jump_reachable(ball_location, direction):
            contact_z = ball_location.z - direction.z * 92.75
            required_height = max(
                0.0,
                contact_z - agent.me.location.z
            )
            jump_time, _ = new_jump_time(required_height, True)
            return jump_time is not None

        start_index = next(
            (
                i for i, prediction_slice in enumerate(slices)
                if prediction_slice.game_seconds >= start_time
            ),
            None
        )
        if start_index is None:
            return

        selected_index = None
        for i in range(start_index, len(slices)):
            prediction_slice = slices[i]
            if prediction_slice.game_seconds > end_time:
                break

            physics = prediction_slice.physics
            ball = physics.location
            ball_location = Vector(ball.x, ball.y, ball.z)
            direction = shot_direction(ball_location)

            # Grid records an unreachable high contact, then takes the
            # first later prediction where the double jump can reach it.
            if double_jump_reachable(ball_location, direction):
                selected_index = i
                break

        if selected_index is None:
            return

        # Grid's delay=True behaviour: when a ball is moving in from the
        # side near the opponent back wall, wait until it enters a better
        # central shooting lane instead of attacking the poor angle early.
        selected_slice = slices[selected_index]
        selected_physics = selected_slice.physics
        selected_ball = selected_physics.location
        selected_velocity = selected_physics.velocity
        goal_y = agent.foe_goal.location.y

        needs_alignment_delay = (
            abs(selected_ball.x) < 3000
            and abs(selected_ball.x) - 890 + 92.75 * math.sqrt(2)
                > abs(selected_ball.y - goal_y)
            and selected_velocity.x * sign(selected_ball.x) < 0
        )

        if needs_alignment_delay:
            for i in range(selected_index + 1, len(slices)):
                prediction_slice = slices[i]
                if prediction_slice.game_seconds > end_time:
                    break

                physics = prediction_slice.physics
                ball = physics.location
                ball_location = Vector(ball.x, ball.y, ball.z)
                direction = shot_direction(ball_location)

                aligned = (
                    abs(ball.x) - 890 + 92.75 * math.sqrt(2)
                    <= abs(ball.y - goal_y)
                )
                if aligned and double_jump_reachable(ball_location, direction):
                    selected_index = i
                    break

        self.intercept_time = slices[selected_index].game_seconds

    def needs_half_flip(self, agent):
        if self.targets is None or self.intercept_time <= agent.time:
            return False

        ball_slice = _safe_prediction_slice(
            agent, self.intercept_time - agent.time
        )
        if ball_slice is None:
            return False

        ball = ball_slice.physics.location
        ball_location = Vector(ball.x, ball.y, ball.z)

        direction = (ball_location - agent.me.location).normalize()
        if self.goal_aim_point is None:
            self.goal_aim_point = _relative_goal_aim_point(agent, self.targets)
        shot_vector = (
            self.goal_aim_point - ball_location
        ).flatten().normalize()

        offset_target = ball_location - shot_vector * agent.best_shot_value
        return agent.me.local_location(offset_target).x < 0

    def _finish(self, agent):
        agent.pop()
        agent.shooting = False
        agent.shot_weight = -1
        agent.shot_time = -1

        if agent.me.airborne:
            agent.push(ball_recovery())

    def run(self, agent: VirxERLU):
        if not agent.shooting:
            agent.shooting = True

        if not self.jumping:
            self._select_patient_intercept(agent)

        T = self.intercept_time - agent.time
        time_remaining = cap(T, 0.000001, 6)

        # Refresh the predicted ball position until the jump starts.
        if not self.jumping:
            ball_slice = _safe_prediction_slice(agent, T)

            if ball_slice is None:
                self._finish(agent)
                return

            ball = ball_slice.physics.location
            velocity = ball_slice.physics.velocity

            self.ball_location = Vector(ball.x, ball.y, ball.z)
            self.ball_velocity = Vector(
                velocity.x, velocity.y, velocity.z
            )

        if self.ball_location is None:
            self._finish(agent)
            return

        # Work out the contact direction and the point behind the ball.
        direction = (
            self.ball_location - agent.me.location
        ).normalize()

        if self.goal_aim_point is None:
            self.goal_aim_point = _relative_goal_aim_point(agent, self.targets)

        self.shot_vector = (
            self.goal_aim_point - self.ball_location
        ).flatten().normalize()

        self.offset_target = (
            self.ball_location
            - self.shot_vector * agent.best_shot_value
        )
        contact_label = getattr(self, "contact_label", None)
        refreshed_contact = _contact_approach_from_label(
            self.ball_location,
            self.shot_vector,
            contact_label,
            agent.best_shot_value
        )
        if refreshed_contact is not None:
            self.offset_target = refreshed_contact
            self.contact_point = (
                self.ball_location
                + (refreshed_contact - self.ball_location).normalize() * 92.75
            )
            self.contact_approach_target = refreshed_contact.copy()

        agent.sphere(self.ball_location, 92.75)

        # Grid's jump model determines when the first jump must begin.
        required_height = max(
            0.0, self.offset_target.z - agent.me.location.z
        )
        jump_time, jump_amount = new_jump_time(
            required_height, True
        )

        if jump_time is None:
            self._finish(agent)
            return

        # Keep Volt's existing approach-target adjustment.
        final_target = self.offset_target.copy().flatten()
        Tj = T - jump_time * 1.15

        if Tj > 0 and self.targets is not None:
            final_target = _shot_approach_target(
                agent,
                self.ball_location,
                final_target,
                self.shot_vector,
                Tj
            )

        final_target = cap_in_field(agent, final_target)
        local_target = agent.me.local_location(final_target)
        local_offset = agent.me.local_location(
            self.offset_target.flatten()
        )

        angle_to_target = abs(Vector(x=1).angle2D(local_target))
        distance_remaining = final_target.flat_dist(
            agent.me.location
        ) - agent.me.hitbox.length / 3

        direction_sign = 1
        local_ball = agent.me.local_location(agent.ball.location)

        if (
            angle_to_target >= 1.6
            and agent.me.local_velocity().x <= 1000
            and local_ball.x < -250
        ):
            direction_sign = -1

        agent.line(
            agent.me.location,
            self.offset_target,
            agent.renderer.white
        )
        agent.line(
            self.offset_target - Vector(z=100),
            self.offset_target + Vector(z=100),
            agent.renderer.green
        )
        agent.line(
            final_target - Vector(z=100),
            final_target + Vector(z=100),
            agent.renderer.purple
        )

        # ---------------------------------------------------------
        # Ground approach: arrive at the contact point before jumping.
        # ---------------------------------------------------------
        if not self.jumping:
            speed_required = distance_remaining / time_remaining

            velocity = defaultDrive(
                agent,
                speed_required * direction_sign,
                local_target
            )[1]

            if velocity == 0:
                velocity = 1

            local_velocity = agent.me.local_velocity()
            time_to_target = distance_remaining / (
                abs(velocity) + dodge_impulse(agent)
            )

            aligned = (
                abs(local_offset.y) < 92
                and direction_sign * local_velocity.x
                >= direction_sign * (
                    local_offset.x - agent.me.hitbox.length / 3
                )
                and direction_sign * local_offset.x > 0
            )

            close_enough = (
                abs(velocity) < 100
                and distance_remaining < agent.me.hitbox.length / 2
            )

            # Start the jump at the Grid-calculated time.
            if (
                not agent.me.airborne
                and T <= jump_time
                and (aligned or close_enough)
            ):
                self.jumping = True
                self.jump_time = agent.time
                self.jump_frames = 0
                self.second_jump_sent = False
                self.prev_jump = False

            elif agent.me.airborne:
                agent.push(recovery(final_target if Tj > 0 else None))

            elif T <= jump_time or (
                Tj > 0
                and distance_remaining > 50
                and not virxrlcu.double_jump_shot_is_viable(
                    T,
                    agent.boost_accel,
                    tuple(agent.gravity),
                    agent.me.get_raw(agent),
                    self.offset_target.z,
                    tuple(
                        (final_target - agent.me.location).normalize()
                    ),
                    distance_remaining
                )
            ):
                self._finish(agent)
                return

            elif (
                agent.boost_amount != 'unlimited'
                and agent.me.boost < 48
                and angle_to_target < 0.03
                and velocity > 600
                and time_to_target >= jump_time * 1.15 + 1.75
            ):
                if agent.gravity.z < -450 and time_to_target < 5:
                    agent.push(wave_dash(local_offset))
                else:
                    agent.push(flip(local_offset))

            elif (
                agent.boost_amount != 'unlimited'
                and angle_to_target >= 2
                and velocity < 200
                and time_to_target >= jump_time * 1.15 + 2
                and distance_remaining > 1280
            ):
                agent.push(flip(local_offset, True))

            return

        # ---------------------------------------------------------
        # Grid-style jump sequence.
        # First jump: hold for 24 frames.
        # Second jump: a separate one-frame press.
        # ---------------------------------------------------------
        elapsed = agent.time - self.jump_time
        self.jump_frames = max(0, round(elapsed * 120))

        if self.jump_frames < 24:
            agent.controller.jump = True
            self.prev_jump = True

        elif (
            not self.second_jump_sent
            and not agent.me.doublejumped
        ):
            # Release the first jump before sending the second press.
            if self.prev_jump:
                agent.controller.jump = False
                self.prev_jump = False
            else:
                agent.controller.jump = True
                self.second_jump_sent = True
                self.prev_jump = True

        else:
            agent.controller.jump = False
            self.prev_jump = False

        # Aim toward the contact point during the jump.
        local_contact = agent.me.local_location(
            self.offset_target
        )
        defaultPD(agent, local_contact)

        # Use boost only when it can help close the remaining gap.
        if T > 0:
            future_velocity = (
                agent.me.velocity + agent.gravity * T
            )
            future_position = (
                agent.me.location
                + agent.me.velocity * T
                + agent.gravity * (0.5 * T * T)
            )

            delta = self.offset_target - future_position
            forward_need = delta.dot(agent.me.forward) / T

            if (
                forward_need > agent.boost_accel * min_boost_time
                and agent.me.boost > 0
            ):
                agent.controller.boost = True
            elif abs(forward_need) > 1:
                agent.controller.throttle = cap(
                    forward_need / (
                        throttle_accel * min_boost_time
                    ),
                    -1,
                    1
                )

        # End the routine after the contact window has passed.
        if T <= -0.4 or (
            not agent.me.airborne and self.jump_frames >= 30
        ):
            self._finish(agent)




class Aerial:
    def __init__(self, intercept_time, targets=None, fast_aerial=True):
        self.intercept_time = intercept_time
        self.fast_aerial = fast_aerial
        self.targets = targets
        self.goal_aim_point = None
        self.shot_vector = None
        self.target = None
        self.ball = None

        self.jump_type_fast = None
        self.jumping = False
        self.dodging = False
        self.ceiling = False
        self.jump_time = -1
        self.counter = 0
        self.final_boost_fired = False

    def update(self, shot):
        self.intercept_time = shot.intercept_time
        self.fast_aerial = shot.fast_aerial
        self.targets = shot.targets
    
    def party_cannon_shot_direction(
        self, ball_location, ball_velocity,
        car_location, shot_target, time_remaining,
        car_forward=None, car_boost=0, gravity=None, car_velocity=None
    ):
        """
        Predict the required outgoing ball direction while accounting
        for the car's estimated contact velocity and existing ball motion.
        """

        max_speed = 2300.0

        to_ball = ball_location - car_location
        to_target = (shot_target - ball_location).flatten()

        if to_target.magnitude() < 1:
            return Vector(0, 1, 0)

        goal_direction = to_target.normalize()

        if time_remaining <= 0.001:
            return goal_direction

        # Estimate contact velocity without assuming the car can cover
        # the entire car-to-ball displacement instantly. Air turning takes
        # time, and forward acceleration is limited by remaining boost.
        current_velocity = car_velocity if car_velocity is not None else Vector()

        if car_forward is None or car_forward.flatten().magnitude() < 0.01:
            car_forward = to_ball.normalize()
        else:
            car_forward = car_forward.normalize()

        desired_direction = to_ball.normalize()
        heading_dot = cap(car_forward.dot(desired_direction), -1, 1)
        heading_error = math.acos(heading_dot)
        estimated_turn_rate = 2.5  # conservative air-turn rate, rad/s
        turn_time = min(time_remaining, heading_error / estimated_turn_rate)
        powered_time = max(0.0, time_remaining - turn_time)

        boost_acceleration = 991.0 if car_boost > 0 else 0.0
        usable_boost_time = min(powered_time, car_boost / boost_per_second)
        acceleration_time = usable_boost_time

        # By the end of the estimated turn, the nose is assumed to be
        # approximately aligned with the ball; boost then accelerates along
        # that corrected heading rather than the stale starting heading.
        car_final_velocity = current_velocity + desired_direction * (
            boost_acceleration * acceleration_time
        )
        if gravity is not None:
            car_final_velocity = car_final_velocity + gravity * time_remaining

        if car_final_velocity.magnitude() > max_speed:
            car_final_velocity = car_final_velocity.normalize() * max_speed

        # Relative velocity determines how much power the contact has.
        relative_velocity = car_final_velocity - ball_velocity
        velocity_difference = relative_velocity.magnitude()

        if velocity_difference <= 500:
            power_modifier = 0.65
        elif velocity_difference <= max_speed:
            power_modifier = (
                0.65 - 0.10 *
                ((velocity_difference - 500) / 1800)
            )
        else:
            power_modifier = (
                0.55 - 0.25 *
                cap(
                    (velocity_difference - max_speed) / 2300,
                    0,
                    1
                )
            )

        # Estimate the available outgoing speed.
        forward_contact_speed = max(
            0,
            car_final_velocity.dot(goal_direction)
        )

        ball_forward_speed = ball_velocity.dot(goal_direction)

        estimated_ball_speed = cap(
            velocity_difference * power_modifier
            + forward_contact_speed * 0.35
            + ball_forward_speed * 0.65,
            500,
            max_speed
        )

        # Predict where the ball would travel without changing its
        # direction, then calculate the direction needed to reach goal.
        flat_distance = to_target.magnitude()
        time_to_target = flat_distance / max(estimated_ball_speed, 1)

        predicted_ball_position = (
            ball_location + ball_velocity * time_to_target
        )

        # Blend the direct goal direction with a correction for
        # existing ball momentum.
        momentum_direction = (
            shot_target - predicted_ball_position
        ).flatten()

        if momentum_direction.magnitude() < 1:
            return goal_direction

        momentum_direction = momentum_direction.normalize()

        # Keep the goal as the dominant influence. Existing ball
        # momentum should refine the aim, not pull it away from goal.
        correction_strength = cap(
            velocity_difference / 1800,
            0.15,
            0.40
        )

        desired_direction = (
            goal_direction * (1.0 - correction_strength)
            + momentum_direction * correction_strength
        )

        if desired_direction.magnitude() < 1:
            return goal_direction

        return desired_direction.normalize()
    def run(self, agent: VirxERLU):
        if not agent.shooting:
            agent.shooting = True

        
        T = self.intercept_time - agent.time

        xf = (
            agent.me.location
            + agent.me.velocity * T
            + 0.5 * agent.gravity * T * T
        )

        vf = agent.me.velocity + agent.gravity * T

        prediction = agent.ball_prediction_struct

        if prediction is None or not prediction.slices:
            return

        # Find the prediction slice closest to the actual intercept time.
        slice_n = min(
            range(len(prediction.slices)),
            key=lambda i: abs(
                prediction.slices[i].game_seconds
                - self.intercept_time
            )
        )

        agent.dbg_2d(f"Shot slice #: {slice_n}")

        physics = prediction.slices[slice_n].physics

        ball_velocity = Vector(
            physics.velocity.x,
            physics.velocity.y,
            physics.velocity.z
        )

        if T > 0.1 or self.ball is None:
            ball = physics.location
            self.ball = Vector(ball.x, ball.y, ball.z)

            self.ceiling = (
                agent.me.location.z
                > 2044 - agent.me.hitbox.height * 2
                and not agent.me.jumped
            )

        # Choose a goal corner based on Volt's position relative to the goal.
        if self.goal_aim_point is None:
            self.goal_aim_point = _relative_goal_aim_point(agent, self.targets)
        shot_target = self.goal_aim_point.copy()

        # Party Cannon predicted post-contact shot direction.
        self.shot_vector = self.party_cannon_shot_direction(
            self.ball,
            ball_velocity,
            agent.me.location,
            shot_target,
            T,
            car_forward=agent.me.forward,
            car_boost=agent.me.boost,
            gravity=agent.gravity,
            car_velocity=agent.me.velocity
        )

        print(
            f"[AERIAL PARTY CANNON] "
            f"ball=({self.ball.x:.0f},{self.ball.y:.0f},"
            f"{self.ball.z:.0f}) "
            f"target=({shot_target.x:.0f},{shot_target.y:.0f},"
            f"{shot_target.z:.0f}) "
            f"direction=({self.shot_vector.x:.2f},"
            f"{self.shot_vector.y:.2f},"
            f"{self.shot_vector.z:.2f})",
            flush=True
        )


        
        # Detect a useful backboard rebound for an already-airborne car.
        left_post, right_post = agent.foe_goal_shot

        goal_center = self.goal_aim_point.copy()

        # Read the predicted ball velocity at this aerial's intercept.
        prediction = agent.ball_prediction_struct
        backboard_mode = False
        goal_direction = (goal_center - self.ball).normalize()

        if (
            agent.me.airborne
            and prediction is not None
            and 0 <= slice_n < len(prediction.slices)
        ):
            physics = prediction.slices[slice_n].physics
            ball_velocity = Vector(
                physics.velocity.x,
                physics.velocity.y,
                physics.velocity.z
            )

            # Positive means moving towards goal; negative means away.
            towards_goal = ball_velocity.dot(goal_direction)

            near_backboard = (
                abs(self.ball.y - goal_center.y) < 1100
                and self.ball.z > 450
                and abs(self.ball.x) < 3500
            )

            # Only take over for an actual rebound opportunity.
            # Avoid activating for a ball simply travelling into the wall.
            backboard_mode = (
                near_backboard
                and towards_goal < -150
                and 0.15 < T < 2.0
            )

        if backboard_mode:
            self.shot_vector = goal_direction

            if (
                not hasattr(self, "last_backboard_debug")
                or agent.time - self.last_backboard_debug >= 0.5
            ):
                self.last_backboard_debug = agent.time
                print(
                    f"[AERIAL BACKBOARD] Rebound follow-up | "
                    f"ball=({self.ball.x:.0f}, {self.ball.y:.0f}, "
                    f"{self.ball.z:.0f}) | "
                    f"car_z={agent.me.location.z:.0f} | "
                    f"goal_dir=({goal_direction.x:.2f}, "
                    f"{goal_direction.y:.2f}, {goal_direction.z:.2f})",
                    flush=True
                )

        self.target = self.ball - (
            self.shot_vector * agent.best_shot_value
        )


        agent.sphere(self.ball, 92.75)

        if self.ceiling:
            self.target -= Vector(z=92)

        if self.jumping or not agent.me.airborne:
            agent.dbg_2d("Jumping")

            if not self.jumping or not agent.me.airborne:
                self.jump_type_fast = self.fast_aerial
                self.jumping = True
                self.jump_time = agent.time
                self.counter = 0

            jump_elapsed = agent.time - self.jump_time

            # how much of the jump acceleration time is left
            tau = max(0.0, jump_max_duration - jump_elapsed)

            # impulse from the first jump
            if jump_elapsed == 0:
                vf += agent.me.up * jump_speed
                xf += agent.me.up * jump_speed * T

            # acceleration from holding jump
            vf += agent.me.up * jump_acc * tau
            xf += agent.me.up * jump_acc * tau * (T - 0.5 * tau)

            if self.jump_type_fast:
                # impulse from the second jump
                vf += agent.me.up * jump_speed
                xf += agent.me.up * jump_speed * (T - tau)

                if jump_elapsed <= jump_max_duration:
                    agent.controller.jump = True
                elif self.counter < 4:
                    self.counter += 1

                if self.counter == 3:
                    agent.controller.jump = True
                    self.dodging = True
                elif self.counter == 4:
                    self.dodging = self.jumping = False
            elif jump_elapsed <= jump_max_duration:
                agent.controller.jump = True
            else:
                self.jumping = False

        if self.ceiling:
            agent.dbg_2d(f"Ceiling shot")

        delta_x = self.target - xf
        direction = delta_x.normalize() if not self.jumping else delta_x.flatten().normalize()

        agent.line(agent.me.location, agent.me.location + (direction * 250), agent.renderer.black)
        c_vf = vf + agent.me.location
        agent.line(c_vf - Vector(z=100), c_vf + Vector(z=100), agent.renderer.blue)
        agent.line(xf - Vector(z=100), xf + Vector(z=100), agent.renderer.red)
        agent.line(self.target - Vector(z=100), self.target + Vector(z=100), agent.renderer.green)

        
        if not self.dodging:
            target = delta_x if delta_x.magnitude() > 50 else self.shot_vector
            target = agent.me.local(target)

            if agent.controller.jump:
                defaultPD(agent, target.flatten(), up=agent.me.up)

            elif backboard_mode:
                # If the ball is below the car, invert to expose the
                # underside. If it is above the car, keep the roof facing it.
                ball_below_car = (
                    self.ball.z < agent.me.location.z - 80
                )

                defaultPD(
                    agent,
                    target,
                    upside_down=ball_below_car
                )

            elif virxrlcu.find_landing_plane(
                tuple(agent.me.location),
                tuple(agent.me.velocity),
                agent.gravity.z
            ) == 4:
                defaultPD(agent, target, upside_down=True)

            else:
                defaultPD(
                    agent,
                    target,
                    upside_down=self.shot_vector.z < 0
                )


        # only boost/throttle if we're facing the right direction
        if abs(agent.me.forward.dot(direction)) > 0.5 and T > 0:
            if T > 1 and not self.jumping: agent.controller.roll = 1 if self.shot_vector.z < 0 else -1
            # the change in velocity the bot needs to put it on an intercept course with the target
            delta_v = delta_x.dot(agent.me.forward) / T
            if agent.me.boost > 0 and delta_v >= agent.boost_accel * min_boost_time:
                agent.controller.boost = True
                delta_v -= agent.boost_accel * min_boost_time

            if delta_v >= throttle_accel * min_boost_time:
                agent.controller.throttle = cap(delta_v / (throttle_accel * min_boost_time), -1, 1)

        # Add a final powered contact phase. Once the car is behind the ball
        # and its nose is aligned with the planned goal direction, spend a
        # short boost burst to carry that momentum through the touch.
        if 0 < T <= 0.35 and agent.me.boost > 0:
            shot_direction = self.shot_vector.flatten().normalize()
            car_to_ball = (self.ball - agent.me.location).flatten().normalize()
            goal_alignment = agent.me.forward.flatten().normalize().dot(
                shot_direction
            )
            behind_alignment = car_to_ball.dot(shot_direction)

            if goal_alignment >= 0.78 and behind_alignment >= 0.70:
                agent.controller.boost = True
                if not self.final_boost_fired:
                    self.final_boost_fired = True
                    print(
                        f"[AERIAL FINAL BOOST] T={T:.2f} "
                        f"boost={agent.me.boost:.0f} "
                        f"goal_align={goal_alignment:.2f} "
                        f"behind_align={behind_alignment:.2f}",
                        flush=True
                    )

        if T <= -0.4 or (not self.jumping and T > 1.5 and not virxrlcu.aerial_shot_is_viable(T, agent.boost_accel, tuple(agent.gravity), agent.me.get_raw(agent), tuple(self.target))):
            agent.pop()
            agent.shooting = False
            agent.push(ball_recovery())
        elif (self.ceiling and self.target.dist(agent.me.location) < 92 + agent.me.hitbox.length and not agent.me.doublejumped and agent.me.location.z < agent.ball.location.z + 92 and self.target.y * side(agent.team) > -4240) or (not self.ceiling and not agent.me.doublejumped and T < 0.1):
            agent.dbg_2d("Flipping")
            local_target = agent.me.local_location(self.target).flatten().normalize()
            agent.controller.pitch = -local_target.x
            agent.controller.yaw = local_target.y
            agent.controller.jump = True

class half_flip:
    """
    Performs a proper backwards dodge followed by a dodge cancel.

    Unlike flip(..., cancel=True), this always starts with a true
    backwards dodge rather than using an arbitrary target vector.
    """
    def __init__(self):
        self.time = -1
        self.counter = 0

    def run(self, agent: VirxERLU):
        if self.time == -1:
            self.time = agent.time

        elapsed = agent.time - self.time

        # Initial jump
        if elapsed < 0.075:
            agent.controller.jump = True
            agent.controller.pitch = 1
            return

        # Release jump briefly so the dodge becomes available
        if self.counter < 3:
            agent.controller.jump = False
            self.counter += 1
            return

        # Backflip, then cancel it
        if elapsed < 0.20:
            agent.controller.jump = True
            agent.controller.pitch = 1
            return

        if elapsed < 0.40:
            agent.controller.jump = True
            agent.controller.pitch = -1
            return

        # Let recovery take over
        agent.pop()
        agent.push(recovery())
        return True


class half_flip_manager:
    """Single decision gate for shot and navigation half-flips."""

    @staticmethod
    def active(agent):
        return any(
            routine.__class__.__name__ == "half_flip"
            for routine in getattr(agent, "stack", ())
        )

    @classmethod
    def request_for_shot(cls, agent, shot):
        if agent.me.airborne or cls.active(agent):
            return False

        # A shot that has already committed to its jump/dodge must finish.
        if (
            getattr(shot, "jumping", False)
            or getattr(shot, "dodging", False)
        ):
            return False

        # Check the live stack too: main may be evaluating a fresh shot
        # candidate while an older shot routine is already mid-mechanic.
        for routine in getattr(agent, "stack", ()):
            if routine.__class__.__name__ not in {
                "jump_shot", "double_jump", "Aerial"
            }:
                continue

            if (
                getattr(routine, "jumping", False)
                or getattr(routine, "dodging", False)
                or getattr(routine, "counter", 0) >= 1
            ):
                return False

        needs_half_flip = getattr(shot, "needs_half_flip", None)
        if not callable(needs_half_flip) or not needs_half_flip(agent):
            return False

        # Require the actual ball to be behind the car, not merely the
        # computed shot approach point.
        local_ball = agent.me.local_location(agent.ball.location)
        distance = agent.me.location.flat_dist(agent.ball.location)
        forward_speed = agent.me.local_velocity().x

        if (
            local_ball.x >= -250
            or distance <= 700
            or forward_speed > 1000
        ):
            return False

        print(
            f"[HALF FLIP] Shot reposition "
            f"ball_x={local_ball.x:.0f} distance={distance:.0f} "
            f"forward_speed={forward_speed:.0f}",
            flush=True
        )
        agent.push(half_flip())
        return True

    @classmethod
    def request_for_navigation(
        cls, agent, angle_to_target, distance_remaining, forward_speed
    ):
        if agent.me.airborne or cls.active(agent):
            return False

        # Preserve goto's existing trigger, but route it through the same
        # lock so it cannot restart an already-running half-flip.
        if (
            angle_to_target <= 2.5
            or forward_speed >= -300
            or distance_remaining <= 600
        ):
            return False

        print(
            f"[HALF FLIP] Navigation reposition "
            f"angle={angle_to_target:.2f} "
            f"distance={distance_remaining:.0f} "
            f"forward_speed={forward_speed:.0f}",
            flush=True
        )
        agent.push(half_flip())
        return True


class kickoff_cheat:
    """Take a short, controlled cheat lane and hold until kickoff resolves."""

    def __init__(self):
        self.start_time = None
        self.arrived = False

    def run(self, agent: VirxERLU):
        if self.start_time is None:
            self.start_time = agent.time

        side_value = side(agent.team)
        centre = Vector(x=0, y=0, z=0)
        ball_from_centre = agent.ball.location.flat_dist(centre)
        ball_speed = agent.ball.velocity.magnitude()
        kickoff_resolved = ball_from_centre > 700 or ball_speed > 300
        timed_out = agent.time - self.start_time > 5.5

        if kickoff_resolved or timed_out:
            agent.kickoff_done = True
            agent.kickoff_routine_started = False
            agent.pop()
            return

        # Stay central and close enough to follow a dead/soft kickoff.
        target = Vector(x=0, y=-side_value * 1650, z=0)
        local_target = agent.me.local_location(target)
        distance = agent.me.location.flat_dist(target)

        agent.controller.boost = False
        if distance <= 180:
            self.arrived = True
            agent.controller.throttle = 0
            agent.controller.steer = 0
            agent.controller.handbrake = True
            agent.controller.boost = False
            return

        self.arrived = False
        defaultDrive(agent, min(1200, distance), local_target)
        agent.controller.boost = False


class flip:
    def __init__(self, vector, cancel=False):
        vector = vector.flatten().normalize()
        self.pitch = -vector.x
        self.yaw = vector.y
        self.cancel = cancel
        self.time = -1
        self.counter = 0
    def run(self, agent: VirxERLU, manual=False):
        if self.time == -1:
            elapsed = 0
            self.time = agent.time
        else:
            elapsed = agent.time - self.time

        if elapsed < 0.075:
            agent.controller.jump = True

        elif elapsed >= 0.075 and self.counter < 3:
            agent.controller.jump = False
            self.counter += 1

        elif elapsed < 0.4 or (not self.cancel and elapsed < 0.9):
            # The dodge begins here. Record it only once.
            if not getattr(self, "flip_started", False):
                agent.last_flip_time = agent.time
                self.flip_started = True

            agent.controller.jump = True
            agent.controller.pitch = self.pitch
            agent.controller.yaw = self.yaw

        else:
            if not manual:
                agent.pop()

            time_since_flip = agent.time - getattr(
                agent, "last_flip_time", -999.0
            )

            if time_since_flip >= 0.5:
                agent.push(recovery())

            return True


class brake:
    @staticmethod
    def run(agent: VirxERLU, manual=False):
        # current forward velocity
        speed = agent.me.local_velocity().x
        if abs(speed) > 100:
            # apply our throttle in the opposite direction
            agent.controller.throttle = -cap(speed / throttle_accel, -1, 1)
        elif not manual:
            agent.pop()


class goto:
    # Drives towards a designated (stationary) target
    # Optional vector controls where the car should be pointing upon reaching the target
    def __init__(self, target, vector=None, brake=False):
        self.target = target
        self.vector = vector
        self.brake = brake

        self.f_brake = False
        self.rule1_timer = -1
        # Wall-dash state
        self.wall_dash_active = False
        self.wall_dash_tick = 0
        self.wall_dash_lost_contact_time = -1
        self.allow_wall_dash = True
    def on_side_wall(self, agent):
        car = agent.me

        # The car must be close to a side wall.
        near_wall = abs(car.location.x) > 3750

        # On a side wall, the car's up direction points mostly
        # horizontally and toward the middle of the arena.
        wall_orientation = (
            abs(car.up.x) > 0.65
            and car.up.x * car.location.x < 0
        )

        return near_wall and wall_orientation
    def run(self, agent: VirxERLU, manual=False):
        car_to_target = self.target - agent.me.location
        distance_remaining = car_to_target.flatten().magnitude()

        agent.dbg_2d(f"Distance to target: {round(distance_remaining)}")
        agent.line(self.target - Vector(z=500), self.target + Vector(z=500), (255, 0, 255))

        if self.brake and (self.f_brake or distance_remaining * 0.95 < (agent.me.local_velocity().x ** 2 * -1) / (2 * brake_accel.x)):
            self.f_brake = True
            brake.run(agent, manual=manual)
            return

        if not self.brake and not manual and distance_remaining < 640:
            agent.pop()
            return

        final_target = self.target.copy().flatten()

        if self.vector is not None:
            # See comments for adjustment in jump_shot for explanation
            side_of_vector = sign(self.vector.cross(Vector(z=1)).dot(car_to_target))
            car_to_target_perp = car_to_target.cross(Vector(z=side_of_vector)).normalize()
            adjustment = car_to_target.angle2D(self.vector) * distance_remaining / 3.14
            final_target += car_to_target_perp * adjustment

        final_target = cap_in_field(agent, final_target)  # Some adjustment to the final target to ensure it's inside the field and we don't try to drive through any goalposts to reach it
        local_target = agent.me.local_location(final_target)
        angle_to_target = abs(Vector(x=1).angle2D(local_target))
        angle_to_target = abs(Vector(x=1).angle2D(local_target))
        agent.dbg_2d(f"Angle to target: {round(angle_to_target, 1)}")
        # Wall dash only when already driving on a side wall.
        
        # Start wall-dashing only when we're stably on a side wall,
        # moving reasonably quickly, and have a useful route ahead.
        on_side_wall = (
            not agent.me.airborne
            and abs(agent.me.location.x) > 3500
            and abs(agent.me.up.z) < 0.45
        )

        wall_speed = agent.me.velocity.flatten().magnitude()

        if (
            self.allow_wall_dash
            and on_side_wall
            and distance_remaining > 1800
            and angle_to_target < 0.65
            and wall_speed > 400
        ):
            print(
                f"[WALL DASH] ELIGIBLE "
                f"distance={distance_remaining:.0f} "
                f"angle={angle_to_target:.2f} "
                f"speed={wall_speed:.0f}",
                flush=True
            )

            return


        # Never deliberately reverse toward a positioning target.
        # If the target is behind us, turn around and then drive toward it.
        direction = 1

        velocity = defaultDrive(agent, 2300, local_target)[1]
        if distance_remaining < 1280: agent.controller.boost = False
        if velocity == 0: velocity = 1
        # Try a chain wall dash before considering ordinary ground flips.

        # this is to break rule 1's with TM8'S ONLY
        # 251 is the distance between center of the 2 longest cars in the game, with a bit extra
        if len(agent.friends) > 0 and agent.me.local_velocity().x < 50 and agent.controller.throttle == 1 and min(agent.me.location.flat_dist(car.location) for car in agent.friends) < 251:
            if self.rule1_timer == -1:
                self.rule1_timer = agent.time
            elif agent.time - self.rule1_timer > 1.5:
                agent.push(flip(Vector(y=250)))
                return
        elif self.rule1_timer != -1:
            self.rule1_timer = -1

        if agent.me.airborne:
            agent.push(recovery(self.target))
        elif agent.boost_amount != 'unlimited' and agent.me.boost < 60 and angle_to_target < 0.03 and velocity > 500 and distance_remaining / (velocity + dodge_impulse(agent)) > 1.25:
            agent.push(flip(agent.me.local_location(self.target)))
        elif half_flip_manager.request_for_navigation(
            agent,
            angle_to_target,
            distance_remaining,
            agent.me.local_velocity().x
        ):
            return


class shadow:
    def __init__(self):
        self.goto = goto(Vector(), brake=False)
        self.goto.allow_wall_dash = False

    def run(self, agent: VirxERLU):
        ball_loc = self.get_ball_loc(agent, True)
        target = self.get_target(agent, ball_loc)

        self_to_target = agent.me.location.flat_dist(target)

        if self_to_target < 100 * (agent.me.velocity.magnitude() / 500) and ball_loc.y < -640 and agent.me.velocity.magnitude() < 50 and abs(Vector(x=1).angle2D(agent.me.local_location(agent.ball.location))) > 1:
            agent.pop()
            if len(agent.friends) > 1:
                agent.push(face_target(ball=True))
        else:
            self.goto.target = target
            self.goto.vector = ball_loc * Vector(y=side(agent.team)) if target.y * side(agent.team) < 1280 else None
            if self_to_target < 240:
                brake.run(agent, manual=True)
            else:
                self.goto.run(agent, manual=True)

    def is_viable(self, agent):
        ball_loc = self.get_ball_loc(agent)
        target = self.get_target(agent, ball_loc)
        self_to_target = agent.me.location.flat_dist(target)

        # Stop shadowing before the target gets pinned near our goal.
        # The shadow target reaches its 4200-unit clamp at ball depth 1640.
        if ball_loc.y > 1500:
            return False

        return self_to_target > 320
    def get_ball_loc(self, agent, render=False):
        slices = agent.ball_prediction_struct.slices
        if not slices:
            return Vector(agent.ball.location.x, agent.ball.location.y * side(agent.team))
        index = max(0, min(len(slices) - 1, round(agent.future_ball_location_slice * 1.1)))
        ball_slice = slices[index].physics.location
        ball_loc = Vector(ball_slice.x, ball_slice.y)
        if render: agent.sphere(ball_loc + Vector(z=93), 92.75, color=agent.renderer.black)
        ball_loc.y *= side(agent.team)

        if ball_loc.y < -2560 or (ball_loc.y < agent.ball.location.y * side(agent.team)):
            ball_loc = Vector(agent.ball.location.x, agent.ball.location.y * side(agent.team) + 640)

        return ball_loc
    

    def get_target(self, agent: VirxERLU, ball_loc=None):
        if ball_loc is None:
            ball_loc = self.get_ball_loc(agent)

        distance = 2560

        target = Vector(y=(ball_loc.y + distance) * side(agent.team))
        if target.y * side(agent.team) > -1280:
            # use linear algebra to find the proper x coord for us to stop a shot going to the net
            # y = mx + b <- yes, finally! 7th grade math is paying off xD
            p1 = agent.friend_goal.location.flatten()
            p2 = ball_loc * Vector(x=1, y=side(agent.team))
            try:
                m = (p2.y - p1.y) / (p2.x - p1.x)
                b = p1.y - (m * p1.x)
                # x = (y - b) / m
                target.x = (target.y - b) / m
            except ZeroDivisionError:
                target.x = 0
        else:
            target.x = (abs(ball_loc.x) + 320) * sign(ball_loc.x)

        # Defensive shadowing should stay in the central field area.
        # Leave wall routes available to dedicated attacking routines.
        
        # Shadow targets must remain in the playable field.
        # In team-relative coordinates, positive Y points toward
        # our own goal. Never send ordinary shadowing into the net.
        side_value = side(agent.team)

        target_depth = target.y * side_value
        # Shadowing is a ground rotation, never a wall route. Keep it well
        # inside the playable floor and out of the goal/net and side walls.
        target_depth = max(-3300, min(4200, target_depth))

        target.x = max(-2250, min(2250, target.x))
        target.y = target_depth * side_value

        return Vector(target.x, target.y)

    
class support:
    """Stable second-man positioning with a useful follow-up lane.

    The target is based on the most advanced available teammate, not just
    the ball. This keeps the support player behind the play and avoids both
    teammates converging on the same point.
    """

    def __init__(self):
        self.goto = goto(Vector(), brake=False)
        self.last_target = None

    def get_target(self, agent):
        side_value = side(agent.team)
        ball = agent.ball.location
        ball_x = ball.x
        ball_y = ball.y * side_value

        # Pick the teammate furthest forward in team-relative coordinates.
        # Ignore demolished teammates where that state is exposed.
        available = []
        for friend in getattr(agent, "friends", []):
            if getattr(friend, "demolished", False):
                continue
            friend_y = friend.location.y * side_value
            available.append((friend_y, friend))

        my_y = agent.me.location.y * side_value
        ahead = [item for item in available if item[0] < my_y - 250]
        lead = min(ahead, key=lambda item: item[0])[1] if ahead else None

        if lead is not None:
            lead_x = lead.location.x
            lead_y = lead.location.y * side_value
            # 2v2 support stays closer; 3v3 leaves a little more room.
            support_gap = 900 if len(agent.friends) <= 1 else 1150
            target_x = lead_x * 0.58 + ball_x * 0.42
            target_y = lead_y + support_gap

            # Do not sit excessively deep when the lead is already advanced.
            target_y = min(target_y, ball_y + 1450)
            # Nor drive beyond the ball to chase the same play.
            target_y = max(target_y, ball_y + 350)
        else:
            # No teammate clearly ahead: support the ball from a central,
            # goal-side lane rather than blindly following its x coordinate.
            if ball_y < -2500:
                target_x = ball_x * 0.22
                target_y = ball_y + 1150
            elif ball_y < 640:
                target_x = ball_x * 0.32
                target_y = ball_y + 900
            else:
                target_x = ball_x * 0.42
                target_y = ball_y + 700

        # When the ball enters our half, the support player becomes a wide
        # outlet/second defender. It deliberately stays on a sideline lane
        # instead of joining the anchor in front of goal.
        if ball_y > 900:
            lane = 1 if agent.me.index % 2 == 0 else -1
            target_x = lane * (2250 if ball_y > 2600 else 1900)
            target_y = max(-500, ball_y - (850 if ball_y > 2600 else 650))

        target_y = max(-4300, min(4100, target_y))
        target_x = max(-2550, min(2550, target_x))
        target = Vector(target_x, target_y * side_value, 0)

        # Mild target smoothing prevents tiny teammate/ball changes from
        # making the support route twitch every packet.
        if self.last_target is not None:
            shift = target - self.last_target
            if shift.magnitude() < 500:
                target = self.last_target + shift * 0.35
        self.last_target = target
        return target

    def get_support_pad(self, agent, support_target):
        if agent.me.boost >= 30:
            return None

        candidates = [
            boost for boost in agent.boosts
            if boost.active
            and not boost.large
            and boost.location.flat_dist(agent.me.location) < 750
            and boost.location.flat_dist(support_target) < 550
        ]
        if not candidates:
            return None
        return min(candidates, key=lambda boost: boost.location.flat_dist(agent.me.location))

    def run(self, agent: VirxERLU):
        target = self.get_target(agent)
        pad = self.get_support_pad(agent, target)
        if pad is not None:
            target = pad.location

        self.goto.target = target
        self.goto.vector = agent.ball.location
        self.goto.brake = False
        self.goto.run(agent, manual=True)

    def is_viable(self, agent):
        return agent.me.location.flat_dist(self.get_target(agent)) > 300


class grid_defense:
    """
    Grid's ground defensive movement, adapted to the VirxERLU routine API.

    goalie=True holds the central goal-side lane. goalie=False preserves
    Grid's rotating non-goalie transition into its prepare-for-attack lane.
    """

    def __init__(self, goalie=False, fast=False):
        self.goalie = goalie
        self.fast = fast
        self.prev_front = None

    @staticmethod
    def _angle(a, b):
        a_length = a.magnitude()
        b_length = b.magnitude()
        if a_length < 1 or b_length < 1:
            return math.pi / 2
        return math.acos(cap(a.normalize().dot(b.normalize()), -1, 1))

    @staticmethod
    def _steer(agent, target):
        local = agent.me.local_location(target)
        return cap(math.atan2(local.y, local.x) * 5, -1, 1)

    def _raw_physics(self, agent):
        try:
            return agent.me.get_raw(agent).physics
        except (AttributeError, TypeError):
            return None

    def _roll(self, agent):
        physics = self._raw_physics(agent)
        if physics is None:
            return 0.0
        return physics.rotation.roll

    def _angular_speed(self, agent):
        physics = self._raw_physics(agent)
        if physics is None:
            return 0.0
        angular = physics.angular_velocity
        return math.sqrt(
            angular.x * angular.x
            + angular.y * angular.y
            + angular.z * angular.z
        )

    def _choose_pad(self, agent, goal_location, car_location):
        if agent.me.boost >= 100 or self.fast:
            return None

        candidates = []
        car_goal_distance = car_location.dist(-goal_location)

        for boost in agent.boosts:
            pad = boost.location
            if not (
                abs(pad.x) > 3000 or abs(pad.y) > 4000
            ):
                continue
            if pad.dist(-goal_location) >= car_goal_distance:
                continue
            if sign(pad.x) != sign(car_location.x):
                continue

            pad_distance = pad.dist(car_location)
            active = getattr(boost, "active", False)
            respawn_time = getattr(boost, "timer", None)
            if not active and (
                respawn_time is None or respawn_time > pad_distance / 2300
            ):
                continue

            score = pad_distance + pad.dist(-goal_location)
            candidates.append((not boost.large, score, boost))

        if not candidates:
            return None

        # Grid prefers a full boost pad whenever one is reachable.
        candidates.sort(key=lambda item: (item[0], item[1]))
        return candidates[0][2]

    def _prepare_for_attack(self, agent, side_value, goal_location):
        car_location = agent.me.location
        car_velocity = agent.me.velocity
        front = agent.me.forward
        ball = agent.ball.location

        target = Vector(x=4000 * side_value, y=0, z=0)
        direction = target + goal_location
        distance = (
            target.dist(-goal_location) / 5120
            * max(min(ball.y * goal_location.y + 1000, 5120), 1000)
        )
        if direction.magnitude() > 1:
            target = -goal_location + direction.normalize() * distance

        target_distance = target.dist(car_location.flatten())
        if car_location.flatten().dist(target) <= 100:
            throttle_value = (
                -sign(math.pi / 2 - self._angle(car_velocity, front))
                * car_velocity.magnitude() ** 2 / 6000
                + sign(math.pi / 2 - self._angle(
                    target - car_location, front
                )) * target.dist(car_location.flatten())
            )
            agent.controller.throttle = sign(throttle_value) or 1
        else:
            agent.controller.throttle = sign(
                target_distance - car_velocity.magnitude() ** 2 / 6000
            )

        angular_speed = self._angular_speed(agent)
        previous_front = self.prev_front if self.prev_front is not None else front
        agent.controller.handbrake = (
            self._angle(car_velocity, front) <= math.pi / 4
            and self._angle(front, target - car_location.flatten()) > math.pi / 4
            and angular_speed >= min(car_velocity.magnitude() / 500, 2)
            and self._angle(target - car_location.flatten(), front)
                < self._angle(target - car_location.flatten(), previous_front)
        )
        agent.controller.steer = self._steer(agent, target)
        agent.controller.boost = False

    def _run_defense(self, agent, goalie, fast):
        car = agent.me
        car_location = car.location
        car_velocity = car.velocity
        front = car.forward
        ball_location = agent.ball.location
        goal_location = agent.foe_goal.location
        goal_sign = sign(goal_location.y) or 1

        best_pad = self._choose_pad(
            agent, goal_location, car_location
        )

        if best_pad is not None:
            target = best_pad.location
        elif goalie:
            target = Vector(
                x=0,
                y=-goal_location.y - goal_sign * 150,
                z=0
            )
        else:
            target = Vector(
                x=sign(car_location.x) * 900,
                y=-goal_sign * 5050,
                z=0
            )

        agent.controller.boost = False
        agent.controller.handbrake = False

        if car_location.dist(-goal_location) <= 1500:
            car_depth = car_location.y * goal_sign

            if (
                car_velocity.magnitude() <= 100
                and -5320 + 200 * (not goalie) > car_depth
                and self._angle(front, target - car_location) > math.pi / 4
            ):
                agent.controller.handbrake = True
                agent.controller.throttle = -sign(
                    math.pi / 2 - self._angle(front, car_velocity)
                )
                agent.controller.steer = (
                    self._steer(agent, target)
                    * agent.controller.throttle
                )

            elif (
                car_velocity.magnitude() <= 100
                and -5320 + 200 * (not goalie)
                    <= car_depth
                    <= -5120 + 100 * (not goalie)
                and self._angle(front, ball_location - car_location) >= 0.2
            ):
                agent.controller.handbrake = True
                agent.controller.throttle = -sign(
                    math.pi / 2 - self._angle(front, car_velocity)
                )

                if goalie:
                    ball_lane = (
                        ball_location.flatten()
                        - Vector(x=cap(ball_location.x, -900, 900))
                        + goal_location
                    )
                    if self._angle(ball_lane, goal_location) <= math.pi / 3:
                        steer_target = ball_location
                    else:
                        steer_target = (
                            -goal_location
                            + Vector(
                                x=ball_location.x,
                                y=(
                                    sign(ball_location.y + goal_location.y)
                                    / math.tan(math.pi / 3)
                                    * (abs(ball_location.x) - 900)
                                ),
                                z=0
                            )
                        )
                else:
                    steer_target = Vector(
                        x=0, y=car_location.y, z=0
                    )

                agent.controller.steer = (
                    self._steer(agent, steer_target)
                    * agent.controller.throttle
                )

            else:
                throttle_value = (
                    -sign(
                        math.pi / 2 - self._angle(car_velocity, front)
                    ) * car_velocity.magnitude() ** 2 / 6000
                    + sign(
                        math.pi / 2 - self._angle(
                            target - car_location, front
                        )
                    ) * target.dist(car_location)
                )
                agent.controller.throttle = sign(throttle_value) or 1
                agent.controller.steer = self._steer(agent, target)

                # Grid's non-goalie understeer check: reverse rather than
                # carry momentum across the intended defensive lane.
                if not goalie and car_velocity.flatten().magnitude() > 100:
                    own_lane = Vector(
                        x=sign(car_location.x) * 900,
                        y=-goal_sign * 5050,
                        z=0
                    )
                    opposite_lane = Vector(
                        x=-sign(car_location.x) * 900,
                        y=-goal_sign * 5050,
                        z=0
                    )
                    lane_distance = (
                        target - car_location
                    ).flatten().magnitude()
                    threshold = min(
                        math.asin(min(25000 / 11 * lane_distance, 1)) * 2,
                        1
                    )
                    angle_current = self._angle(
                        (own_lane - car_location).flatten(),
                        car_velocity.flatten()
                    )
                    angle_opposite = self._angle(
                        (opposite_lane - car_location).flatten(),
                        car_velocity.flatten()
                    )
                    if angle_current > threshold < angle_opposite:
                        agent.controller.throttle = -sign(
                            math.pi / 2 - self._angle(
                                car_velocity, front
                            )
                        )

        else:
            speed = car_velocity.flatten().magnitude()
            previous_front = (
                self.prev_front if self.prev_front is not None else front
            )
            agent.controller.throttle = 1
            agent.controller.handbrake = (
                speed < 1000
                and self._angle(car_velocity, front) <= math.pi / 4
                and self._angle(front, target - car_location) > math.pi / 4
                and self._angular_speed(agent) >= min(speed / 500, 2)
                and self._angle(target - car_location, front)
                    < self._angle(target - car_location, previous_front)
            )
            agent.controller.boost = (
                best_pad is not None
                and best_pad.large
                and not car.airborne
                and not agent.controller.handbrake
            )

            if not car.airborne and abs(self._roll(agent)) > 0.2:
                target = car_location.flatten()

            agent.controller.steer = self._steer(agent, target)

            flip_distance = (
                speed * 1.4 + 500 * 1.5 + speed ** 2 / 7000
            )
            should_flip = (
                not car.airborne
                and abs(agent.controller.steer) <= 0.01
                and speed >= 1000
                and (
                    car_location.flatten().dist(target.flatten())
                    >= flip_distance
                    or (
                        best_pad is not None
                        and best_pad.large
                        and abs(
                            car_location.y
                            + front.y * flip_distance
                        ) < 5000
                    )
                )
            )
            if should_flip:
                agent.push(flip(Vector(x=1)))
                self.prev_front = front
                return

        self.prev_front = front

        # Grid recovers when falling after the flip lockout. Use Volt's
        # existing recovery routine to preserve VirxERLU's landing control.
        time_since_flip = (
            agent.time - getattr(agent, "last_flip_time", -999.0)
        )
        if (
            car.airborne
            and time_since_flip > 78 / 120
            and car_velocity.z < -10
        ):
            agent.push(recovery(target))

    def run(self, agent: VirxERLU):
        side_value = side(agent.team)
        goal_location = agent.foe_goal.location
        ball = agent.ball.location
        car = agent.me

        agent.controller.boost = False
        agent.controller.handbrake = False

        # Match Grid's original prepare_for_attack transition exactly.
        # goal_location points toward the opponent goal, while side_value
        # is positive toward our own goal, so the signs are opposite.
        ball_depth = ball.y * side_value
        car_depth = car.location.y * side_value
        should_prepare = (
            not self.goalie
            and ball_depth < 0
            and car_depth >= -900
            and (
                car.forward.y * side_value < 0
                or car_depth > 4120
            )
        )

        if should_prepare:
            nearest_opponent = None
            nearest_distance = float("inf")
            for foe in agent.foes:
                distance = foe.location.dist(ball)
                if distance < nearest_distance:
                    nearest_distance = distance
                    nearest_opponent = foe

            if nearest_opponent is not None:
                lane_side = sign(
                    ball.x - nearest_opponent.location.x
                ) * 0.5
            else:
                lane_side = 0

            self._prepare_for_attack(
                agent, lane_side, goal_location
            )
            self.prev_front = car.forward
            return

        self._run_defense(agent, self.goalie, self.fast)


class fast_intercept_finder:
    """
    Earliest-reachable prediction-slice search.

    Unlike VirxERLU's general finder, this checks every prediction slice
    from the requested time onward instead of starting six slices ahead
    and skipping slices. Used for urgent saves and the shallow own-half
    fast-intercept zone.
    """

    def find(self, agent: VirxERLU, earliest_time=None, cap_=6.0):
        prediction = getattr(agent, "ball_prediction_struct", None)
        slices = getattr(prediction, "slices", None) if prediction is not None else None
        if not slices:
            return None

        me = agent.me.get_raw(agent)
        game_info = (agent.boost_accel, getattr(agent, "ball_radius", 91.25))
        gravity = tuple(agent.gravity)

        is_on_ground = not agent.me.airborne
        can_ground = is_on_ground
        can_jump = is_on_ground
        can_double_jump = is_on_ground
        land_time = getattr(agent.me, "land_time", agent.time - 1.0)
        can_aerial = (
            not is_on_ground
            or agent.time - land_time > 0.5
        )

        if not (
            can_ground or can_jump or can_double_jump or can_aerial
        ):
            return None

        first_time = max(
            agent.time + (1 / 120),
            earliest_time if earliest_time is not None else agent.time
        )
        end_time = min(
            agent.time + cap_,
            slices[-1].game_seconds
        )

        for ball_slice in slices:
            intercept_time = ball_slice.game_seconds

            if intercept_time < first_time:
                continue
            if intercept_time > end_time:
                break

            T = intercept_time - agent.time - (1 / 120)
            if T <= 0:
                continue

            physics = ball_slice.physics
            location = physics.location

            if abs(location.y) > 5212.75:
                break

            ball_info = (
                (location.x, location.y, location.z),
                (
                    physics.velocity.x,
                    physics.velocity.y,
                    physics.velocity.z
                )
            )

            result = virxrlcu.parse_slice_for_shot(
                can_ground,
                can_jump,
                can_double_jump,
                can_aerial,
                T,
                *game_info,
                gravity,
                ball_info,
                me
            )

            if result.get("found") != 1:
                continue

            shot_type = int(result["shot_type"])

            if shot_type == 3:
                return Aerial(
                    intercept_time,
                    fast_aerial=bool(result.get("fast", True))
                )

            constructors = {
                0: ground_shot,
                1: jump_shot,
                2: double_jump
            }
            constructor = constructors.get(shot_type)
            if constructor is not None:
                return constructor(intercept_time)

        return None


