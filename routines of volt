        # PHASE 0
        # Accelerate toward the ball until 800 speed.
        # =========================================================
        if self.phase == 0:
            local_ball = agent.me.local_location(agent.ball.location)

            defaultPD(agent, local_ball)

            agent.controller.throttle = 1
            agent.controller.boost = True

            # Prevent a held jump input from carrying into kickoff.
            agent.controller.jump = False

            speed = agent.me.velocity.magnitude()
            distance = agent.me.location.flat_dist(agent.ball.location)

            # Only start the speedflip once the car has built speed
            # and the ball is at a suitable distance.
            if speed > 800 and distance > 1800:
                right_handed = agent.me.location.x > 0

                self.phase = 1

                agent.push(
                    speed_flip(
                        right_handed=right_handed,
                        use_boost=True
                    )
                )
            return


        # =========================================================
        # PHASE 1
        #
        # speed_flip is currently on top of the stack.
        #
        # When it finishes, it pops itself and this routine
        # resumes here.
        # =========================================================

        if self.phase == 1:

            # We only get here once speed_flip has popped.
            if not agent.me.airborne:

                self.phase = 2

            return

        # =========================================================
        # PHASE 2
        # Drive toward the ball.
        # =========================================================

        if self.phase == 2:

            local_ball = agent.me.local_location(agent.ball.location)

            defaultPD(agent, local_ball)

            agent.controller.throttle = 1

            speed = agent.me.velocity.magnitude()

            if speed < 2290:
                agent.controller.boost = True

            distance = agent.me.location.flat_dist(
                agent.ball.location
            )

            # Get close enough to perform the actual hit.
            if distance < 1000:

                self.phase = 3
            
                
                local_ball = agent.me.local_location(agent.ball.location)

                defaultPD(agent, local_ball)

                agent.controller.throttle = 1
                agent.controller.boost = True

                speed = agent.me.velocity.magnitude()
                return

    
            return

        
        # =========================================================
        # PHASE 3
        # Speedflip is finished. Drive into the ball until contact.
        # =========================================================

        if self.phase == 3:
            ball = agent.ball.location
            ball_velocity = agent.ball.velocity

            # Record the ball's state when Phase 3 begins.
            if self.phase3_start_time == -1:
                self.phase3_start_time = agent.time
                self.phase3_start_ball = Vector(
                    x=ball.x, y=ball.y, z=ball.z
                )
                self.phase3_start_velocity = Vector(
                    x=ball_velocity.x,
                    y=ball_velocity.y,
                    z=ball_velocity.z
                )

                # Start the dodge sequence.
                self.phase3_flip_start = agent.time
                self.phase3_flip_direction = 1

            local_ball = agent.me.local_location(ball)
            distance = agent.me.location.flat_dist(ball)

            # Face the ball's direction before flipping.
            defaultPD(agent, local_ball)
            agent.controller.throttle = 1
            agent.controller.boost = (
                agent.me.boost > 0
                and abs(Vector(x=1).angle2D(local_ball)) < 0.35
            )

            # Dodge sequence: jump, release, then forward dodge.
            flip_time = agent.time - self.phase3_flip_start

            if flip_time < 1 / 60:
                agent.controller.jump = True
                agent.controller.pitch = 0
            elif flip_time < 4 / 60:
                agent.controller.jump = False
                agent.controller.pitch = 0
            elif flip_time < 5 / 60:
                agent.controller.jump = True
                agent.controller.pitch = -1
            else:
                agent.controller.jump = False
                agent.controller.pitch = 0

            # Detect a likely hit using the ball's change in motion.
            ball_displacement = (
                ball - self.phase3_start_ball
            ).magnitude()

            velocity_change = (
                ball_velocity - self.phase3_start_velocity
            ).magnitude()

            likely_contact = (
                (ball_displacement > 100 and velocity_change > 250)
                or velocity_change > 500
            )

            if likely_contact:
                agent.kickoff_done = True
                agent.kickoff_routine_started = False
                agent.pop()
                return

            # Safety timeout if the bot misses.
            if agent.time - self.phase3_start_time > 2.0:
                agent.kickoff_done = True
                agent.kickoff_routine_started = False
                agent.pop()
