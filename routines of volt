        self.goto.run(agent, manual=True)


class kickoff_boost:
    """Collect the back-corner boost without abandoning kickoff awareness."""

    def __init__(self):
        self.start_time = None
        self.boost = None
        self.goto = None
        self.arrived = False

    def _choose_boost(self, agent):
        side_value = side(agent.team)
        candidates = [
            boost for boost in agent.boosts
            if boost.active and boost.large
            and boost.location.y * side_value > 1800
            and abs(boost.location.x) > 2200
        ]
        if not candidates:
            candidates = [
                boost for boost in agent.boosts
                if boost.active and boost.large
                and boost.location.y * side_value > 1000
            ]
        if not candidates:
            return None
        return min(candidates, key=lambda b: b.location.flat_dist(agent.me.location))

    def run(self, agent: VirxERLU):
        if self.start_time is None:
            self.start_time = agent.time
            self.boost = self._choose_boost(agent)
            if self.boost is not None:
                self.goto = goto(self.boost.location)

        ball_moved = (
            agent.ball.location.flat_dist(Vector()) > 700
            or agent.ball.velocity.magnitude() > 300
        )
        timed_out = agent.time - self.start_time > 5.5
        if ball_moved or timed_out:
            agent.kickoff_done = True
            agent.kickoff_routine_started = False
            agent.pop()
            return

        agent.controller.boost = False
        if self.boost is None or not self.boost.active:
            agent.controller.throttle = 0
            agent.controller.steer = 0
            return

        distance = agent.me.location.flat_dist(self.boost.location)
        if distance <= 180:
            self.arrived = True
            agent.controller.throttle = 0
            agent.controller.steer = 0
            agent.controller.handbrake = True
            agent.controller.boost = False
            return

        self.goto.target = self.boost.location
        self.goto.vector = None
        self.goto.brake = True
        self.goto.run(agent, manual=True)
        agent.controller.boost = False


class shot_patience:
    """
    Grid-inspired shot timing adjustment.

    If the selected contact is a poor backboard/goal alignment while the ball
    is travelling toward the middle, or the ball is high and already falling,
    move the contact time to the first later prediction slice with a better
    contact window. Apply once per routine so the target cannot drift forever.
    """

    def __init__(self):
        self.applied = False

    def adjust(self, agent, intercept_time, targets=None):
        if self.applied:
            return intercept_time

        prediction = getattr(agent, "ball_prediction_struct", None)
        slices = getattr(prediction, "slices", None) if prediction is not None else None
        if not slices:
            return intercept_time

        current_time = max(0.0, intercept_time - agent.time)
        start = max(0, min(round(current_time * 120) - 1, len(slices) - 1))
        if start >= len(slices) - 1:
            return intercept_time

        current = slices[start]
        current_pos = current.physics.location
        current_vel = current.physics.velocity

        goal_y = agent.foe_goal.location.y
        x = current_pos.x
        alignment_wait = (
            abs(x) < 3000
            and abs(x) - 890 + 92.75 * math.sqrt(2)
                > abs(current_pos.y - goal_y)
            and current_vel.x * sign(x) < 0
        )
        falling_wait = current_pos.z > 180 and current_vel.z < -80

        if not alignment_wait and not falling_wait:
            return intercept_time

        speed = agent.me.velocity.flatten().magnitude()
        estimated_speed = max(1000.0, min(2300.0, speed + 650.0))
        max_index = min(len(slices) - 1, 600)

        for i in range(start + 1, max_index + 1):
            future = slices[i]
            pos = future.physics.location
            vel = future.physics.velocity
            future_time = (i + 1) / 120
            if future_time <= current_time + 0.15:
                continue

            # Do not select a later contact the car cannot plausibly reach.
            distance = agent.me.location.flat_dist(Vector(pos.x, pos.y, pos.z))
            if distance / estimated_speed > future_time + 0.15:
                continue

            aligned = (
                alignment_wait
                and abs(pos.x) - 890 + 92.75 * math.sqrt(2)
                    <= abs(pos.y - goal_y)
            )
            fallen = falling_wait and pos.z <= 180 and vel.z <= 80

            if aligned or fallen:
                self.applied = True
                reason = "goal_alignment" if aligned else "falling_ball"
                new_time = agent.time + future_time
                print(
                    f"[SHOT PATIENCE] reason={reason} "
                    f"old_T={current_time:.2f} new_T={future_time:.2f} "
                    f"ball=({pos.x:.0f},{pos.y:.0f},{pos.z:.0f})",
                    flush=True
                )
                return new_time

        return intercept_time


class jump_shot:
    # Hits a target point at a target time towards a target direction
    def __init__(self, intercept_time, targets=None):
        self.ball_location = None
        self.shot_vector = None
        self.offset_target = None
        self.intercept_time = intercept_time
        self.targets = targets
        self.goal_aim_point = None
        # Flags for what part of the routine we are in
        self.jumping = False
        self.dodging = False
        self.counter = 0
        self.jump_time = -1
        self.needed_jump_time = -1
        self._orientation_logged = False
        self.quick_shot = False
        self.side_mode = False
        self.last_side_debug_time = -1
        self.patience = shot_patience()

    def update(self, shot):
        self.intercept_time = shot.intercept_time
        self.targets = shot.targets
    def needs_half_flip(self, agent):
        if self.targets is None:
            return False

        if self.intercept_time <= agent.time:
            return False

        ball_slice = _safe_prediction_slice(
            agent, self.intercept_time - agent.time
        )
        if ball_slice is None:
            return False

        ball = ball_slice.physics.location
        ball_location = Vector(ball.x, ball.y, ball.z)

        direction = (ball_location - agent.me.location).normalize()

        if self.goal_aim_point is None:
            self.goal_aim_point = _relative_goal_aim_point(agent, self.targets)
        shot_vector = (
            self.goal_aim_point - ball_location
        ).flatten().normalize()

        offset_target = ball_location - shot_vector * agent.best_shot_value

        local_target = agent.me.local_location(offset_target)

        return local_target.x < 0


    def run(self, agent: VirxERLU):
        print(
            f"[JUMP SHOT RUN] id={id(self)} "
            f"T={self.intercept_time - agent.time:.3f} "
            f"jumping={self.jumping} counter={self.counter} "
            f"boost={agent.me.boost:.0f}",
            flush=True
        )
        if not agent.shooting:
            agent.shooting = True

        self.intercept_time = self.patience.adjust(
            agent, self.intercept_time, self.targets
        )
        T = self.intercept_time - agent.time
        # Capping T above 0 to prevent division problems
        time_remaining = cap(T, 0.000001, 6)

        if not self.jumping or self.ball_location is None:
            prediction = getattr(agent, "ball_prediction_struct", None)
            slices = getattr(prediction, "slices", None) if prediction is not None else None

            if not slices:
                agent.pop()
                agent.shooting = False
                agent.shot_weight = -1
                agent.shot_time = -1
                if agent.me.airborne:
                    agent.push(recovery())
                return

            slice_n = round(T * 120) - 1
            slice_n = max(0, min(slice_n, len(slices) - 1))

            agent.dbg_2d(f"Shot slice #: {slice_n}")

            ball = slices[slice_n].physics.location
            self.ball_location = Vector(ball.x, ball.y, ball.z)

            self.needed_jump_time = virxrlcu.get_jump_time(
                ball.z - agent.me.location.z,
                agent.me.velocity.z,
                agent.gravity.z
            )

        # Always aim the contact toward the opponent's goal.
        # Never use car-to-ball direction as the shot direction:
        # that can put the approach point on the wrong side of the ball.
        if self.goal_aim_point is None:
            self.goal_aim_point = _relative_goal_aim_point(agent, self.targets)
        target_center = self.goal_aim_point

        self.shot_vector = (
            target_center - self.ball_location
        ).flatten().normalize()

        # Approach from behind the ball relative to the opponent's goal.
        self.offset_target = (
            self.ball_location
            - self.shot_vector * agent.best_shot_value
        )
        contact_label = getattr(self, "contact_label", None)
        refreshed_contact = _contact_approach_from_label(
            self.ball_location,
            self.shot_vector,
            contact_label,
            agent.best_shot_value
        )
        if refreshed_contact is not None:
            self.offset_target = refreshed_contact
            self.contact_point = (
                self.ball_location
                + (refreshed_contact - self.ball_location).normalize() * 92.75
            )
            self.contact_approach_target = refreshed_contact.copy()
            print(
                f"[JUMP CONTACT REFRESH] {contact_label} "
                f"point={self.contact_point} approach={self.offset_target}",
                flush=True
            )

        if self.side_mode:
            # Rebuild the lateral setup from the latest predicted intercept
            # every frame. The car approaches from the side opposite the goal.
            left_of_shot = Vector(
                -self.shot_vector.y,
                self.shot_vector.x,
                0
            ).normalize()
            if self.side_lateral_distance is None:
                intercept_length = agent.me.location.flat_dist(
                    self.ball_location
                )
                self.side_lateral_distance = intercept_length * 0.5
            lateral_distance = self.side_lateral_distance
            side_sign = 1 if self.approach_side == "right" else -1
            self.offset_target = (
                self.ball_location
                - left_of_shot * lateral_distance * side_sign
            )
            self.contact_point = (
                self.ball_location
                - left_of_shot * 92.75 * side_sign
            )
            self.contact_approach_target = self.offset_target.copy()
            if (
                self.last_side_debug_time < 0
                or agent.time - self.last_side_debug_time >= 0.35
            ):
                self.last_side_debug_time = agent.time
                print(
                    f"[SIDE SHOT SETUP] intercept_distance={intercept_length:.0f} "
                    f"lateral_distance={lateral_distance:.0f} "
                    f"ball=({self.ball_location.x:.0f},{self.ball_location.y:.0f}) "
                    f"setup=({self.offset_target.x:.0f},{self.offset_target.y:.0f})",
                    flush=True
                )

        print(
            f"[JUMP SHOT AIM FIX] "
            f"ball=({self.ball_location.x:.0f},{self.ball_location.y:.0f}) "
            f"target=({target_center.x:.0f},{target_center.y:.0f}) "
            f"shot_dir=({self.shot_vector.x:.2f},{self.shot_vector.y:.2f}) "
            f"offset=({self.offset_target.x:.0f},{self.offset_target.y:.0f})",
            flush=True
        )
        agent.sphere(self.ball_location, 92.75)

        car_to_ball = self.ball_location - agent.me.location
        final_target = self.offset_target.copy().flatten()
        Tj = T - self.needed_jump_time * 1.15
        agent.dbg_2d(f"Needed jump time: {round(self.needed_jump_time, 2)}")

        if Tj > 0 and self.targets is not None and not self.side_mode:
            # Normal jump shots may use the generic flank route. A side shot
            # must preserve its deliberately selected lateral setup point.
            final_target = _shot_approach_target(
                agent, self.ball_location, final_target, self.shot_vector, Tj
            )

        distance_remaining = final_target.flat_dist(agent.me.location)

        # Some adjustment to the final target to ensure it's inside the field and we don't try to drive through any goalposts or walls to reach it (again)
        final_target = cap_in_field(agent, final_target)
        local_final_target = agent.me.local_location(final_target)

        # whether we should go forwards or backwards
        angle_to_target = abs(Vector(x=1).angle2D(local_final_target))
        direction = 1

        # drawing debug lines to show the dodge point and final target (which differs due to the adjustment)
        agent.line(agent.me.location, self.offset_target, agent.renderer.white)
        agent.line(self.offset_target-Vector(z=100), self.offset_target+Vector(z=100), agent.renderer.green)
        agent.line(final_target-Vector(z=100), final_target+Vector(z=100), agent.renderer.purple)

        vf = agent.me.velocity + agent.gravity * T

        distance_remaining = agent.me.local_location(self.offset_target).x if agent.me.airborne else distance_remaining
        distance_remaining -= agent.me.hitbox.length / 3
        speed_required = distance_remaining / time_remaining
        agent.dbg_2d(f"Speed required: {round(speed_required, 2)}")

        ball_speed_toward_shot = agent.ball.velocity.dot(self.shot_vector)

        if (
            speed_required < 1900
            and agent.me.boost > 50
            and T > 2
            and distance_remaining > 2560
            and ball_speed_toward_shot > 1000    
        ):
            agent.dbg_2d(
                f"Building speed | Ball speed toward shot: {round(ball_speed_toward_shot)}"
            )
            speed_required *= 0.75

        if not self.jumping:
            agent.dbg_2d(f"jump time: {self.needed_jump_time}")
            print(
                f"[SHOT APPROACH] "
                f"boost={agent.me.boost:.0f} "
                f"T={T:.2f} "
                f"ball_speed={agent.ball.velocity.flatten().magnitude():.0f} "
                f"ball_x={agent.me.local_location(agent.ball.location).x:.0f} "
                f"jumping={self.jumping} "
                f"counter={self.counter} "
                f"jump_time={self.needed_jump_time:.2f}",
                flush=True
            )

            # Normal driving still uses the predicted ball timing so we don't arrive
            # too early. However, once we're committed to a forward power dodge,
            # don't aggressively brake in the final few frames before the dodge.
            #
            # The goal is to arrive at the ball at the correct time, while preserving
            # enough forward momentum for the dodge to actually go through the ball.

            current_forward_speed = agent.me.local_velocity().x

            power_dodge_window = (
                T < 0.35
                and T > 0.1
                and agent.me.local_location(agent.ball.location).x > 0
                and current_forward_speed > 700
            )

            drive_speed = speed_required * direction

            if power_dodge_window and direction == 1:
                # Still slow down if we're substantially too fast, but don't allow
                # defaultDrive to turn the final approach into a hard brake.
                minimum_final_speed = min(current_forward_speed, 1200)
                drive_speed = max(drive_speed, minimum_final_speed)

            velocity = defaultDrive(agent, drive_speed, local_final_target)[1]

            if velocity == 0:
                velocity = 1

            local_offset_target = agent.me.local_location(self.offset_target.flatten())
            local_vf = agent.me.local(vf.flatten())
            time = distance_remaining / (velocity + dodge_impulse(agent))


            if (
                (
                    self.side_mode
                    and distance_remaining < 180
                    and T <= self.needed_jump_time * 1.08
                )
                or (
                    (
                        abs(velocity) < 100
                        and distance_remaining < agent.me.hitbox.length / 2
                    )
                    or (
                        abs(local_offset_target.y) < 92
                        and direction * local_vf.x >= direction * (
                            local_offset_target.x - agent.me.hitbox.length / 3
                        )
                        and direction * local_offset_target.x > 0
                    )
                ) and T <= self.needed_jump_time * 1.08
            ):
                self.quick_shot = T <= 0.45
                self.jumping = True
                print(
                    f"[JUMP SHOT TYPE] quick={self.quick_shot} T={T:.3f}",
                    flush=True
                )
            elif T <= self.needed_jump_time or (
                Tj > 0
                and distance_remaining > 50
                and not virxrlcu.jump_shot_is_viable(
                    T,
                    agent.boost_accel,
                    tuple(agent.gravity),
                    agent.me.get_raw(agent),
                    self.offset_target.z,
                    tuple((final_target - agent.me.location).normalize()),
                    distance_remaining
                )
            ):
                time_expired = T <= self.needed_jump_time

                print(
                    f"[JUMP SHOT ABORT] phase=approach "
                    f"reason={'time_expired' if time_expired else 'not_viable'} "
                    f"id={id(self)} "
                    f"T={T:.3f} Tj={Tj:.3f} "
                    f"distance={distance_remaining:.1f} "
                    f"needed_jump={self.needed_jump_time:.3f} "
                    f"boost={agent.me.boost:.0f}",
                    flush=True
                )

                agent.pop()
                agent.shooting = False
                agent.shot_weight = -1
                agent.shot_time = -1

                if agent.me.airborne:
                    agent.push(recovery())
            elif agent.boost_amount != 'unlimited' and agent.me.boost < 48 and angle_to_target < 0.03 and velocity > 600 and time >= self.needed_jump_time * 1.15 + 1.5:
                if agent.gravity.z < -450 and time < 5:
                    agent.push(wave_dash(agent.me.local_location(self.offset_target)))
                else:
                    agent.push(flip(agent.me.local_location(self.offset_target)))
            elif (
                agent.boost_amount != 'unlimited'
                and direction == -1
                and distance_remaining > 2560
                and velocity < 200
                and time >= self.needed_jump_time * 1.15 + 2
                and agent.me.local_location(agent.ball.location).x < -250
            ):
                agent.push(flip(agent.me.local_location(self.offset_target), True))
        else:
            if self.jump_time == -1:
                self.jump_time = agent.time

            jump_elapsed = agent.time - self.jump_time
            tau = max(0.0, jump_max_duration - jump_elapsed)

            xf = agent.me.location + agent.me.velocity * T + 0.5 * agent.gravity * T * T

            if jump_elapsed == 0:
                vf += agent.me.up * jump_speed
                xf += agent.me.up * jump_speed * T

            hf = vf.z
            vf += agent.me.up * jump_acc * tau
            xf += agent.me.up * jump_acc * tau * (T - 0.5 * tau)

            delta_x = self.offset_target - xf
            d_direction = delta_x.normalize()

            # ORIENT THE NOSE DURING THE EXISTING JUMP WINDOW.
            # First steer toward the ball's horizontal position, then use S
            # (positive pitch) to raise the nose when the ball is airborne
            # and above the car. This adds no waiting phase and leaves the
            # existing counter-3 dodge trigger intact.
            if self.counter < 3 and not self.dodging:
                local_ball = agent.me.local_location(self.ball_location)
                defaultPD(agent, local_ball.flatten())

                ball_is_airborne = self.ball_location.z > 130
                ball_is_above_car = self.ball_location.z > agent.me.location.z + 65
                hold_s = (
                    ball_is_airborne
                    and ball_is_above_car
                    and not self.quick_shot
                )

                if hold_s:
                    agent.controller.pitch = 1

                if not self._orientation_logged:
                    print(
                        f"[JUMP SHOT ORIENT] T={T:.3f} "
                        f"ball_z={self.ball_location.z:.0f} "
                        f"car_z={agent.me.location.z:.0f} "
                        f"hold_S={hold_s} counter={self.counter}",
                        flush=True
                    )
                    self._orientation_logged = True

            if direction == 1 and abs(agent.me.forward.dot(d_direction)) > 0.5 and self.counter < 3:
                delta_v = delta_x.dot(agent.me.forward) / T
                if agent.me.boost > 0 and delta_v >= agent.boost_accel * min_boost_time:
                    agent.controller.boost = True
                    delta_v -= agent.boost_accel * min_boost_time

                if abs(delta_v) > throttle_accel * min_boost_time:
                    agent.controller.throttle = cap(delta_v / (throttle_accel * min_boost_time), -1, 1)

            
            # Advance through the jump sequence without getting stuck
            # indefinitely at counter == 3.

            if T <= -0.8 or (not agent.me.airborne and self.counter >= 3):
                print(
                    f"[JUMP SHOT ABORT] phase=jump "
                    f"reason={'intercept_expired' if T <= -0.8 else 'landed_before_dodge'} "
                    f"id={id(self)} "
                    f"T={T:.3f} airborne={agent.me.airborne} "
                    f"counter={self.counter} "
                    f"jump_elapsed={jump_elapsed:.3f} "
                    f"boost={agent.me.boost:.0f}",
                    flush=True
                )

                agent.pop()
                agent.shooting = False
                agent.shot_weight = -1
                agent.shot_time = -1
                agent.push(recovery())
                return

            if self.counter == 3:
                local_target = agent.me.local_location(
                    self.offset_target
                ).flatten()

                # Only dodge if the target is still in front and close enough
                # for the dodge to have a realistic chance of making contact.
                close_enough = (
                    agent.me.location.dist(self.offset_target)
                    < (92.75 + agent.me.hitbox.length) * 1.02
                )

                if close_enough and (local_target.x > 0 or self.side_mode):
                    # Aim the dodge at the predicted ball contact itself,
                    # not at the approach point behind the ball. The selected
                    # centre/left/right contact has already shaped that approach.
                    # This also gives quick shots a directional flip without
                    # adding the S-tilt they do not have time to perform.
                    local_ball_for_dodge = agent.me.local_location(
                        self.ball_location
                    ).flatten()

                    if local_ball_for_dodge.magnitude() > 1:
                        dodge_direction = local_ball_for_dodge.normalize()
                    else:
                        dodge_direction = Vector(x=1)

                    agent.controller.pitch = -dodge_direction.x
                    agent.controller.yaw = dodge_direction.y
                    agent.controller.jump = True

                    agent.last_flip_time = agent.time
                    self.dodging = True
                    self.counter = 4

                elif local_target.x <= 0 or (
                    agent.me.location.dist(self.offset_target)
                    > (92.75 + agent.me.hitbox.length) * 1.02 + 150
                    and T < 0.12
                ):
                    print(
                        f"[JUMP SHOT NO DODGE] id={id(self)} "
                        f"local_target_x={local_target.x:.1f} "
                        f"distance={agent.me.location.dist(self.offset_target):.1f} "
                        f"T={T:.3f} counter={self.counter}",
                        flush=True
                    )
                    # Do not keep waiting for a dodge opportunity that has passed.
                    self.counter = 5

            elif self.counter == 4:
                # The dodge has started. Let the existing recovery/timeout
                # logic take over instead of repeatedly initiating a new dodge.
                self.dodging = True

            elif self.counter == 5:
                print(
                    f"[JUMP SHOT ABORT] phase=jump "
                    f"reason=no_dodge_window id={id(self)} "
                    f"T={T:.3f} counter={self.counter}",
                    flush=True
                )
                # No useful dodge opportunity remained.
                agent.pop()
                agent.shooting = False
                agent.shot_weight = -1
                agent.shot_time = -1
                agent.push(ball_recovery())
                return

            # Hold jump long enough to reliably leave the ground.
            # The old hf <= offset_target.z check compared vertical
            # velocity against world height and could release jump too early.
            minimum_jump_hold = 0.06

            if (
                jump_elapsed <= jump_max_duration
                and (
                    jump_elapsed <= minimum_jump_hold
                    or hf <= self.offset_target.z
                )
            ):
                agent.controller.jump = True
            elif self.counter < 3:
                self.counter += 1

        l_vf = vf + agent.me.location
        agent.line(l_vf-Vector(z=100), l_vf+Vector(z=100), agent.renderer.red)

class side_shot(jump_shot):
    """Jump shot that deliberately approaches from the side and dodges inward."""

    def __init__(self, intercept_time, targets=None, approach_side="right"):
        super().__init__(intercept_time, targets)
        self.side_mode = True
        self.side_lateral_distance = None
        self.approach_side = approach_side


class ground_shot:
    # Hits a target point at a target time towards a target direction
    def __init__(self, intercept_time, targets=None):
        self.ball_location = None
        self.shot_vector = None
        self.offset_target = None
        self.intercept_time = intercept_time
        self.targets = targets
        self.goal_aim_point = None
        self.patience = shot_patience()
        self.contact_point = None
        self.contact_approach_target = None
        self.contact_normal = None
        self.contact_label = None

    def update(self, shot):
        self.intercept_time = shot.intercept_time
        self.targets = shot.targets
    def needs_half_flip(self, agent):
        if self.targets is None:
            return False

        if self.intercept_time <= agent.time:
            return False

        ball_slice = _safe_prediction_slice(
            agent, self.intercept_time - agent.time
        )
        if ball_slice is None:
            return False

        ball = ball_slice.physics.location
        ball_location = Vector(ball.x, ball.y, ball.z)

        direction = (ball_location - agent.me.location).normalize()

        if self.goal_aim_point is None:
            self.goal_aim_point = _relative_goal_aim_point(agent, self.targets)
        shot_vector = (
            self.goal_aim_point - ball_location
        ).flatten().normalize()

        offset_target = ball_location - shot_vector * agent.best_shot_value

        local_target = agent.me.local_location(offset_target)

        return local_target.x < 0

    def run(self, agent: VirxERLU):
        if not agent.shooting:
            agent.shooting = True

        self.intercept_time = self.patience.adjust(
            agent, self.intercept_time, self.targets
        )
        T = self.intercept_time - agent.time
        # Capping T above 0 to prevent division problems
        time_remaining = cap(T, 0.000001, 6)

        if T > 0.1 or self.ball_location is None:
            ball_slice = _safe_prediction_slice(agent, T)
            if ball_slice is None:
                agent.pop()
                agent.shooting = False
                agent.shot_weight = -1
                agent.shot_time = -1
                if agent.me.airborne:
                    agent.push(recovery())
                return

            agent.dbg_2d(
                f"Shot slice #: {round(T * 120) - 1} "
                f"/ {len(agent.ball_prediction_struct.slices) - 1}"
            )

            ball = ball_slice.physics.location
            self.ball_location = Vector(ball.x, ball.y, ball.z)

        direction = (self.ball_location - agent.me.location).normalize()
        if self.goal_aim_point is None:
            self.goal_aim_point = _relative_goal_aim_point(agent, self.targets)
        self.shot_vector = (
            self.goal_aim_point - self.ball_location
        ).flatten().normalize()
        self.offset_target = self.ball_location - (self.shot_vector * agent.best_shot_value)
        contact_label = getattr(self, "contact_label", None)
        refreshed_contact = _contact_approach_from_label(
            self.ball_location,
            self.shot_vector,
            contact_label,
            agent.best_shot_value
        )
        if refreshed_contact is not None:
            self.offset_target = refreshed_contact
            self.contact_point = (
                self.ball_location
                + (refreshed_contact - self.ball_location).normalize() * 92.75
            )
            self.contact_approach_target = refreshed_contact.copy()
            print(
                f"[GROUND CONTACT REFRESH] {contact_label} "
                f"point={self.contact_point} approach={self.offset_target}",
                flush=True
            )
        agent.sphere(self.ball_location, 92.75)

        l_ball = agent.me.local(agent.ball.location)
        car_to_ball = agent.ball.location - agent.me.location
        if abs(l_ball.y) < 92.75 + agent.me.hitbox.width / 2 and abs(l_ball.z) < 92.75 + agent.me.hitbox.height / 2:
            final_target = agent.ball.location - (self.shot_vector * agent.best_shot_value)
            distance_remaining = final_target.flat_dist(agent.me.location) - agent.me.hitbox.length / 3
            speed_required = 2300
            agent.dbg_2d(f"Max speed")
        else:
            # Some adjustment to the final target to ensure it's inside the field and we don't try to drive through any goalposts or walls to reach it
            final_target = self.offset_target.copy().flatten()

            if self.targets is not None:
                # whether we are to the left or right of the shot vector
                # Choose a flank route only when our current approach is poorly
                # aligned. This offset fades away before the jump/contact.
                final_target = _shot_approach_target(
                    agent, self.ball_location, final_target, self.shot_vector, T
                )

            distance_remaining = final_target.flat_dist(agent.me.location) - agent.me.hitbox.length / 3
            speed_required = distance_remaining / time_remaining
            agent.dbg_2d(f"Speed required: {speed_required}")

            ball_speed_toward_shot = agent.ball.velocity.dot(self.shot_vector)

            if (
                speed_required < 1900
                and agent.me.boost > 50
                and T > 2
                and distance_remaining > 2560
                and ball_speed_toward_shot > 1000    
            ):
                agent.dbg_2d(
                    f"Building speed | Ball speed toward shot: {round(ball_speed_toward_shot)}"
                )
                speed_required *= 0.75

        # Some adjustment to the final target to ensure it's inside the field and we don't try to drive through any goalposts or walls to reach it (again)
        final_target = cap_in_field(agent, final_target)
        local_final_target = agent.me.local_location(final_target)

        # the angle to the final target, in radians
        angle_to_target = abs(Vector(x=1).angle2D(local_final_target))
        local_ball = agent.me.local_location(agent.ball.location)

        direction = 1

        # drawing debug lines to show the dodge point and final target (which differs due to the adjustment)
        agent.line(agent.me.location, self.offset_target, agent.renderer.white)
        agent.line(self.offset_target-Vector(z=100), self.offset_target+Vector(z=100), agent.renderer.green)
        agent.line(final_target-Vector(z=100), final_target+Vector(z=100), agent.renderer.purple)

        velocity = defaultDrive(agent, speed_required * direction, local_final_target)[1]
        if velocity == 0: velocity = 1

        local_offset_target = agent.me.local_location(self.offset_target.flatten())
        time = distance_remaining / (velocity + dodge_impulse(agent))

        vf = agent.me.velocity + agent.gravity * T
        local_vf = agent.me.local(vf.flatten())

        if T < 0.35 and T > 0.1 and min(abs(velocity) + dodge_impulse(agent), 2300) <= (abs(speed_required) if agent.me.boost > 12 else 1900) and ((abs(velocity) < 100 and distance_remaining < agent.me.hitbox.length / 2) or (abs(local_offset_target.y) < 92 and direction * local_vf.x >= direction * (local_offset_target.x - agent.me.hitbox.length / 3) and direction * local_offset_target.x > 0)):
            agent.push(flip(agent.me.local_location(self.offset_target), cancel=angle_to_target > 2))
        elif agent.me.airborne:
            agent.push(recovery(final_target if T > 0.5 else None))
        elif T <= 0 or (T > 0.35 and distance_remaining > 50 and not virxrlcu.ground_shot_is_viable(T, agent.boost_accel, agent.me.get_raw(agent), self.offset_target.z, tuple((final_target - agent.me.location).normalize()), distance_remaining)):
            # If we're out of time or not fast enough, we pop
            agent.pop()
            agent.shooting = False
            agent.shot_weight = -1
            agent.shot_time = -1
            if agent.me.airborne:
                agent.push(recovery())
        elif agent.boost_amount != 'unlimited' and agent.me.boost < 48 and angle_to_target < 0.03 and velocity > 500 and T > 1 and time >= 1.5:
            speed_gain_routine = wave_dash if agent.gravity.z < -450 and time < 3 and time > 1 else flip
            agent.push(speed_gain_routine(agent.me.local_location(self.offset_target)))
            
class emergency_clear:
    """
    Emergency defensive clear.

    The goal is not to make a precise shot.
    The goal is to get the ball away from our goal as quickly as possible.
    """

    def __init__(self):
        self.start_time = -1
        self.target = None

    def run(self, agent: VirxERLU):
        if self.start_time == -1:
            self.start_time = agent.time

        # ---------------------------------------------------------
        # Pick a safe direction to clear the ball.
        # Clear toward the nearest side of the field.
        # ---------------------------------------------------------
        ball = agent.ball.location

        if self.target is None:
            # Choose the side with less distance to travel.
            if ball.x >= 0:
                self.target = Vector(x=3500, y=ball.y)
            else:
                self.target = Vector(x=-3500, y=ball.y)

        # Keep the target inside the field.
        self.target = cap_in_field(agent, self.target)

        # ---------------------------------------------------------
        # We want to hit the ball from behind it, relative to
        # the direction we want the ball to travel.
        # ---------------------------------------------------------
        clear_direction = (self.target - ball).flatten().normalize()

        hit_target = ball - clear_direction * agent.best_shot_value

        local_target = agent.me.local_location(hit_target)
        local_ball = agent.me.local_location(ball)

        distance = agent.me.location.flat_dist(hit_target)
        angle_to_target = abs(Vector(x=1).angle2D(local_target))

        agent.dbg_2d(
            f"Emergency clear: {round(distance)} | angle {round(angle_to_target, 2)}"
        )

        # Debug:
        agent.line(
            ball,
            self.target,
            agent.renderer.red
        )

        agent.line(
            ball,
            hit_target,
            agent.renderer.green
        )

        # ---------------------------------------------------------
        # If we're airborne, recover toward the ball.
        # ---------------------------------------------------------
        if agent.me.airborne:
            agent.push(recovery(hit_target))
            return

        # ---------------------------------------------------------
        # Get to the ball aggressively.
        # ---------------------------------------------------------
        velocity = defaultDrive(agent, 2300, local_target)[1]

        if velocity == 0:
            velocity = 1

        # Face the ball / hit position.
        defaultPD(agent, local_target)

        # ---------------------------------------------------------
        # If we're lined up, BOOST HARD.
        #
        # This deliberately does NOT use the normal speed-building
        # logic from ground_shot.
        # ---------------------------------------------------------
        if (
            abs(angle_to_target) < 0.35
            and distance > 500
            and agent.me.boost > 0
        ):
            agent.controller.boost = True

        agent.controller.throttle = 1
        # ---------------------------------------------------------
        # Once we're close enough, dodge THROUGH the ball.
        # ---------------------------------------------------------
        if (
            distance < 700
            and abs(local_ball.y) < 180
            and local_ball.x > 0
        ):
            agent.push(flip(agent.me.local(clear_direction), cancel=False))
            return

        # ---------------------------------------------------------
        # Emergency timeout.
        #
        # Don't let the routine get stuck forever if the ball moved.
        # ---------------------------------------------------------
        if agent.time - self.start_time > 2.0:
            agent.pop()
class power_clear:
    """
    Phase 1: Approach a rolling ball while grounded.
    Phase 2: Detect contact and look for an aerial follow-up.

    Does not flip or jump during the initial approach.
    """

    def __init__(self):
        self.start_time = -1
        self.phase = 1
        self.initial_ball_velocity = None
        self.initial_ball_z = 0
        self.contact_time = -1
        self.debug_approach_printed = False

    def run(self, agent: VirxERLU):
        ball = agent.ball
        car = agent.me

        if self.start_time == -1:
            self.start_time = agent.time
            self.initial_ball_velocity = Vector(
                x=ball.velocity.x,
                y=ball.velocity.y,
                z=ball.velocity.z
            )
            self.initial_ball_z = ball.location.z

        ball_location = ball.location
        ball_velocity = ball.velocity
        local_ball = car.local_location(ball_location)
        distance = car.location.flat_dist(ball_location)

        # =====================================================
        # PHASE 1: Ground approach. No jump, no flip.
        # =====================================================

        if self.phase == 1:
            if not self.debug_approach_printed:
                print("[POWER CLEAR] APPROACHING BALL", flush=True)
                self.debug_approach_printed = True

            # Don't keep trying if the car has left the ground.
            if car.airborne:
                agent.pop()
                return

            # Detect a likely touch using proximity and a change
            # in ball height or velocity.
            velocity_change = (
                ball_velocity - self.initial_ball_velocity
            ).magnitude()

            if distance < 500:
                print(
                    f"[POWER CLEAR] NEAR BALL | "
                    f"distance={distance:.1f} | "
                    f"ball_z={ball_location.z:.1f} | "
                    f"ball_vz={ball_velocity.z:.1f}",
                    flush=True
                )

            likely_contact = (
                distance < 300
                and (
                    ball_location.z > self.initial_ball_z + 25
                    or ball_velocity.z > 120
                    or velocity_change > 300
                )
            )

            if likely_contact:
                print("[POWER CLEAR] TOUCH DETECTED - SWITCHING TO PHASE 2", flush=True)
                self.phase = 2
                self.contact_time = agent.time
                return

            # If the ball has already lifted away from us,
            # stop chasing it with the ground-pop routine.
            if ball_location.z > 260 and distance > 350:
                agent.pop()
                return

            # Don't chase indefinitely if the approach fails.
            if agent.time - self.start_time > 1.3:
                agent.pop()
                return

            angle = abs(Vector(x=1).angle2D(local_ball))

            # Controlled speed for the initial pop.
            defaultDrive(agent, 1300, local_ball)
            defaultPD(agent, local_ball)
            agent.controller.throttle = 1

            # Boost only while well aligned and still far enough
            # away to avoid wasting it at the contact point.
            if (
                angle < 0.18
                and distance > 100
                and car.boost > 0
                and car.velocity.magnitude() < 1390
            ):
                agent.controller.boost = True

            return

        # =====================================================
        # PHASE 2: The ball appears to have been touched.
        # Wait for it to lift enough for an aerial shot.
        # =====================================================


        if self.phase == 2:
            elapsed = agent.time - self.contact_time

            print(
                f"[POWER CLEAR] PHASE 2 | "
                f"z={ball_location.z:.1f} | "
                f"vz={ball_velocity.z:.1f} | "
                f"elapsed={elapsed:.2f}s",
                flush=True
            )

            # Start looking sooner after the pop.
            if ball_location.z > 140 or ball_velocity.z > 100:
                from util import tools

                print("[POWER CLEAR] TRYING TO FIND AERIAL", flush=True)

                aerial = tools.find_aerial(
                    agent,
                    agent.foe_goal_shot
                )

                print(
                    f"[POWER CLEAR] AERIAL RESULT: "
                    f"{'FOUND' if aerial is not None else 'NONE'}",
                    flush=True
                )

                if aerial is not None:
                    print("[POWER CLEAR] SWITCHING TO AERIAL", flush=True)
                    agent.pop()
                    agent.push(aerial)
                    return

            # Allow more time for the ball to rise.
            if elapsed > 1.45:
                print("[POWER CLEAR] TIMED OUT - NO AERIAL FOUND", flush=True)
                agent.pop()
                return




class kickoff_dodge:

    def __init__(self, direction):
        self.direction = direction
        self.timer = -1

    def run(self, agent: VirxERLU):

        if self.timer == -1:
            self.timer = agent.time

        elapsed = agent.time - self.timer

        # First jump
        if elapsed < 0.05:
            agent.controller.jump = True

        # Very short jump release
        elif elapsed < 0.083:
            agent.controller.jump = False

        # SECOND JUMP / DODGE
        elif elapsed < 0.15:
            agent.controller.jump = True
            agent.controller.pitch = -self.direction.x
            agent.controller.yaw = self.direction.y

        else:
            agent.pop()
            return True


class speed_flip:
    def __init__(self, right_handed=True, use_boost=True):
        self.direction = 1 if right_handed else -1
        self.use_boost = use_boost
        self.steps = [
            (5 / 60, {"steer": -self.direction, "boost": True}),
            (1 / 60, {"jump": True, "boost": True}),
            (0.05, {"boost": True}),
            (1 / 60, {
                "yaw": self.direction,
                "jump": True,
                "pitch": -1,
                "boost": True
            }),
            (0.6, {"pitch": 1, "boost": True}),
            (0.2, {
                "yaw": self.direction,
                "roll": self.direction,
                "boost": True
            }),
        ]

        self.step_index = 0
        self.step_start_time = None

    def run(self, agent: VirxERLU):
        if self.step_start_time is None:
            self.step_start_time = agent.time

        # Default all controls each frame to avoid stale inputs.
        agent.controller.throttle = 1
        agent.controller.steer = 0
        agent.controller.pitch = 0
        agent.controller.yaw = 0
        agent.controller.roll = 0
        agent.controller.jump = False
        agent.controller.boost = (
            self.use_boost and agent.me.boost > 0
        )

        # Finish when all sequence steps have completed.
        if self.step_index >= len(self.steps):
            agent.pop()
            return True

        duration, controls = self.steps[self.step_index]

        # Apply this step's controls.
        for control, value in controls.items():
            if control == "boost":
                value = value and self.use_boost and agent.me.boost > 0

            setattr(agent.controller, control, value)

        # Advance after the step duration has elapsed.
        if agent.time - self.step_start_time > duration:
            self.step_index += 1
            self.step_start_time = agent.time

            if self.step_index >= len(self.steps):
                agent.pop()
                return True

        return False

class speedflip_kickoff:

    def __init__(self):
        self.phase = 0
        self.speedflip_started = False
        self.phase3_start_time = -1
        self.phase3_start_ball = None
        self.phase3_start_velocity = None
        

    def run(self, agent: VirxERLU):

