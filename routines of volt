class short_shot:
    # This routine drives towards the ball and attempts to hit it towards a given target
    # It does not require ball prediction and kinda guesses at where the ball will be on its own
    def __init__(self, target):
        self.target = target
        self.start_time = None

    def run(self, agent: VirxERLU):
        if not agent.shooting or agent.shot_weight != -1:
            agent.shooting = True
            agent.shot_weight = -1

        if self.start_time is None:
            self.start_time = agent.time

        car_to_ball, distance = (agent.ball.location - agent.me.location).normalize(True)
        ball_to_target = (self.target - agent.ball.location).normalize()

        relative_velocity = car_to_ball.dot(agent.me.velocity-agent.ball.velocity)
        eta = cap(distance / cap(relative_velocity, 400, 2150), 0, 1.5) if relative_velocity != 0 else 1.5

        # If we are approaching the ball from the wrong side the car will try to only hit the very edge of the ball
        left_vector = car_to_ball.cross(Vector(z=1))
        right_vector = car_to_ball.cross(Vector(z=-1))
        target_vector = -ball_to_target.clamp2D(left_vector, right_vector)
        final_target = agent.ball.location + (target_vector*(distance/2))
        angle_to_target = abs(Vector(x=1).angle2D(agent.me.local_location(final_target)))
        distance_remaining = agent.me.location.dist(final_target) - agent.me.hitbox.length / 3

        # Some adjustment to the final target to ensure we don't try to drive through any goalposts to reach it
        final_target = cap_in_field(agent, final_target)
        local_final_target = agent.me.local_location(final_target)

        agent.line(final_target-Vector(z=100), final_target + Vector(z=100), (255, 255, 255))
        direction = 1
        angles, velocity = defaultDrive(agent, 1410 * direction, local_final_target)

        if velocity == 0: velocity = 1

        if abs(angles[1]) < 0.05 and (eta < 0.45 or distance < 150):
            agent.pop()
            agent.shooting = False
            agent.shot_weight = -1
            agent.shot_time = -1
            agent.push(flip(agent.me.local(car_to_ball)))
        elif agent.boost_amount != 'unlimited' and agent.me.location.z < 50 and agent.me.boost < 48 and angle_to_target < 0.03 and velocity > 500 and T > 1 and time >= T + 1.5:
            speed_gain_routine = wave_dash if agent.gravity.z < -450 and time < 3 and time > 1 else flip
            agent.push(speed_gain_routine(agent.me.local_location(self.target)))
        elif agent.boost_amount != 'unlimited' and agent.me.location.z < 50 and direction == -1 and velocity < 200 and time >= T + 1.5:
            agent.push(flip(agent.me.local_location(self.target), True))

class wall_shot:
    def __init__(self, aerial):
        self.aerial = aerial
        self.intercept_time = aerial.intercept_time
        self.targets = getattr(aerial, "targets", None)
        self.fast_aerial = getattr(aerial, "fast_aerial", True)
        self.start_time = None
        self.last_debug_time = -1

    def update(self, shot):
        # The finder supplies a new wall_shot wrapper each evaluation.
        # Keep this active routine instance, but refresh its intercept.
        self.aerial = getattr(shot, "aerial", shot)
        self.intercept_time = self.aerial.intercept_time
        self.targets = getattr(self.aerial, "targets", self.targets)
        self.fast_aerial = getattr(
            self.aerial, "fast_aerial", self.fast_aerial
        )

    def run(self, agent: VirxERLU):
        if not agent.shooting:
            agent.shooting = True

        self.intercept_time = self.aerial.intercept_time
        if self.start_time is None:
            self.start_time = agent.time

        car = agent.me
        T = self.aerial.intercept_time - agent.time
        prediction = agent.ball_prediction_struct

        # Fail safely if the interception is no longer usable.
        if (
            prediction is None
            or not prediction.slices
            or T <= 0.2
            or T > 6
            or agent.time - self.start_time > 2.5
        ):
            agent.pop()
            agent.shooting = False
            print("[WALL SHOT] Aborted; returning to normal shot selection",
                  flush=True)
            return

        # Match the prediction indexing used by the existing Aerial routine.
        slice_n = math.ceil(T * 120) - 1

        if slice_n < 0 or slice_n >= len(prediction.slices):
            agent.pop()
            agent.shooting = False
            print("[WALL SHOT] Invalid prediction slice", flush=True)
            return

        predicted = prediction.slices[slice_n].physics.location
        ball = Vector(predicted.x, predicted.y, predicted.z)

        # Only continue while the ball still qualifies as a wall shot.
        if abs(ball.x) < 2800 or ball.z < 250 or abs(ball.y) > 5000:
            agent.pop()
            agent.shooting = False
            print("[WALL SHOT] Ball no longer qualifies", flush=True)
            return

        distance = car.location.dist(ball)
        wall_side = 1 if ball.x >= 0 else -1

        # A car is on the side wall when its roof orientation points
        # approximately toward the field centre.
        on_wall = (
            abs(car.location.x) > 3450
            and abs(car.up.x) > 0.65
            and car.up.x * car.location.x < 0
        )

        # Approach the wall first. Once there, move along it toward
        # the predicted ball position.
        if not on_wall:
            world_target = Vector(
                wall_side * 3850,
                ball.y,
                car.location.z
            )
        else:
            world_target = Vector(
                wall_side * 3850,
                ball.y,
                max(100, ball.z)
            )

        local_target = car.local_location(world_target)

        # Avoid demanding an impossible speed when little time remains.
        time_left = max(0.35, min(T, 3.0))
        speed_required = min(
            2200,
            max(900, distance / time_left)
        )

        defaultDrive(agent, speed_required, local_target)
        # Let defaultDrive steer and throttle. Boost only when it can
        # meaningfully help the approach.
        agent.controller.boost = (
            car.boost > 0
            and distance > 300
            and speed_required > 1200
        )

        # Hand off only when we're on the wall and close enough that
        # the existing aerial can take over.
        if on_wall and distance < 200 and T < 1.5:
            agent.pop()
            agent.push(self.aerial)
            print(
                f"[WALL SHOT] Aerial handoff | "
                f"distance={distance:.0f} T={T:.2f}",
                flush=True
            )
            return

        # Throttle debug output so the console remains readable.
        if agent.time - self.last_debug_time >= 0.5:
            self.last_debug_time = agent.time
            print(
                f"[WALL SHOT] approaching | "
                f"on_wall={on_wall} distance={distance:.0f} "
                f"ball_z={ball.z:.0f} T={T:.2f}",
                flush=True
            )

class boost_down:
