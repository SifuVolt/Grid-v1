&#x20;       \# These names must match the actual routine class names.\
&#x20;       shot_names = {\
&#x20;           "ground_shot",\
&#x20;           "jump_shot",\
&#x20;           "double_jump",\
&#x20;           "Aerial",\
&#x20;           "short_shot"\
&#x20;       }\
