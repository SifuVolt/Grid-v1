                    f"active_challenger={self.get_grid_active_challenger()} "
                    f"friends={len(self.friends)}",
                    flush=True
                )

            if shot is not None:
                is_wall_drive = shot.__class__.__name__ == "wall_approach"
                should_commit = (
                    is_wall_drive
                    or self.should_commit_to_shot(
                        self.teamplay_score,
                        self.teamplay_contact_time
                    )
                )

                if not should_commit:
                    # Only interrupt an ordinary shot routine.
                    # Never cancel a flip, aerial, or recovery here.
                    current_name = (
                        self.stack[0].__class__.__name__
                        if not self.is_clear()
                        else None
                    )

                    ordinary_shots = {
                        "double_jump",
                        "jump_shot",
                        "ground_shot",
                        "Aerial",
                        "Redirect",
                        "wall_approach"
                    }

                    if current_name in ordinary_shots and not committed_routine_lock:
                        self.clear()

                        # Announce once when an active routine is actually
                        # cancelled; do not resend every packet while yielding.
                        self.teamplay_shot = None
                        self.cover_role_released = False
                        self.last_comms_signature = None
                        self.last_comms_send_time = -999.0
                        self.send_teamplay_comm("SHOT_ABANDONED", 0.0, 10.0)

                    # Yield to the teammate's better opportunity.
                    # Continue to the existing fallback behaviour.
                else:
                    if (
                        not committed_routine_lock
                        and shot.__class__.__name__ != "wall_approach"
                        and routines.half_flip_manager.request_for_shot(self, shot)
                    ):
                        return

                    
                    if self.is_clear():
                        self.push(shot)
                    else:
                        current_shot_name = self.stack[0].__class__.__name__
                        new_shot_name = shot.__class__.__name__

                        if new_shot_name == current_shot_name:
                            # Keep updating the same routine as predictions change.
                            self.stack[0].update(shot)
                        else:
                            ordinary_shots = {
                                "ground_shot",
                                "jump_shot",
                                "double_jump",
                                "Aerial",
                                "Redirect"
                            }

                            # Don't cancel an ordinary shot just because a
                            # different ordinary shot is suggested.
                            if (
                                current_shot_name in ordinary_shots
                                and new_shot_name in ordinary_shots
                            ):
                                current_intercept = getattr(
                                    self.stack[0], "intercept_time", float("inf")
                                )
                                # In the fast zone, allow a genuinely earlier
                                # reachable touch to replace a later planned hit.
                                if (
                                    not fast_intercept_zone
                                    or shot.intercept_time >= current_intercept - 0.05
                                ):
                                    return

                            if committed_routine_lock:
                                return
                            self.clear()
                            self.push(shot)
                    return



            # TODO we might miss the net, even when using a target - make a pair of targets that are small than the goal so we have a better chance of scoring!
            # If the ball is on the enemy's side of the field, or slightly on our side
            
            ball_depth = (
                self.ball.location.y * utils.side(self.team)
            )
            can_take_first_challenge = (
                not self.friends
                or self.get_grid_active_challenger() == self.me.index
                or self.defensive_emergency()
            )

            # Prefer a reachable wall drive over waiting for a later ground shot.
            wall_drive = (
                tools.find_wall_drive(self)
                if can_take_first_challenge
                else None
            )
            if (
                not can_take_first_challenge
                and self.time - getattr(self, "_last_wall_drive_gate_debug", -999.0) >= 0.5
            ):
                self._last_wall_drive_gate_debug = self.time
                print(
                    f"[WALL DRIVE SKIP] first-challenge gate | "
                    f"player={self.me.index} "
                    f"active_challenger={self.get_grid_active_challenger()} "
                    f"friends={len(self.friends)}",
                    flush=True
                )

            fast_intercept_searched = (
                fast_intercept_zone and can_take_first_challenge
            )

            if wall_drive is not None:
                shot = wall_drive
            elif fast_intercept_searched:
                shot = routines.fast_intercept_finder().find(self)

            elif ball_depth < 640 and can_take_first_challenge:
                shot = tools.find_shot(self, self.foe_goal_shot)



            # TODO Using an anti-target here could be cool - do to this, pass in a target tuple that's (right_target, left_target) (instead of (left, right)) into tools.find_shot (NOT tools.find_any_shot)
            # TODO When possible, we might want to take a little bit more time to shot the ball anywhere in the opponent's end - this target should probably be REALLY LONG AND HIGH!
            # If we're behind the ball and we couldn't find a shot on target
            if (
                shot is None
                and not fast_intercept_searched
                and (
                    len(self.friends) < 2
                    or self.get_grid_active_challenger() == self.me.index
                    or self.defensive_emergency()
                )
            ):
                # Find a shot, but without a target - double_jump, jump_shot, and ground_shot are automatically disabled if we're airborne.
                shot = tools.find_any_shot(self)

            # Last-resort team option: if neither a goal shot nor a useful
            # untargeted shot exists, try to send the ball ahead of a teammate.
            # This is intentionally outside teamplay decision-making and does
            # not override an existing teamplay shot or the cover-role guard.
            if (
                shot is None
                and self.friends
                and (
                    len(self.friends) < 2
                    or self.get_grid_active_challenger() == self.me.index
                    or self.defensive_emergency()
                )
            ):
                shot = tools.find_pass_shot(self)

            # If we found a shot
            if shot is not None:

                if (
                    not committed_routine_lock
                    and routines.half_flip_manager.request_for_shot(self, shot)
                ):
                    return

                
                if self.is_clear():
                    self.push(shot)
                else:
                    current_shot_name = self.stack[0].__class__.__name__
                    new_shot_name = shot.__class__.__name__

                    if new_shot_name == current_shot_name:
                        # Keep updating the same routine as predictions change.
                        self.stack[0].update(shot)
                    else:
                        ordinary_shots = {
                            "ground_shot",
                            "jump_shot",
                            "double_jump",
                            "Aerial",
                            "Redirect",
                            "wall_approach"
                        }

                        # Don't cancel an ordinary shot just because a
                        # different ordinary shot is suggested.
                        if (
                            current_shot_name in ordinary_shots
                            and new_shot_name in ordinary_shots
                            and new_shot_name != "wall_approach"
                        ):
                            current_intercept = getattr(
                                self.stack[0], "intercept_time", float("inf")
                            )
                            # In the shallow own-half zone, let an earlier
                            # feasible touch replace a later one.
                            if (
                                not fast_intercept_zone
                                or shot.intercept_time >= current_intercept - 0.05
                            ):
                                return

                        if committed_routine_lock:
                            return
                        self.clear()
                        self.push(shot)
                return



        # TODO this setup is far from ideal - a custom shadow/retreat routine is probably best for the bot...
        # Make sure to put custom routines in a separate file from VirxERLU routines, so you can easily update VirxERLU to newer versions.
        # If the stack is still clear
        if self.is_clear():
            
            # Challenge a nearby opponent with a poor attacking angle.
            # Do not use emergency_clear as a fallback here.
            if (
                self.ball.location.y * utils.side(self.team) > 640
                and self.opponent_is_vulnerable()
                and (
                    not self.friends
                    or self.get_grid_active_challenger() == self.me.index
                )
            ):
                challenge = tools.find_any_shot(self)

                if challenge is not None:
                    self.push(challenge)
                    return

            # Match Grid's rotating roles: exactly one goalie. The other
            # player in 2v2 challenges; in 3v3 both non-goalies use the
            # challenger/transition behaviours, with no fixed support role.
            goalie_role = False
            if self.friends:
                attacker, goalie, transition = self.get_grid_team_roles()
                goalie_role = self.should_hold_cover_role()

            self.push(routines.grid_defense(goalie=goalie_role))
            return

        # If we get here, then we are doing our kickoff, nor can we shoot, nor can we retreat or shadow - so let's just wait!

    
    def demolished(self):
        # Clear any routine interrupted by the demolition.
        if not self.is_clear():
            self.clear()

        # Reset kickoff state so a stale kickoff flag cannot block logic.
        self.kickoff_routine_started = False

        # Force normal decision-making to resume after respawn.
        self.kickoff_done = True

        # Reset emergency-save state in case demolition interrupted a save.
        self.emergency_save_active = False
        self.emergency_save_cooldown = 0


    
    def handle_match_comm(
        self,
        index: int,
        team: int,
        content: bytes,
        display: str | None,
        team_only: bool
    ):
        print(
            f"[COMM CALLBACK] from={index}, team={team}, "
            f"team_only={team_only}, bytes={len(content)}",
            flush=True
        )

        if team != self.team or index == self.index:
            return

        if not team_only:
            return

        if not any(friend.index == index for friend in self.friends):
            return

        try:
            message = json.loads(content.decode("utf-8"))

            if message.get("protocol") != "volt_teamplay_v1":
                return

            status = message.get("status")

            if status not in {
                "SHOT_FOUND",
                "ANY_SHOT_FOUND",
                "SHOT_ABANDONED",
                "SHOT_CONTESTED",
                "LOW_BOOST",
                "NO_SHOT",
                "DEFEND",
                "SHADOW"
            }:
                return

            score = float(message.get("score", 0))
            contact_time = float(message.get("contact_time", 99))

            if not math.isfinite(score) or not 0 <= score <= 100:
                return

            if not math.isfinite(contact_time) or not 0 <= contact_time <= 10:
                return

            cover_released = message.get("cover_released", False)
            if not isinstance(cover_released, bool):
                return

            cover_owner = message.get("cover_owner")
            if cover_owner is not None:
                if not isinstance(cover_owner, int):
                    return

            self.teammate_comms[index] = {
                "status": status,
                "shot_type": message.get("shot_type", status),
                "score": score,
                "contact_time": contact_time,
                "cover_owner": cover_owner,
                "cover_released": cover_released,
                "receive_x": message.get("receive_x"),
                "receive_y": message.get("receive_y"),
                "receive_dir_x": message.get("receive_dir_x"),
                "receive_dir_y": message.get("receive_dir_y"),
                "contact_x": message.get("contact_x"),
                "contact_y": message.get("contact_y"),
                "received_at": self.time
            }

            self.print(
                f"TEAMPLAY RECEIVED from {index}: "
                f"{status}, score={score:.1f}, time={contact_time:.2f}, "
                f"cover_owner={cover_owner}, released={cover_released}"
            )

        except (
            ValueError,
            TypeError,
            UnicodeDecodeError,
            AttributeError
        ):
            return
    def send_teamplay_comm(
        self,
        status: str,
        score: float = 0,
        contact_time: float = 10
    ):
        # Send the predicted ball contact and intended goalward lane with the
        # shot announcement. The transition player can use this before the
        # ball is struck instead of guessing from the attacker's current nose.
        receive_plan = {}
        planned_shot = getattr(self, "teamplay_shot", None)
        if (
            status in {"SHOT_FOUND", "ANY_SHOT_FOUND", "SHOT_CONTESTED"}
            and planned_shot is not None
            and getattr(planned_shot, "intercept_time", None) is not None
        ):
            prediction = getattr(self, "ball_prediction_struct", None)
            slices = getattr(prediction, "slices", None) if prediction is not None else None
            if slices:
                seconds_to_contact = max(
                    0.0, planned_shot.intercept_time - self.time
                )
                slice_index = max(
                    0, min(len(slices) - 1, round(seconds_to_contact * 120))
                )
                physics = slices[slice_index].physics
                contact_ball = Vector(
                    physics.location.x, physics.location.y, physics.location.z
                )
                aim_point = self.foe_goal.location
                planned_targets = getattr(planned_shot, "targets", None)
                if planned_targets is not None and len(planned_targets) >= 2:
                    try:
                        aim_point = (
                            Vector(*planned_targets[0])
                            + Vector(*planned_targets[1])
                        ) * 0.5
                    except (TypeError, ValueError):
                        pass
                lane = (aim_point - contact_ball).flatten()
                if lane.magnitude() < 1:
                    lane = self.me.forward.flatten()
                if lane.magnitude() > 1:
                    lane = lane.normalize()
                    lane_distance = min(
                        1050.0,
                        max(350.0, contact_ball.flat_dist(aim_point) * 0.28)
                    )
                    receive_point = contact_ball + lane * lane_distance
                    receive_plan = {
                        "receive_x": round(receive_point.x, 1),
                        "receive_y": round(receive_point.y, 1),
                        "receive_dir_x": round(lane.x, 4),
                        "receive_dir_y": round(lane.y, 4),
                        "contact_x": round(contact_ball.x, 1),
                        "contact_y": round(contact_ball.y, 1)
                    }

        message = {
            "protocol": "volt_teamplay_v1",
            "status": status,
            "shot_type": status if status in {"SHOT_FOUND", "ANY_SHOT_FOUND", "SHOT_CONTESTED"} else "NO_SHOT",
            "score": round(max(0, min(100, score)), 1),
            "contact_time": round(max(0, min(10, contact_time)), 2),
            "cover_owner": self.get_cover_role_owner(),
            "cover_released": bool(self.cover_role_released),
            **receive_plan
        }

        # Include cover fields so a change in cover responsibility
        # causes the updated message to be sent.
        signature = (
            message["status"],
            message["score"],
            message["contact_time"],
            message["cover_owner"],
            message["cover_released"],
            message.get("receive_x"),
            message.get("receive_y"),
            message.get("receive_dir_x"),
            message.get("receive_dir_y")
        )

        # Refresh unchanged messages periodically so teammates don't
        # treat the information as stale.
        if (
            signature == self.last_comms_signature
            and self.time - self.last_comms_send_time < 0.25
        ):
            return

        # Limit message frequency.
        if self.time - self.last_comms_send_time < 0.1:
            return

        try:
            self.send_match_comm(
                json.dumps(message).encode("utf-8"),
                team_only=True
            )

            print(f"TEAMPLAY SENT: {message}", flush=True)

            self.last_comms_signature = signature
            self.last_comms_send_time = self.time

        except (AttributeError, RuntimeError) as e:
            self.print(f"TEAMPLAY SEND FAILED: {e}")
            return
    def get_teammate_comm(self, index: int, max_age: float = 0.5):
        message = self.teammate_comms.get(index)

        if message is None:
            return None

        if self.time - message["received_at"] > max_age:
            return None

        return message


