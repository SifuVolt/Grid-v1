import math



class Bot(VirxERLU):
    # If the bot encounters an error, VirxERLU will do it's best to keep the bot from crashing.
    # VirxERLU uses a stack system for it's routines. A stack is a first-in, last-out system of routines.
    # VirxERLU on VirxEC Showcase -> https\://virxerlu.virxcase.dev/
    # Questions? Want to be notified about VirxERLU updates? Join my Discord -> https\://discord.gg/5ARzYRD2Na
    # Wiki -> https\://github.com/VirxEC/VirxERLU/wiki
    def init(self):
        # NOTE This method is ran only once, and it's when the bot starts up

        # This is a shot between the opponent's goal posts
        # NOTE When creating these, it must be a tuple of (left_target, right_target)
        left_epost = self.foe_goal.left_post
        right_epost = self.foe_goal.right_post

        goal_width_direction = (
            right_epost - left_epost
        ).normalize()

        self.foe_goal_shot = (
            left_epost + goal_width_direction * 39,
            right_epost - goal_width_direction * 39
        )
        
        left_post = self.friend_goal.left_post
        right_post = self.friend_goal.right_post

        goal_width_direction = (
            right_post - left_post
        ).normalize()

        anti_target = (
            right_post + goal_width_direction * 100,
            left_post - goal_width_direction * 100
        )
        self.last_prejump_check = -999.0
        self.prejump_cooldown_until = -999.0
        self.kickoff_routine_started = False
        self.kickoff_role = None
        self.kickoff_boost_pending = False
        self.kickoff_ball_start = None
        self.kickoff_contest_until = -999.0
        self.committed_shot = None
        # Teamplay communication state.
        self.cover_role_owner = None
        self.cover_role_released = False
        self.teammate_comms = {}
        self.last_comms_signature = None
        self.last_comms_send_time = -999.0
        self.teamplay_shot = None
        self.teamplay_score = 0.0
        self.teamplay_contact_time = 10.0
        self.teamplay_status = "NO_SHOT"
        self.transition_bump_cooldown_until = -999.0
        self.kickoff_routine_started = False
        self.last_emergency_clear_time = -999.0
        self.emergency_save_zone_active = False
        self.emergency_save_active = False
        self.emergency_save_cooldown = 0


        # NOTE If you want to shoot the ball anywhere BUT between to targets, then make a tuple like (right_target, left_target) - I call this an anti-target
    def _cars(self):
        return [self.me] + list(self.friends)
    def should_prejump_defensive_read(self):
        """Rate-limited read of a likely opponent shot; no per-packet re-search."""
        if self.time < self.prejump_cooldown_until or self.time - self.last_prejump_check < 0.12:
            return False
        self.last_prejump_check = self.time
        if self.me.airborne or self.me.boost < 8:
            return False
        ball = self.ball.location
        side = utils.side(self.team)
        depth = ball.y * side
        if ball.z < 280 or depth < -300 or depth > 4700:
            return False
        if not self.foes:
            return False
        foe = min(self.foes, key=self._eta_to_ball)
        foe_eta = self._eta_to_ball(foe)
        my_eta = self._eta_to_ball(self.me)
        if foe_eta + 0.17 >= my_eta or foe.location.dist(ball) > 1500:
            return False
        toward_goal = (self.friend_goal.location - ball).flatten()
        foe_forward = foe.forward.flatten()
        if toward_goal.magnitude() < 1 or foe_forward.magnitude() < 1:
            return False
        threat_alignment = foe_forward.normalize().dot(toward_goal.normalize())
        ball_to_goal = toward_goal.normalize()
        ball_velocity = self.ball.velocity.flatten()
        velocity_alignment = 0.0
        if ball_velocity.magnitude() > 100:
            velocity_alignment = ball_velocity.normalize().dot(ball_to_goal)
        # Opponent must be facing toward our goal, or the ball must already be
        # moving goalward. This avoids jumping at harmless opponent touches.
        return threat_alignment > 0.30 or velocity_alignment > 0.48
    def _flat_speed(self, car):
        v = car.velocity
        return math.hypot(v.x, v.y)

    def _eta_to_ball(self, car):
        """Cheap, deterministic ETA estimate; every teammate can calculate it."""
        delta = self.ball.location - car.location
        distance = max(0.0, delta.magnitude())
        flat_delta = delta.flatten()
        forward = car.forward.flatten()
        facing = 1.0
        if flat_delta.magnitude() > 1 and forward.magnitude() > 1:
            facing = max(-1.0, min(1.0, forward.normalize().dot(flat_delta.normalize())))
        speed = self._flat_speed(car)
        effective_speed = max(850.0, min(2100.0, speed + 650.0))
        turn_penalty = (1.0 - facing) * 0.28
        height_penalty = max(0.0, self.ball.location.z - car.location.z) / 5000.0
        return distance / effective_speed + turn_penalty + height_penalty

    def _active_shot_race_info(self):
        """Return (our_contact_time, foe_eta, foe_index) if an opponent is likely to beat our active shot."""
        if self.is_clear() or not self.foes:
            return None

        routine = self.stack[0]
        shot_names = {
            "ground_shot", "jump_shot", "double_jump",
            "Aerial", "Redirect", "wall_approach", "short_shot"
        }
        if routine.__class__.__name__ not in shot_names:
            return None

        intercept_time = getattr(routine, "intercept_time", None)
        if intercept_time is None or not math.isfinite(intercept_time):
            return None

        contact_time = intercept_time - self.time
        if contact_time <= 0.05 or contact_time > 6.0:
            return None

        prediction = getattr(self, "ball_prediction_struct", None)
        slices = getattr(prediction, "slices", None) if prediction is not None else None
        if not slices:
            return None

        slice_index = max(
            0, min(len(slices) - 1, round(contact_time * 120))
        )
        physics = slices[slice_index].physics
        contact_ball = Vector(
            physics.location.x,
            physics.location.y,
            physics.location.z
        )

        best_eta = float("inf")
        best_foe = None
        for foe in self.foes:
            delta = contact_ball - foe.location
            distance = delta.magnitude()
            flat_delta = delta.flatten()
            forward = foe.forward.flatten()
            facing = 0.0
            if flat_delta.magnitude() > 1 and forward.magnitude() > 1:
                facing = max(
                    -1.0,
                    min(1.0, forward.normalize().dot(flat_delta.normalize()))
                )

            speed = self._flat_speed(foe)
            effective_speed = max(850.0, min(2100.0, speed + 650.0))
            turn_penalty = (1.0 - facing) * 0.28
            height_penalty = max(
                0.0, contact_ball.z - foe.location.z
            ) / 5000.0
            foe_eta = (
                distance / effective_speed
                + turn_penalty
                + height_penalty
            )
            if foe_eta < best_eta:
                best_eta = foe_eta
                best_foe = foe

        if best_foe is not None and best_eta + 0.15 < contact_time:
            return contact_time, best_eta, best_foe.index
        return None

    def should_take_kickoff(self):
        # 1v1: always take the kickoff
        if len(self.friends) == 0:
            return True

        teammate = min(
            self.friends,
            key=lambda car: car.location.dist(self.ball.location)
        )

        my_distance = self.me.location.dist(self.ball.location)
        teammate_distance = teammate.location.dist(self.ball.location)

        # If one player is clearly closer, the closer player takes it.
        if my_distance + 300 < teammate_distance:
            return True

        if teammate_distance + 300 < my_distance:
            return False

        # If the positions are roughly equal, use left-goes.
        # From our team's perspective, left is x * side(team) < 0.
        return self.me.location.x * utils.side(self.team) < 0
        
    def should_defensive_aerial(self):
        side = utils.side(self.team)
        ball = self.ball.location
        car = self.me

        # Noob Black's role election decides whether the deepest player
        # is also the active challenger. A goalie may aerial only when the
        # team-role calculation has selected that same car to challenge.
        if self.friends:
            attacker_index, goalie_index, _ = self.get_grid_team_roles()
            if (
                self.me.index == goalie_index
                and self.me.index != attacker_index
            ):
                return False

        # Ball must be high and in our half.
        ball_depth = ball.y * side
        if ball.z < 350 or ball_depth < 0:
            return False

        # Ball must be travelling towards our own goal.
        if self.ball.velocity.y * side < 250:
            return False

        # Car must be facing generally towards our own goal.
        toward_own_goal = (
            self.friend_goal.location - car.location
        ).flatten().normalize()

        car_forward = car.forward.flatten().normalize()

        if car_forward.dot(toward_own_goal) < 0.35:
            return False

        # Avoid attempting an aerial when the ball is too far away.
        if car.location.dist(ball) > 3000:
            return False

        return True

    def _kickoff_assignments(self):
        cars = self._cars()
        ordered = sorted(
            cars,
            key=lambda car: (car.location.dist(self.ball.location), car.index),
        )
        kicker = ordered[0]
        cheater = ordered[1] if len(ordered) >= 2 else None
        boost_player = ordered[2] if len(ordered) >= 3 else None
        return kicker.index, cheater.index if cheater else None, boost_player.index if boost_player else None

    def should_take_kickoff(self):
        if not self.friends:
            return True
        kicker, _, _ = self._kickoff_assignments()
        return self.me.index == kicker

    def _kickoff_boost_target(self):
        side = utils.side(self.team)
        pads = [
            boost for boost in self.boosts
            if boost.active and boost.large and boost.location.y * side > 2500
        ]
        if not pads:
            pads = [boost for boost in self.boosts if boost.active and boost.large]
        if not pads:
            return None

        # Prefer the back-corner pad on the player's own side of the field.
        return min(
            pads,
            key=lambda boost: (
                boost.location.dist(self.me.location)
                + 0.35 * abs(boost.location.x - self.me.location.x),
                boost.location.x * self.me.location.x < 0,
            ),
        )

    def in_post_kickoff_contest_window(self):
        """Allow confident challenges for ten seconds after kickoff resolves."""
        return self.time <= getattr(self, "kickoff_contest_until", -999.0)

    def _kickoff_resolved(self):
        if self.kickoff_ball_start is None:
            return False
        moved = self.ball.location.dist(self.kickoff_ball_start) > 300
        fast = self.ball.velocity.magnitude() > 350
        return moved or fast
    def should_prioritize_ball(self, ignore_teammate=False):
        """
        Mode-specific ball prioritization.

        1v1: Aggressive, but avoid bad challenges.
        2v2: Balanced challenges with teammate awareness.
        3v3: Aggressive pressure, especially in the attacking half.
        """

        car = self.me
        ball = self.ball.location
        side = utils.side(self.team)

        distance = car.location.dist(ball)
        local_ball = car.local_location(ball)
        angle = abs(Vector(x=1).angle2D(local_ball))

        ball_depth = ball.y * side

        ball_toward_our_goal = (
            self.ball.velocity.y * side > 400
        )

        ball_in_enemy_half = ball_depth < -500
        ball_near_enemy_goal = ball_depth < -3000

        mode = len(self.friends) + 1

        # Genuine defensive emergencies always take priority.
        if self.defensive_emergency():
            return True
                # --------------------------------------------------
        # EMERGENCY GOAL-LINE DEFENCE
        # Never yield a dangerous goal-line ball to teammate logic.
        # --------------------------------------------------

        # Ball is very close to our goal.
        if ball_depth > 4000 and distance < 3200:
            return True

        # Ball is approaching our goal from the deeper defensive half.
        if (
            ball_depth > 3400
            and ball_toward_our_goal
            and distance < 2800
        ):
            return True

        # --------------------------------------------------
        # 1V1
        # --------------------------------------------------

        if mode == 1:

            if distance < 650 and local_ball.x > -250:
                return True

            if local_ball.x < -200 and distance > 1100:
                return False

            if distance < 1500:
                return angle < 1.65

            return angle < 1.15

        # --------------------------------------------------
        # TEAMMATE AWARENESS
        # --------------------------------------------------

        
        teammate_has_ball = False
        teammate_distance = 99999
        teammate_angle = 3.14

        if not ignore_teammate:

            if mode == 3:
                # Grid-style role election already selects one challenger.
                teammate_has_ball = False

            else:
                # Preserve the existing 2v2 teammate-awareness behaviour.
                for friend in self.friends:
                    friend_distance = friend.location.dist(ball)

                    friend_local = friend.local_location(ball)
                    friend_angle = abs(
                        Vector(x=1).angle2D(friend_local)
                    )

                    if friend_distance < teammate_distance:
                        teammate_distance = friend_distance
                        teammate_angle = friend_angle

                    if (
                        friend_distance + 500 < distance
                        and friend_angle < 0.85
                        and friend_local.x > 0
                    ):
                        teammate_has_ball = True


        # --------------------------------------------------
        # 2V2
        # --------------------------------------------------

        if mode == 2:

            # Don't double commit when teammate has a clear advantage.
            if teammate_has_ball:
                return False

            # Defensive situations deserve more urgency.
            if ball_depth > 640 and ball_toward_our_goal:
                if distance < 2000:
                    return True

            # Take immediate opportunities.
            if distance < 550 and local_ball.x > -150:
                return True

            # Don't chase balls significantly behind us.
            if local_ball.x < -250 and distance > 1000:
                return False

            # Opponent has a major advantage.
            if self.foes and not self.in_post_kickoff_contest_window():
                enemy_distance = min(
                    foe.location.dist(ball)
                    for foe in self.foes
                )

                # Avoid challenging when completely beaten.
                if enemy_distance + 350 < distance:
                    return distance < 650 and angle < 0.7

            # Normal challenge thresholds.
            if distance < 1400:
                return angle < 1.5

            return angle < 1.2

        # --------------------------------------------------
        # 3V3
        # --------------------------------------------------

                
        # --------------------------------------------------
        # 3V3
        # --------------------------------------------------

        if mode == 3:
            attacker_index, cover_index, support_index = self.get_grid_team_roles()
            active_challenger = self.get_grid_active_challenger()

            # Only the elected player challenges. Cover takes over only when
            # the ball enters the defensive area behind the moving line.
            if active_challenger is None or self.me.index != active_challenger:
                return False

            if teammate_has_ball:
                return False

            # First man: retain Grid's aggressive forward pressure.
            if ball_depth > 640 and ball_toward_our_goal and distance < 2300:
                return True

            if distance < 700 and local_ball.x > -250:
                return True

            if ball_in_enemy_half:
                if ball_near_enemy_goal and distance < 2600:
                    return angle < 2.0

                if distance < 1900:
                    return angle < 1.75

                if self.foes and not self.in_post_kickoff_contest_window():
                    enemy_distance = min(
                        foe.location.dist(ball)
                        for foe in self.foes
                    )
                    if enemy_distance + 750 < distance:
                        return False

                return angle < 1.45

            if distance < 1500:
                return angle < 1.5

            if self.foes and not self.in_post_kickoff_contest_window():
                enemy_distance = min(
                    foe.location.dist(ball)
                    for foe in self.foes
                )
                if enemy_distance + 450 < distance:
                    return distance < 650 and angle < 0.7

            if distance < 2400 and angle < 2.35:
                return True

            if distance < 3100 and angle < 1.65 and self.me.boost >= 16:
                return True

            return angle < 1.25

    def boost_on_route_to_ball(self):
        """Collect useful route boost, with wider options in our own corner."""
        if self.defensive_emergency():
            return None

        car = self.me
        ball = self.ball.location
        side = utils.side(self.team)
        ball_depth = ball.y * side

        # Don't leave the ball uncontested when an opponent is close.
        if any(foe.location.dist(ball) < 700 for foe in self.foes):
            return None

        dx = ball.x - car.location.x
        dy = ball.y - car.location.y
        length_squared = dx * dx + dy * dy

        best_boost = None
        best_score = float("inf")

        own_corner = (
            ball_depth > 640
            and abs(ball.x) > 1200
            and car.boost < 70
        )

        for boost in self.boosts:
            if not boost.active:
                continue

            pad = boost.location
            car_distance = car.location.flat_dist(pad)
            pad_to_ball = pad.flat_dist(ball)

            # Never make a corner-boost detour if an opponent is
            # already close enough to contest that pad.
            enemy_near_pad = any(
                foe.location.flat_dist(pad) < 1100
                for foe in self.foes
            )

            is_own_corner_pad = (
                boost.large
                and pad.y * side > 2500
                and abs(pad.x) > 2200
            )

            # Special case: our own corner. A wider detour is worthwhile
            # when we have time and the pad is not being contested.
            if own_corner and is_own_corner_pad and not enemy_near_pad:
                max_distance = (
                    2800 if car.boost < 35
                    else 2100 if car.boost < 55
                    else 1500
                )

                if car_distance <= max_distance and pad_to_ball < 3200:
                    score = car_distance + 0.35 * pad_to_ball

                    if score < best_score:
                        best_score = score
                        best_boost = boost

            # Normal route boost: allow a slightly wider route than before.
            if length_squared > 1:
                bx = pad.x - car.location.x
                by = pad.y - car.location.y

                progress = (bx * dx + by * dy) / length_squared

                if not 0.05 < progress < 0.92:
                    continue

                nearest_x = car.location.x + progress * dx
                nearest_y = car.location.y + progress * dy

                lateral_distance = math.hypot(
                    pad.x - nearest_x,
                    pad.y - nearest_y
                )

                if lateral_distance > 350 or car_distance > 1400:
                    continue

                score = car_distance + lateral_distance * 1.5

                if score < best_score:
                    best_score = score
                    best_boost = boost

        return best_boost


    def ball_rolling_toward_me(self):
        ball = self.ball
        car = self.me

        # The goalie must hold its net instead of reacting to the generic
        # rolling-ball clear. Keep this restriction for five seconds after
        # the role changes away from goalie so it cannot immediately peel out.
        goalie_role = False
        if self.friends:
            _, goalie_index, _ = self.get_grid_team_roles()
            goalie_role = goalie_index == self.me.index

        # Refresh this timestamp every tick while assigned goalie. Once the
        # role is lost, keep the rolling-ball clear disabled for five seconds.
        if goalie_role:
            self._last_goalie_role_time = self.time
            return False

        last_goalie_role_time = getattr(
            self, "_last_goalie_role_time", None
        )
        if (
            last_goalie_role_time is not None
            and self.time - last_goalie_role_time < 5.0
        ):
            return False

        # Ball should be near the ground.
        if ball.location.z > 120:
            return False

        # Reject if the ball is too far away (e.g. more than 2500 units).
        if car.location.flat_dist(ball.location) > 2500:
            return False

        ball_to_car = (car.location - ball.location).flatten().normalize()
        ball_velocity = ball.velocity.flatten()

        if ball_velocity.magnitude() < 250:
            return False

        return ball_velocity.normalize().dot(ball_to_car) > 0.65
        
    def defensive_emergency(self):
        side = utils.side(self.team)
        ball = self.ball.location

        ball_depth = ball.y * side
        moving_toward_goal = self.ball.velocity.y * side > 250

        # Extreme danger: a low ball is right on our doorstep,
        # even if its velocity isn't currently toward our goal.
        extreme_danger = (
            ball_depth > 4200
            and ball.z < 350
        )

        # Normal danger: a low ball is moving toward our goal.
        low_ball_threat = (
            ball_depth > 1200
            and ball.z < 350
            and moving_toward_goal
        )

        return extreme_danger or low_ball_threat

    
    
    def ball_in_goal_danger(self, distance=400):
        # Horizontal distance from the ball to our goal centre.
        side = utils.side(self.team)
        ball = self.ball.location
        return self.ball.location.flat_dist(
            self.friend_goal.location
        ) < distance and self.ball.velocity.y * side > 250
    def find_teamplay_opportunity(self):
        """Score a shot using contact time, approach angle, and shooting line."""

        shot = None
        shot_type = "NO_SHOT"

        side = utils.side(self.team)
        ball = self.ball.location

        if self.friends and not self.defensive_emergency():
            active_challenger = self.get_grid_active_challenger()
            if (
                active_challenger is not None
                and active_challenger != self.me.index
            ):
                return None, 0.0, 10.0, "NO_SHOT"

        # In the first quarter of our half, favour the earliest
        # reachable touch over a cleaner, later attacking contact.
        fast_intercept_zone = 0 < ball.y * side <= 1280

        if fast_intercept_zone:
            shot = routines.fast_intercept_finder().find(self)
            if shot is not None:
                shot_type = "ANY_SHOT_FOUND"

        # Outside that zone, retain the normal goal-directed shot planner.
        elif ball.y * side < 640:
            shot = tools.find_shot(self, self.foe_goal_shot)

            if shot is not None:
                shot_type = "SHOT_FOUND"

        # Only fall back to a general touch when a targeted shot isn't available.
        if (
            shot is None
            and not fast_intercept_zone
            and ball.y * side < self.me.location.y * side
        ):
            left_post = self.friend_goal.left_post
            right_post = self.friend_goal.right_post

            goal_width_direction = (
                right_post - left_post
            ).normalize()
            anti_target = (
                right_post + goal_width_direction * 150,
                left_post - goal_width_direction * 150
            )
            shot = tools.find_any_shot(self)

            if shot is not None:
                shot_type = "ANY_SHOT_FOUND"

        if shot is None:
            return None, 0.0, 10.0, "NO_SHOT"

        contact_time = max(
            0.0,
            min(10.0, shot.intercept_time - self.time)
        )

        distance = self.me.location.dist(ball)

        # 1. How well is the car facing the ball?
        local_ball = self.me.local_location(ball)
        facing_angle = abs(Vector(x=1).angle2D(local_ball))

        # 2. Is the car approaching from a useful side of the ball?
        # Ideally, the car approaches from behind the ball, in the
        # direction of the opponent's goal.
        approach = (ball - self.me.location).flatten()
        goal_direction = (
            self.foe_goal.location - ball
        ).flatten()

        shooting_angle_penalty = 0.0

        if approach.magnitude() > 1 and goal_direction.magnitude() > 1:
            approach = approach.normalize()
            goal_direction = goal_direction.normalize()

            alignment = max(
                -1.0,
                min(1.0, approach.dot(goal_direction))
            )

            # 0 penalty = straight toward goal.
            # Larger penalty = approaching from the side or wrong direction.
            shooting_angle_penalty = (1.0 - alignment) * 14.0

        # Goal-directed shots should beat ordinary touches when their
        # contact time and approach are reasonably competitive.
        score = 78.0 if shot_type == "SHOT_FOUND" else 64.0

        score -= min(contact_time, 4.0) * 7.0
        score -= min(facing_angle, 3.14) * 7.0
        score -= min(distance / 3000.0, 1.0) * 10.0

        # Give the quality of the shooting line a meaningful influence.
        if shot_type == "SHOT_FOUND":
            score -= shooting_angle_penalty
        else:
            # Still discourage a sideways approach for general touches,
            # but don't make it as important as a genuine shot on goal.
            score -= shooting_angle_penalty * 0.35

        if self.me.boost < 25:
            score -= 4.0

        # An actual defensive emergency takes priority.
        if self.defensive_emergency():
            score += 15.0

        score = max(0.0, min(100.0, score))
        
        # A genuine goal-directed shot takes priority over a general touch.

        # In 3v3, the designated cover player yields when
        # second man has a comparable opportunity.
        if len(self.friends) >= 2 and self.should_hold_cover_role():
            for friend in self.friends:
                comms = self.get_teammate_comm(friend.index, max_age=0.5) or {}

                friend_score = comms.get("score", 0.0)
                friend_type = comms.get("shot_type", "NO_SHOT")

                # Only yield to a teammate who has a real shot/touch.
                friend_has_opportunity = friend_type in (
                    "SHOT_FOUND",
                    "ANY_SHOT_FOUND"
                )

                if (
                    friend_has_opportunity
                    and friend_score >= score - 8.0
                ):
                    print(
                        f"[TEAMPLAY] Cover player yielding to "
                        f"teammate {friend.index}: "
                        f"my_score={score:.1f}, "
                        f"teammate_score={friend_score:.1f}",
                        flush=True
                    )

                    return None, 0.0, 10.0, "NO_SHOT"

        # Useful for checking why one teammate wins the comparison.
        print(
            f"[TEAMPLAY] {self.me.index if hasattr(self.me, 'index') else 'ME'} "
            f"type={shot_type} score={score:.1f} "
            f"time={contact_time:.2f} dist={distance:.0f} "
            f"face={facing_angle:.2f} "
            f"shoot_penalty={shooting_angle_penalty:.1f}",
            flush=True
        )

        return shot, score, contact_time, shot_type

    def opponent_is_vulnerable(self):
        """Challenge when a nearby opponent is facing away from our goal."""

        ball = self.ball.location
        car = self.me

        if car.location.dist(ball) > 1800:
            return False

        for foe in self.foes:
            if foe.location.dist(ball) > 900:
                continue

            # Direction from opponent toward our goal.
            toward_our_goal = (
                self.friend_goal.location - foe.location
            ).flatten().normalize()

            foe_forward = foe.forward.flatten().normalize()

            # Positive: facing our goal.
            # Negative: facing away from our goal, toward their own end.
            goal_alignment = foe_forward.dot(toward_our_goal)

            # Ball is behind the opponent, so they must turn around.
            foe_local_ball = foe.local_location(ball)
            ball_behind_foe = foe_local_ball.x < -150

            # Strong vulnerability: opponent is facing away from our goal.
            facing_own_goal = goal_alignment < -0.25

            if facing_own_goal or ball_behind_foe:
                return True

        return False

    
    def opponent_can_reach_ball_first(self):
        """Avoid a losing challenge when an opponent can reach our-side ball first."""
        if self.in_post_kickoff_contest_window():
            return False
        ball = self.ball.location
        me = self.me.location
        side = utils.side(self.team)

        # Ball is not on our side: use normal attacking logic.
        ball_depth = ball.y * side
        if ball_depth < 0:
            return False

        # Never suppress an emergency doorstep save.
        if ball_depth > 4200 and ball.z < 350:
            return False

        def distance(a, b):
            dx = a.x - b.x
            dy = a.y - b.y
            dz = a.z - b.z
            return math.sqrt(dx * dx + dy * dy + dz * dz)

        def flat_speed(car):
            v = car.velocity
            return math.sqrt(v.x * v.x + v.y * v.y)

        my_distance = distance(me, ball)
        my_eta = my_distance / max(900, flat_speed(self.me) + 500)

        for foe in self.foes:
            foe_distance = distance(foe.location, ball)
            foe_eta = foe_distance / max(900, flat_speed(foe) + 500)

            # Require a meaningful opponent advantage to avoid excessive passivity.
            if foe_eta + 0.20 < my_eta:
                return True

        return False
    def _car_ball_facing_angle(self, car):
        """3D angle between a teammate's nose and the ball."""
        to_ball = self.ball.location - car.location
        forward = car.forward
        if to_ball.magnitude() < 1 or forward.magnitude() < 0.001:
            return math.pi
        dot = forward.normalize().dot(to_ball.normalize())
        return math.acos(max(-1.0, min(1.0, dot)))

    def get_grid_team_roles(self):
        """
        Noob Black's rotating 3s role selection.

        The best challenger is selected from all living teammates using
        ball-side dependency and a penalty for cars facing/positioned badly.
        The goalie is independently the deepest player, measured by distance
        to our goal with lateral distance capped at 900 units. If that goalie
        has the best horizontal facing angle to the ball, it takes the challenge.
        """
        cached_time = getattr(self, "_noob_black_roles_time", None)
        if cached_time == self.time:
            return self._noob_black_roles_cache

        cars = [
            car for car in [self.me] + list(self.friends)
            if not getattr(car, "demolished", False)
        ]
        cars.sort(key=lambda car: car.index)

        if not cars:
            result = (None, None, None)
            self._noob_black_roles_time = self.time
            self._noob_black_roles_cache = result
            return result
        if len(cars) == 1:
            result = (cars[0].index, None, None)
            self._noob_black_roles_time = self.time
            self._noob_black_roles_cache = result
            return result

        ball = self.ball.location
        ball_velocity = self.ball.velocity
        side = utils.side(self.team)
        own_goal = self.friend_goal.location
        prediction = self.ball_prediction_struct
        slices = (
            getattr(prediction, "slices", None)
            if prediction is not None else None
        ) or ()

        # Noob Black limits its urgent-save window to five seconds and treats
        # a predicted crossing of the goal plane as a save deadline.
        save_deadline = -1.0
        for ball_slice in slices:
            time_to_goal = ball_slice.game_seconds - self.time
            if time_to_goal <= 0:
                continue
            if time_to_goal > 5.0:
                break
            if abs(ball_slice.physics.location.y) >= 5235:
                save_deadline = time_to_goal
                break

        sidewall_clear = (
            abs(ball.y - own_goal.y) <= 1000
            and abs(ball.x) >= 900
            and save_deadline < 0
        )

        foe_goal = self.foe_goal.location

        # Port Noob Black's next_bounce / air_pos prediction. It considers
        # floor, side-wall, back-wall and ceiling contact before assigning
        # a player to a rebound lane.
        def next_bounce(position, velocity, height):
            def bounce_root(target, root_sign):
                a = -325.0
                b = velocity.z
                c = position.z
                discriminant = (
                    (target - c) / a
                    + b * b / (4 * a * a)
                )
                if discriminant < 0:
                    return None
                return (
                    -b / (2 * a)
                    + math.sqrt(discriminant) * root_sign
                )

            if abs(velocity.x) > 0.001:
                sx = 1 if velocity.x > 0 else -1
                wall_x_time = (
                    (4096 - height - position.x * sx)
                    * sx / velocity.x
                )
            else:
                wall_x_time = float("inf")

            if abs(velocity.y) > 0.001:
                sy = 1 if velocity.y > 0 else -1
                wall_y_time = (
                    (5120 - height - position.y * sy)
                    * sy / velocity.y
                )
            else:
                wall_y_time = float("inf")

            floor_time = bounce_root(height, 1)
            ceiling_time = bounce_root(2044 - height, -1)
            if floor_time is None:
                floor_time = 0.0
            if ceiling_time is None:
                ceiling_time = float("inf")

            return min(
                floor_time,
                wall_x_time,
                wall_y_time,
                ceiling_time
            )

        def air_pos(position, velocity, time_value):
            return (
                position
                + velocity * time_value
                + Vector(0, 0, -325) * time_value ** 2
            )

        normal_bounce_time = next_bounce(
            ball, ball_velocity, 92.75
        )
        reverse_bounce_time = next_bounce(
            ball, -ball_velocity, 92.75
        )
        normal_bounce = air_pos(
            ball, ball_velocity, normal_bounce_time
        )
        reverse_bounce = air_pos(
            ball, -ball_velocity, reverse_bounce_time
        )

        backwall_point = None
        if not sidewall_clear and save_deadline < 0:
            normal_hits_backwall = (
                abs(normal_bounce.y - own_goal.y) <= 100
                and normal_bounce.z > 0
            )
            reverse_hits_backwall = (
                abs(reverse_bounce.y - own_goal.y) <= 100
                and reverse_bounce.z > 0
            )
            if normal_hits_backwall or reverse_hits_backwall:
                backwall_point = (
                    normal_bounce
                    if abs(normal_bounce.y - foe_goal.y)
                    < abs(reverse_bounce.y - foe_goal.y)
                    else reverse_bounce
                )

        ball_dependency = abs(ball.y - foe_goal.y)
        if backwall_point is not None:
            ball_dependency = abs(backwall_point.y - foe_goal.y)
        else:
            # Noob Black also adjusts dependency for a low double-jump-height
            # bounce that is moving away from our goal and has no wall hit.
            double_jump_height_time = (
                -(564.9931640625 + 292)
                / (-325.0556640625 * 2)
            )
            double_jump_height = (
                -325.0556640625 * double_jump_height_time ** 2
                + (564.9931640625 + 292) * double_jump_height_time
                - 11.6591796875
                - 292 * 25 / 120
            )
            bounce_time = next_bounce(
                ball, ball_velocity, double_jump_height
            )
            vertical_bounce_time = next_bounce(
                ball,
                Vector(0, 0, ball_velocity.z),
                double_jump_height
            )
            if abs(bounce_time - vertical_bounce_time) < 1e-6:
                low_bounce = air_pos(
                    ball, ball_velocity, bounce_time
                )
                if (
                    low_bounce.y * foe_goal.y
                    > ball.y * foe_goal.y
                    and low_bounce.z < 600
                ):
                    ball_dependency = abs(
                        low_bounce.y - foe_goal.y
                    )

        best_challenger = None
        best_challenger_score = float("inf")
        best_dependency = False
        deepest_player = None
        deepest_score = float("inf")

        ball_flat_velocity = ball_velocity.flatten()
        ball_flat_speed = ball_flat_velocity.magnitude()
        ball_side = 1 if ball.x >= 0 else -1

        for car in cars:
            location = car.location
            velocity = car.velocity
            forward = car.forward

            furthest_score = (
                min(location.dist(own_goal), 900.0)
                + abs(location.y - own_goal.y)
            )
            if furthest_score < deepest_score:
                deepest_score = furthest_score
                deepest_player = car

            post_x = 900 if location.x >= 0 else -900
            own_goal_post = Vector(
                x=post_x, y=side * 5050, z=0
            )
            facing_badly = forward.y * side > 0
            falling_without_jump = (
                location.z <= 200
                and getattr(car, "doublejumped", False)
                and velocity.z < 10
                and velocity.y * side > 0
            )
            on_goal_post = (
                location.flatten().dist(own_goal_post) <= 100
            )
            facing_own_goal_from_line = (
                location.y * side >= 5050
                and abs(location.x) <= 900
                and forward.y * side > 0
            )
            closest_score = (
                location.dist(ball)
                + 5000.0 * (
                    facing_badly
                    or falling_without_jump
                    or on_goal_post
                    or facing_own_goal_from_line
                )
            )

            if sidewall_clear:
                dependency = (
                    ball.x * ball_side >= location.x * ball_side
                )
            elif backwall_point is not None:
                dependency = (
                    abs(location.y - foe_goal.y)
                    + abs(location.x - backwall_point.x) / 5
                    > abs(backwall_point.y - foe_goal.y)
                )
            else:
                lane_distance = (
                    location.flatten() - ball.flatten()
                )
                cross_track = abs(
                    lane_distance.x * ball_flat_velocity.y
                    - lane_distance.y * ball_flat_velocity.x
                )
                along_track = abs(
                    lane_distance.x * ball_flat_velocity.x
                    + lane_distance.y * ball_flat_velocity.y
                )
                path_relevant = (
                    save_deadline < 0
                    or (
                        cross_track / 2300.0 - 134.85
                        < along_track / max(ball_flat_speed, 1.0)
                    )
                )
                dependency = (
                    abs(location.y - foe_goal.y)
                    + abs(location.x - ball.x) / 5
                    * (save_deadline >= 0)
                    > ball_dependency
                    and path_relevant
                )

            if (
                (closest_score <= best_challenger_score
                 and bool(dependency) >= best_dependency)
                or bool(dependency) > best_dependency
            ):
                best_challenger = car
                best_challenger_score = closest_score
                best_dependency = bool(dependency)

        attacker = best_challenger
        goalie = deepest_player

        # A goalie normally holds the net, but if its nose is already
        # pointing at the ball better than either teammate, let it challenge.
        # This is a narrow role-selection exception, not a global teamplay
        # priority override.
        # The 3D-facing-angle exception is strictly defensive:
        # it is available only while the ball remains in our half.
        ball_depth = ball.y * side

        if (
            goalie.index != attacker.index
            and ball_depth > 0.0
        ):
            goalie_angle = self._car_ball_facing_angle(goalie)
            best_other_angle = min(
                self._car_ball_facing_angle(car)
                for car in cars
                if car.index != goalie.index
            )
            if goalie_angle + 0.001 < best_other_angle:
                attacker = goalie
                if self.time - getattr(
                    self, "_last_goalie_angle_debug", -999.0
                ) >= 0.5:
                    self._last_goalie_angle_debug = self.time
                    print(
                        f"[GOALIE ANGLE CHALLENGE] "
                        f"goalie={goalie.index} "
                        f"angle={math.degrees(goalie_angle):.1f}deg "
                        f"other_best={math.degrees(best_other_angle):.1f}deg "
                        f"ball_depth={ball_depth:.0f}",
                        flush=True
                    )

        # If the deepest player is also the challenger, promote the
        # next-deepest teammate into the goalie/fallback role. A challenge
        # announcement must always have a different player responsible behind it.
        if goalie.index == attacker.index:
            fallback_candidates = [
                car for car in cars if car.index != attacker.index
            ]
            if fallback_candidates:
                goalie = min(
                    fallback_candidates,
                    key=lambda car: (
                        min(car.location.dist(own_goal), 900.0)
                        + abs(car.location.y - own_goal.y)
                    )
                )

        transition = next(
            (
                car for car in cars
                if car.index != attacker.index
                and car.index != goalie.index
            ),
            None
        )
        result = (
            attacker.index,
            goalie.index,
            transition.index if transition is not None else None
        )
        self._noob_black_roles_time = self.time
        self._noob_black_roles_cache = result
        return result

    def get_grid_active_challenger(self):
        """Noob Black's selected challenger always owns the first challenge."""
        attacker, _, _ = self.get_grid_team_roles()
        return attacker

    def get_transition_bump_target(self, attacker_index):
        """
        Find an opponent screening the transition player's attacking teammate.

        A defender only qualifies when they are physically in the corridor
        from the teammate to the opponent goal, not merely near the ball.
        """
        teammate = next(
            (
                friend for friend in self.friends
                if friend.index == attacker_index
                and not getattr(friend, "demolished", False)
            ),
            None
        )
        if teammate is None:
            return None

        ball = self.ball.location
        if teammate.location.flat_dist(ball) > 1700:
            return None

        goal_direction = (
            self.foe_goal.location - teammate.location
        ).flatten()
        if goal_direction.magnitude() < 1:
            return None
        goal_direction = goal_direction.normalize()

        defenders = []

        for foe in self.foes:
            if getattr(foe, "demolished", False):
                continue

            teammate_to_foe = (
                foe.location - teammate.location
            ).flatten()
            progress = teammate_to_foe.dot(goal_direction)

            # Count only opponents actually screening the teammate's
            # forward lane, rather than anyone who happens to be nearby.
            if not 150 <= progress <= 3500:
                continue

            lateral_offset = (
                teammate_to_foe - goal_direction * progress
            ).magnitude()
            if lateral_offset > 650:
                continue

            if foe.location.flat_dist(ball) > 2600:
                continue

            # Keep the bump target within a sensible ground-chase distance.
            if self.me.location.flat_dist(foe.location) > 4200:
                continue

            defenders.append(foe)

        # Only use this play when there are no more than two defenders
        # screening the attack. If there are three or more, retain the
        # transition shape instead of committing to a crowded defensive line.
        if not defenders or len(defenders) > 2:
            return None

        # When one or two defenders qualify, pressure the one closest to ball.
        return min(
            defenders,
            key=lambda foe: foe.location.flat_dist(ball)
        )

    def get_cover_role_owner(self):
        """Return the Noob Black-style goalie when distinct from the challenger."""
        if not self.friends:
            self.cover_role_owner = None
            return None

        attacker, goalie, _ = self.get_grid_team_roles()
        owner = goalie if goalie != attacker else None
        self.cover_role_owner = owner
        return owner

    def should_hold_cover_role(self):
        if not self.friends:
            return False

        attacker, goalie, _ = self.get_grid_team_roles()
        # Challenger priority wins if the same car is also furthest back.
        return goalie == self.me.index and attacker != self.me.index

    def should_commit_to_shot(self, my_score, my_contact_time):
        """Yield only when a teammate has a meaningfully better opportunity."""
        if not self.friends:
            return True

        # Don't let normal teamplay logic override an urgent own-goal threat.
        if self.defensive_emergency():
            return True

        side = utils.side(self.team)
        ball_is_our_side = self.ball.location.y * side > 640
        
        for friend in self.friends:
            message = self.get_teammate_comm(friend.index, max_age=0.5)

            if message is None:
                continue

            status = message["status"]
            teammate_score = message["score"]
            teammate_time = message["contact_time"]

            # A teammate handling a defensive emergency should be allowed
            # to take responsibility when the ball is in our half.
            if status == "DEFEND" and ball_is_our_side:
                # A goalie reporting DEFEND is holding the net, not taking
                # the challenge. Only yield to the elected challenger.
                attacker, goalie, transition = self.get_grid_team_roles()
                if friend.index == attacker:
                    return False

            if status not in {"SHOT_FOUND", "ANY_SHOT_FOUND"}:
                continue

            # A teammate already executing a shot owns the challenge.
            # Yield regardless of our own candidate score.
            if message.get("cover_released", False):
                return False
            
            # If our teammate is rotating forward from behind us and has
            # found a shot, give them priority unless our shot is clearly better.
            friend_depth = friend.location.y * side
            my_depth = self.me.location.y * side

            teammate_rotating_from_behind = (
                friend_depth > my_depth + 250
                and self.ball.location.y * side < 640
            )

            if teammate_rotating_from_behind:
                my_shot_is_clearly_better = (
                    my_score >= teammate_score + 12.0
                    and my_contact_time <= teammate_time + 0.35
                )

                if not my_shot_is_clearly_better:
                    return False

                # Our opportunity is clearly better, so keep attacking.
                continue

            # A clearly better score plus a reasonably similar arrival time.
            teammate_has_better_shot = (
                teammate_score >= my_score + 8.0
                and teammate_time <= my_contact_time + 0.80
            )

            # If the teammate can arrive substantially earlier and has
            # a comparable opportunity, let them take the first challenge.
            teammate_arrives_first = (
                teammate_time + 0.45 < my_contact_time
                and teammate_score >= my_score - 8.0
            )

            if teammate_has_better_shot or teammate_arrives_first:
                return False

        return True

    def update_teamplay(self):

        """Refresh shot information and announce when we leave cover to commit."""

        # Check for an urgent defensive situation first.
        if self.defensive_emergency():
            self.teamplay_shot = None
            self.teamplay_score = 100.0
            self.teamplay_contact_time = 0.0
            self.teamplay_status = "DEFEND"

            # The elected challenger is the one making the first defensive
            # contact. Publish an estimated contact time so the goalie can
            # schedule a second interception just after that attempt.
            if self.friends:
                attacker, goalie, transition = self.get_grid_team_roles()
                if self.me.index == attacker:
                    distance = self.me.location.dist(self.ball.location)
                    speed = self.me.velocity.magnitude()
                    self.teamplay_contact_time = max(
                        0.12,
                        min(2.0, distance / max(900.0, speed + 1000.0))
                    )

            # If we are executing a shot and an opponent is likely to reach
            # its predicted contact first, tell the goalie to prepare a later
            # interception. Otherwise keep the normal DEFEND signal.
            race_info = self._active_shot_race_info()
            self.cover_role_released = True
            if race_info is not None and self.friends:
                self.teamplay_contact_time = race_info[0]
                self.send_teamplay_comm(
                    "SHOT_CONTESTED", 0.0, self.teamplay_contact_time
                )
                if self.time - getattr(self, "_last_contested_debug", -999.0) >= 0.75:
                    self._last_contested_debug = self.time
                    print(
                        f"[SHOT CONTESTED] player={self.me.index} "
                        f"foe={race_info[2]} foe_eta={race_info[1]:.2f} "
                        f"our_contact={race_info[0]:.2f}",
                        flush=True
                    )
            else:
                self.send_teamplay_comm(
                    "DEFEND", 100.0, self.teamplay_contact_time
                )
            return

        # These names must match the actual routine class names.
        shot_names = {
            "ground_shot",
            "jump_shot",
            "double_jump",
            "Aerial",
            "Redirect",
            "wall_approach",
            "short_shot"
        }

        # A candidate alone does NOT count as a commitment.
        active_shot = any(
            routine.__class__.__name__ in shot_names
            for routine in self.stack
        )

        # Release cover only once an actual shot routine is active.
        self.cover_role_released = active_shot

        # Recalculate on the same cadence as your existing shot selection.
        if self.is_clear() or self.odd_tick == 0:
            (
                self.teamplay_shot,
                self.teamplay_score,
                self.teamplay_contact_time,
                self.teamplay_status,
            ) = self.find_teamplay_opportunity()

        status = self.teamplay_status
        score = self.teamplay_score
        contact_time = self.teamplay_contact_time

        race_info = self._active_shot_race_info()
        if race_info is not None and self.friends:
            status = "SHOT_CONTESTED"
            score = 0.0
            contact_time = race_info[0]
            if self.time - getattr(self, "_last_contested_debug", -999.0) >= 0.75:
                self._last_contested_debug = self.time
                print(
                    f"[SHOT CONTESTED] player={self.me.index} "
                    f"foe={race_info[2]} foe_eta={race_info[1]:.2f} "
                    f"our_contact={race_info[0]:.2f}",
                    flush=True
                )
        elif status == "NO_SHOT" and self.me.boost < 18:
            status = "LOW_BOOST"

        self.send_teamplay_comm(
            status,
            score,
            contact_time
        )


    
    def run_logic(self):
        # NOTE This method is ran every tick


        # If the kickoff isn't done
        
       
       
        # Start the ten-second post-kickoff contest window as soon as the
        # ball leaves its kickoff position, regardless of our kickoff role.
        if (
            self.kickoff_ball_start is not None
            and self.kickoff_contest_until < -900.0
            and self._kickoff_resolved()
        ):
            self.kickoff_contest_until = self.time + 10.0
            print(
                f"[KICKOFF] unrestricted contest window until "
                f"{self.kickoff_contest_until:.2f}",
                flush=True
            )

        # Kickoff logic: assign the role once and don't restart
        # the kickoff routine if its stack temporarily becomes empty.
        if not self.kickoff_done:
            if self.kickoff_routine_started:
                if self.kickoff_boost_pending and self._kickoff_resolved():
                    self.kickoff_done = True
                    self.kickoff_boost_pending = False
                    print("[KICKOFF] Ball moved; boost player released", flush=True)
                else:
                    return
            else:
                kicker, cheater, boost_player = self._kickoff_assignments()
                if self.me.index == kicker:
                    if self.is_clear():
                        self.kickoff_routine_started = True
